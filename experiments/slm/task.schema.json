{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "family", "split", "sir_version", "base_source", "reference_source", "requirement", "contract", "oracle", "reference_evidence"],
  "properties": {
    "schema_version": {"const": "sir-task/1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "revision": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "family": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
    "split": {"enum": ["train", "development", "test", "public_regression"]},
    "exposure": {"type": "string", "minLength": 1},
    "sir_version": {"const": "0.3"},
    "base_source": {"type": ["string", "null"], "minLength": 1},
    "ddl_source": {"type": "string", "minLength": 1},
    "reference_source": {"type": "string", "minLength": 1},
    "requirement": {"type": "string", "minLength": 30},
    "contract": {"type": "object", "minProperties": 1},
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "files"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "reference_evidence": {"type": "object", "required": ["kind", "commit", "run_url"], "properties": {
      "kind": {"const": "existing-reference-only-not-candidate-qualification"},
      "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "run_url": {"type": "string", "pattern": "^https://github.com/.+/actions/runs/[0-9]+$"}
    }}
  }
}
