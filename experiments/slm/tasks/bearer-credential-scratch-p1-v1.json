  "reference_source": "sir-toolchain-application/src/test/resources/valid/bearer-credential.sir",
  "requirement": "Register 传 name、password，创建并保存账号。成功返回账号 id、name，不要返回口令。\n\nGetUser 按 id 查，返回 id、name。找不到就返回 404 UserNotFound。\n\nPostNote 传非空白 text，成功创建笔记并返回 id、text。\n\nLogin 传 name、password。口令对了就返回 201，带上 id、expiresAt。\n\nid 要是 UUID。令牌要关联这个账号并保存，15 分钟后到期。口令错了返回 401 BadLogin。\n\nPostNote 从 Authorization 的 Bearer 令牌认作者，方案名大小写都行。\n\n令牌有效就把笔记存到它所属的用户。匿名、错误方案、缺令牌、非 UUID、未知或已失效令牌，都返回 401，不写笔记。\n\nLogout 传 token，返回 200，让这个令牌马上失效。其他用户的令牌不受影响。\n\nLogout 遇到不存在的令牌，返回 401 BadToken。\n\n返回完整的 sir 0.3 文档，不要 Java、SQL 或解释。",
  "contract": {
    "namespace": "example.notes",
    "capabilities": [
      "GetUser",
      "Register",
      "Login",
      "Logout",
      "PostNote"
    ],
    "entities": [
      "User",
      "AccessToken",
      "Note"
    ],
    "register_request": [
      "name",
      "password"
    ],
    "user_response": [
      "id",
      "name"
    ],
    "login_request": [
      "name",
      "password"
    ],
    "token_response": [
      "id",
      "expiresAt"
    ],
    "logout_request": [
      "token"
    ],
    "post_note_request": [
      "text"
    ],
    "note_response": [
      "id",
      "text"
    ],
    "readiness": "GET /api/get-user?id=1",
    "access_minutes": 15,
    "interfaces": {
      "GetUser": {
        "route": "GET /api/get-user",
        "request_fields": [
          "id"
        ],
        "response_fields": [
          "id",
          "name"
        ]
      },
      "Register": {
        "route": "POST /api/register",
        "request_fields": [
          "name",
          "password"
        ],
        "response_fields": [
          "id",
          "name"
        ]
      },
      "Login": {
        "route": "POST /api/login",
        "request_fields": [
          "name",
          "password"
        ],
        "response_fields": [
          "id",
          "expiresAt"
        ]
      },
      "Logout": {
        "route": "POST /api/logout",
        "request_fields": [
          "token"
        ],
        "response_fields": [
          "id",
          "expiresAt"
        ]
      },
      "PostNote": {
        "route": "POST /api/post-note",
        "request_fields": [
          "text"
        ],
        "response_fields": [
          "id",
          "text"
        ]
      }
    },
    "enums": {},
    "declared_errors": {
      "BadLogin": 401,
      "BadToken": 401,
      "UserNotFound": 404
    }
  },
