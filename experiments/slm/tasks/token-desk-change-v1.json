{
  "schema_version": "sir-task/1",
  "id": "auth-token-desk-change-v1",
  "revision": "1",
  "family": "auth.token-desk",
  "split": "train",
  "sir_version": "0.3",
  "base_source": "experiments/slm/drafts/token-desk/base.sir",
  "ddl_source": "sir-toolchain-application/src/test/resources/conformance/mysql/token-desk-ddl.sql",
  "reference_source": "sir-toolchain-application/src/test/resources/valid/token-desk.sir",
  "requirement": "在给定软件上增加账号注册与口令登录，保留 GetCredential、Refresh、Touch、FindAccount 的现有行为。Register 接收 name、password，创建并保存账号，成功返回 id、name，不包含口令或摘要；数据库口令必须为带独立盐的 pbkdf2-sha256$ 格式摘要，不能存明文。Login 接收 name、password，正确口令返回 200 和账号 id、name；错误口令和不存在账号都返回完全相同的 401 BadLogin；数据库中不是摘要格式的旧文本，即使与输入相同也不得登录。返回完整的 sir 0.3 文档，不要 Java、SQL 或解释。",
  "contract": {
    "namespace": "com.example.tokendesk",
    "capabilities": [
      "GetCredential",
      "Refresh",
      "Touch",
      "Register",
      "Login",
      "FindAccount"
    ],
    "entities": [
      "Credential",
      "Account"
    ],
    "credential_get_request": [
      "id"
    ],
    "credential_write_request": [
      "token"
    ],
    "credential_response": [
      "id",
      "owner",
      "expiresAt"
    ],
    "find_account_request": [
      "name"
    ],
    "account_credentials": [
      "name",
      "password"
    ],
    "account_response": [
      "id",
      "name"
    ],
    "readiness": "GET /api/get-credential?id=11111111-1111-4111-8111-111111111111",
    "refresh_days": 7,
    "interfaces": {
      "GetCredential": {
        "route": "GET /api/get-credential",
        "request_fields": [
          "id"
        ],
        "response_fields": [
          "id",
          "owner",
          "expiresAt"
        ]
      },
      "Refresh": {
        "route": "POST /api/refresh",
        "request_fields": [
          "token"
        ],
        "response_fields": [
          "id",
          "owner",
          "expiresAt"
        ]
      },
      "Touch": {
        "route": "POST /api/touch",
        "request_fields": [
          "token"
        ],
        "response_fields": [
          "id",
          "owner",
          "expiresAt"
        ]
      },
      "Register": {
        "route": "POST /api/register",
        "request_fields": [
          "name",
          "password"
        ],
        "response_fields": [
          "id",
          "name"
        ]
      },
      "Login": {
        "route": "POST /api/login",
        "request_fields": [
          "name",
          "password"
        ],
        "response_fields": [
          "id",
          "name"
        ]
      },
      "FindAccount": {
        "route": "GET /api/find-account",
        "request_fields": [
          "name"
        ],
        "response_fields": [
          "id",
          "name"
        ]
      }
    },
    "enums": {},
    "declared_errors": {
      "Expired": 400,
      "Invalid": 409,
      "AccountNotFound": 404,
      "CredentialNotFound": 404,
      "BadLogin": 401
    }
  },
