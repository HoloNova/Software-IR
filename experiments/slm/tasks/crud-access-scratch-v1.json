        ],
        "response_fields": [
          "id",
          "author",
          "body",
          "state",
          "version"
        ]
      },
      "GetPost": {
        "route": "GET /api/public/posts/{id}",
        "request_fields": [
          "id"
        ],
        "response_fields": [
          "id",
          "author",
          "body",
          "state",
          "version"
        ]
      },
