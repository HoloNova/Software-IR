sir 0.3

software EventSignup {
  metadata {
    displayName "Event Signup";
    namespace "example.events";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    type Fee = Money where precision(10, 2), min(0);
    entity User persistent {
      identity id: Id generated auto;
      field name: Name unique;
    }
    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }
    entity Event persistent {
      identity id: Id generated auto;
      field organizer: Ref<User>;
      field title: Name;
      field startsAt: Moment;
      field capacity: Quantity;
      field registered: Count default 0;
      field fee: Fee;
    }
    entity Registration persistent {
      identity id: Id generated auto;
      field event: Ref<Event>;
      field attendee: Ref<User>;
      field fee: Fee;
      field registeredAt: Moment default now();
      unique (event, attendee);
    }
    view EventView from Event {
      field id: Id;
      field organizer: Ref<User>;
      field title: Name;
      field startsAt: Moment;
      field capacity: Quantity;
      field registered: Count;
      field remaining: Count = item.capacity - item.registered;
      field fee: Fee;
    }
    view RegistrationView from Registration {
      field id: Id;
      field event: Ref<Event>;
      field attendee: Ref<User>;
      field fee: Fee;
      field registeredAt: Moment;
    }
    input NewEvent {
      field title: Name;
      field startsAt: Moment;
      field capacity: Quantity;
      field fee: Fee;
    }
    input EventRef { field id: Id; }
    input PageQuery { field page: PageNo; field size: PageSize; }
    error BadPage http 400;
    error Forbidden http 403;
    error EventNotFound http 404;
    error AlreadyRegistered http 409;
    error EventFull http 409;
    error RegistrationClosed http 409;

    capability CreateEvent {
      actor Ref<User>;
      input NewEvent;
      output EventView;
      requires authenticated;
      requires atomic;
      expose command at "/events";
      workflow {
        create Event as made {
          organizer: actor;
          title: input.title;
          startsAt: input.startsAt;
          capacity: input.capacity;
          fee: input.fee;
        }
        persist made;
        return made;
      }
    }
    capability ListEvents {
      input PageQuery;
      output Page<EventView>;
      fails BadPage;
      requires readonly;
      expose query at "/events";
      workflow {
        find Event where item.startsAt > now()
          order by startsAt ascending, id ascending
          Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    capability MyRegistrations {
      actor Ref<User>;
      input PageQuery;
      output Page<RegistrationView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/my/registrations";
      workflow {
        find Registration where item.attendee == actor
          order by registeredAt descending, id descending
          Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
  }
}
