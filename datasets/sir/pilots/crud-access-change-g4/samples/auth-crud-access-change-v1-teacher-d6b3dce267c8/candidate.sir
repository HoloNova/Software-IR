sir 0.3
software CrudAccess {
  metadata { displayName "Crud Access"; namespace "example.crudaccess"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    enum Role { READER, ADMIN }
    entity User persistent {
      identity id: Id generated auto;
      field role: Role default Role.READER;
    }
    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }
    entity Post persistent {
      identity id: Id generated auto;
      field author: Ref<User>;
      field body: Text;
      field state: Text default "open";
      field version: Version;
      scope state != "hidden";
    }
    entity Book persistent {
      identity id: Id generated auto;
      field title: Text where length(1, 64);
      field stock: Count default 5;
    }
    use Crud {
      entity: Post;
      owner: author;
      writer: User;
      writeRole: ADMIN;
      read: public;
      writeExclude: [state];
      path: "public/posts";
    }
    view BookView from Book {
      field id: Id;
      field title: Text;
      field stock: Count;
    }
    input CreateBookInput {
      field title: Text where notBlank;
    }
    input UpdateBookInput {
      field id: Id;
      field title: Text where notBlank;
    }
    input GetBookInput {
      field id: Id;
    }
    input ListBookInput {
      field page: PageNo;
      field size: PageSize;
    }
    input DeleteBookInput {
      field id: Id;
    }
    error BookNotFound http 404;
    error Forbidden http 403;
    error InvalidBookInput http 400;
    capability CreateBook {
      actor Ref<User>;
      input CreateBookInput;
      output BookView;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command at "/library/books";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        create Book as book { title: input.title; stock: 5; }
        persist book;
        return book;
      }
    }
    capability GetBook {
      input GetBookInput;
      output BookView;
      fails BookNotFound;
      requires readonly;
      expose query at "/library/books/{id}";
      workflow {
        load Book by input.id as book else BookNotFound;
        return book;
      }
    }
    capability ListBook {
      input ListBookInput;
      output Page<BookView>;
      fails InvalidBookInput;
      requires readonly;
      expose query at "/library/books";
      workflow {
        find Book where true order by id ascending Page input.page, input.size else InvalidBookInput as books;
        return books;
      }
    }
    capability UpdateBook {
      actor Ref<User>;
      input UpdateBookInput;
      output BookView;
      fails BookNotFound;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command put at "/library/books/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Book by input.id as book else BookNotFound;
        update book { title: input.title; }
        persist book;
        return book;
      }
    }
    capability DeleteBook {
      actor Ref<User>;
      input DeleteBookInput;
      output Unit;
      fails BookNotFound;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command delete at "/library/books/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Book by input.id as book else BookNotFound;
        delete book;
        return unit;
      }
    }
  }
}
