sir 0.3
software CourseEnrollment {
  metadata {
    displayName "Course Enrollment";
    namespace "com.example.courseenrollment";
  }

  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }

  sources { }
  imports { }
  declarations {
    enum EnrollmentStatus {
      ACTIVE,
      CANCELLED
    }

    entity Student persistent {
      identity id: Id generated auto;
      field studentNo: Code where length(1, 16);
      field name: Name;
    }

    entity Course persistent {
      identity id: Id generated auto;
      field code: Code;
      field name: Name;
      field capacity: Quantity;
    }

    entity Enrollment persistent {
      identity id: Id generated auto;
      field course: Ref<Course>;
      field student: Ref<Student>;
      field status: EnrollmentStatus;
    }

    view StudentSummary from Student {
      field id: Id;
      field studentNo: Text;
      field name: Text;
      field label: Text = item.name;
    }

    view EnrollmentSummary from Enrollment {
      field id: Id;
      field student: StudentSummary;
      field status: EnrollmentStatus;
      field active: Flag = item.status == EnrollmentStatus.ACTIVE;
    }

    view CourseEnrollmentItem from Course {
      field id: Id;
      field code: Text;
      field name: Text;
      field capacity: Count;
      field doubledCapacity: Count = item.capacity * 2;
      field enrollments: List<EnrollmentSummary>;
    }

    input SearchCourseEnrollmentsInput {
      field page: PageNo;
      field size: PageSize;
    }

    error InvalidPage;

    capability SearchCourseEnrollments {
      input SearchCourseEnrollmentsInput;
      output Page<CourseEnrollmentItem>;
      fails InvalidPage;
      requires readonly;
      expose query at "/search-course-enrollments";
      workflow {
        find Course where any(Enrollment, course == item and status == EnrollmentStatus.ACTIVE) order by code ascending, id ascending Page input.page, input.size else InvalidPage as courses;
        return courses;
      }
    }
  }
}
