sir 0.3

software StoreRoster {
  metadata {
    displayName "Store Shift Roster";
    namespace "example.staffing";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    enum ShiftBand { OPENING, CLOSING }
    entity User persistent {
      identity id: Id generated auto;
      field name: Name unique;
    }
    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }
    entity Store persistent {
      identity id: Id generated auto;
      field name: Name;
      field manager: Ref<User>;
    }
    entity Employee persistent {
      identity id: Id generated auto;
      field store: Ref<Store>;
      field name: Name;
    }
    entity Shift persistent {
      identity id: Id generated auto;
      field store: Ref<Store>;
      field day: Day;
      field band: ShiftBand;
      unique (store, day, band);
    }
    entity Assignment persistent {
      identity id: Id generated auto;
      field employee: Ref<Employee>;
      field shift: Ref<Shift>;
      unique (employee, shift);
    }
    view StoreView from Store { field id: Id; field name: Name; }
    view EmployeeView from Employee {
      field id: Id;
      field store: Ref<Store>;
      field name: Name;
    }
    view ShiftView from Shift {
      field id: Id;
      field store: Ref<Store>;
      field day: Day;
      field band: ShiftBand;
    }
    view AssignmentView from Assignment {
      field id: Id;
      field employee: Ref<Employee>;
      field shift: Ref<Shift>;
    }
    input PageQuery { field page: PageNo; field size: PageSize; }
    input StorePage { field storeId: Id; field page: PageNo; field size: PageSize; }
    input WeeklyShifts {
      field storeId: Id;
      field firstDay: Day;
      field band: ShiftBand;
      field weeks: Quantity;
    }
    input AssignInput { field shiftId: Id; field employeeId: Id; }
    input ShiftRef { field shiftId: Id; }
    input EmployeePage { field employeeId: Id; field page: PageNo; field size: PageSize; }
    error AlreadyAssigned http 409;
    error BadPage http 400;
    error EmployeeNotFound http 404;
    error Forbidden http 403;
    error ShiftExists http 409;
    error ShiftNotFound http 404;
    error StoreNotFound http 404;
    error TooManyWeeks http 409;
    error WrongStore http 409;

    capability ListStores {
      input PageQuery;
      output Page<StoreView>;
      fails BadPage;
      requires readonly;
      expose query at "/stores";
      workflow {
        find Store where true order by name ascending, id ascending
          Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    capability StoreShifts {
      actor Ref<User>;
      input StorePage;
      output Page<ShiftView>;
      fails BadPage;
      fails Forbidden;
      fails StoreNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/stores/{storeId}/shifts";
      workflow {
        load Store by input.storeId as store else StoreNotFound;
        validate store.manager == actor else Forbidden;
        find Shift where item.store == store order by day ascending, id ascending
          Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    capability StoreEmployees {
      actor Ref<User>;
      input StorePage;
      output Page<EmployeeView>;
      fails BadPage;
      fails Forbidden;
      fails StoreNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/stores/{storeId}/employees";
      workflow {
        load Store by input.storeId as store else StoreNotFound;
        validate store.manager == actor else Forbidden;
        find Employee where item.store == store order by name ascending, id ascending
          Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    capability EmployeeRoster {
      actor Ref<User>;
      input EmployeePage;
      output Page<AssignmentView>;
      fails BadPage;
      fails EmployeeNotFound;
      fails Forbidden;
      fails StoreNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/employees/{employeeId}/roster";
      workflow {
        load Employee by input.employeeId as employee else EmployeeNotFound;
        load Store by employee.store as store else StoreNotFound;
        validate store.manager == actor else Forbidden;
        find Assignment where item.employee == employee order by id ascending
          Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
  }
}
