sir 0.3

software FacilityMaintenance {
  metadata {
    displayName "Facility Maintenance";
    namespace "example.maintenance";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Id generated auto;
      field name: Name unique;
    }
    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }
    entity Facility persistent {
      identity id: Id generated auto;
      field name: Name;
      field manager: Ref<User>;
    }
    entity WorkOrder persistent {
      identity id: Id generated auto;
      field facility: Ref<Facility>;
      field reporter: Ref<User>;
      field title: Name;
      field assignee: Optional<Ref<User>>;
      field note: Optional<Remark>;
      field removed: Flag default false;
      field version: Serial versioned;
      scope removed == false;
    }
    entity InspectionOrder persistent {
      identity id: Id generated auto;
      field facility: Ref<Facility>;
      field title: Name;
      field dueAt: Moment;
      field closed: Flag default false;
    }
    view FacilityView from Facility {
      field id: Id;
      field name: Name;
    }
    view WorkOrderView from WorkOrder {
      field id: Id;
      field facility: Ref<Facility>;
      field reporter: Ref<User>;
      field title: Name;
      field assignee: Optional<Ref<User>>;
      field note: Optional<Remark>;
      field removed: Flag;
      field version: Serial;
    }
    view InspectionView from InspectionOrder {
      field id: Id;
      field facility: Ref<Facility>;
      field title: Name;
      field dueAt: Moment;
      field closed: Flag;
    }
    input PageQuery { field page: PageNo; field size: PageSize; }
    input NewWorkOrder { field facilityId: Id; field title: Name; }
    input WorkOrderRef { field id: Id; }
    input WorkOrderPatch patch of WorkOrder {
      field id: Id;
      field expectedVersion: Version;
      field title: Text;
      field assignee: Optional<Ref<User>>;
      field note: Optional<Text>;
      field removed: Flag;
    }
    input WorkOrderQuery {
      field facilityId: Id;
      field assignee: Optional<Ref<User>>;
      field page: PageNo;
      field size: PageSize;
    }
    input InspectionPlan {
      field facilityId: Id;
      field title: Name;
      field firstDueAt: Moment;
      field intervalDays: Count where min(1), max(30);
      field occurrences: Quantity;
    }
    input CloseInput { field facilityId: Id; field cutoff: Moment; }
    input FacilityPage { field facilityId: Id; field page: PageNo; field size: PageSize; }
    error BadPage http 400;
    error EmptyChange http 400;
    error FacilityNotFound http 404;
    error Forbidden http 403;
    error StaleVersion http 409;
    error TooManyInspections http 409;
    error TooManyOccurrences http 409;
    error WorkOrderNotFound http 404;

    capability ListFacilities {
      input PageQuery;
      output Page<FacilityView>;
      fails BadPage;
      requires readonly;
      expose query at "/facilities";
      workflow {
        find Facility where true order by name ascending, id ascending
          Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    capability OpenWorkOrder {
      actor Ref<User>;
      input NewWorkOrder;
      output WorkOrderView;
      fails FacilityNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/work-orders";
      workflow {
        load Facility by input.facilityId as facility else FacilityNotFound;
        create WorkOrder as made {
          facility: facility;
          reporter: actor;
          title: input.title;
        }
        persist made;
        return made;
      }
    }
    capability EditWorkOrder {
      actor Ref<User>;
      input WorkOrderPatch;
      output WorkOrderView;
      fails EmptyChange;
      fails FacilityNotFound;
      fails Forbidden;
      fails StaleVersion;
      fails WorkOrderNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/work-orders/{id}";
      workflow {
        validate input.title.present or input.assignee.present or input.note.present or input.removed.present else EmptyChange;
        load WorkOrder by input.id as row else WorkOrderNotFound;
        load Facility by row.facility as facility else FacilityNotFound;
        validate facility.manager == actor else Forbidden;
        validate row.version == input.expectedVersion else StaleVersion;
        update row {
          title: input.title;
          assignee: input.assignee;
          note: input.note;
          removed: input.removed;
        }
        persist row else StaleVersion;
        return row;
      }
    }
    capability GetWorkOrder {
      actor Ref<User>;
      input WorkOrderRef;
      output WorkOrderView;
      fails FacilityNotFound;
      fails Forbidden;
      fails WorkOrderNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/work-orders/{id}";
      workflow {
        load WorkOrder by input.id as row else WorkOrderNotFound;
        load Facility by row.facility as facility else FacilityNotFound;
        validate facility.manager == actor else Forbidden;
        return row;
      }
    }
    capability ListWorkOrders {
      actor Ref<User>;
      input WorkOrderQuery;
      output Page<WorkOrderView>;
      fails BadPage;
      fails FacilityNotFound;
      fails Forbidden;
      requires authenticated;
      requires readonly;
      expose query at "/facilities/{facilityId}/work-orders";
      workflow {
        load Facility by input.facilityId as facility else FacilityNotFound;
        validate facility.manager == actor else Forbidden;
        find WorkOrder where item.facility == facility
          and (input.assignee is none or item.assignee == input.assignee)
          order by id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    capability GenerateInspections {
      actor Ref<User>;
      input InspectionPlan;
      output Unit;
      fails FacilityNotFound;
      fails Forbidden;
      fails TooManyOccurrences;
      requires authenticated;
      requires atomic;
      expose command at "/facilities/{facilityId}/inspection-series";
      workflow {
        load Facility by input.facilityId as facility else FacilityNotFound;
        validate facility.manager == actor else Forbidden;
        validate input.occurrences <= 24 else TooManyOccurrences;
        repeat input.occurrences times limit 24 else TooManyOccurrences as index {
          create InspectionOrder as made {
            facility: facility;
            title: input.title;
            dueAt: addDays(input.firstDueAt, index * input.intervalDays);
          }
          persist made;
        }
        return unit;
      }
    }
    capability CloseOverdueInspections {
      actor Ref<User>;
      input CloseInput;
      output Unit;
      fails FacilityNotFound;
      fails Forbidden;
      fails TooManyInspections;
      requires authenticated;
      requires atomic;
      expose command at "/facilities/{facilityId}/close-overdue-inspections";
      workflow {
        load Facility by input.facilityId as facility for update else FacilityNotFound;
        validate facility.manager == actor else Forbidden;
        count InspectionOrder where item.facility == facility
          and item.closed == false and item.dueAt < input.cutoff as overdue;
        validate overdue <= 50 else TooManyInspections;
        each InspectionOrder where item.facility == facility
          and item.closed == false and item.dueAt < input.cutoff
          order by id ascending limit 50 else TooManyInspections as row {
          update row { closed: true; }
          persist row;
        }
        return unit;
      }
    }
    capability ListInspections {
      actor Ref<User>;
      input FacilityPage;
      output Page<InspectionView>;
      fails BadPage;
      fails FacilityNotFound;
      fails Forbidden;
      requires authenticated;
      requires readonly;
      expose query at "/facilities/{facilityId}/inspections";
      workflow {
        load Facility by input.facilityId as facility else FacilityNotFound;
        validate facility.manager == actor else Forbidden;
        find InspectionOrder where item.facility == facility
          order by dueAt ascending, id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
  }
}
