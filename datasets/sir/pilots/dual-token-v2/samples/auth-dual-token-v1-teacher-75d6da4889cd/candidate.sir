sir 0.3

software DualTokenDesk {
  metadata {
    displayName "Dual Token Desk";
    namespace "example.dualtoken";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Id generated auto;
      field name: Name unique;
      field passwordHash: Secret;
    }
    entity Note persistent {
      identity id: Id generated auto;
      field author: Ref<User>;
      field text: Text;
    }
    entity AccessToken persistent {
      identity id: Token generated uuid;
      credential subject owner expires expiresAt;
      field owner: Ref<User>;
      field expiresAt: Moment;
    }
    entity RefreshToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      field used: Flag;
    }
    view NoteView from Note {
      field id: Id;
      field text: Text;
    }
    input NoteInput {
      field text: Text where notBlank;
    }
    view UserView from User {
      field id: Id;
      field name: Text;
    }
    input UserRef {
      field id: Id;
    }
    error UserNotFound http 404;
    input RegisterInput {
      field name: Text;
      field password: Text;
    }
    input LoginInput {
      field name: Text;
      field password: Text;
    }
    input RefreshInput {
      field refreshToken: Token;
    }
    view TokenPairView from TokenPair {
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }
    error BadLogin http 401;
    error InvalidRefreshToken http 401;
    error ExpiredRefreshToken http 401;
    error InvalidAccessToken http 401;
    capability GetUser {
      input UserRef;
      output UserView;
      fails UserNotFound;
      requires readonly;
      expose query;
      workflow {
        load User by input.id as user else UserNotFound;
        return user;
      }
    }
    capability Register {
      input RegisterInput;
      output UserView;
      requires atomic;
      expose command;
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user;
        return user;
      }
    }
    capability PostNote {
      actor Ref<User>;
      input NoteInput;
      output NoteView;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        create Note as note {
          author: actor;
          text: input.text;
        }
        persist note;
        return note;
      }
    }
    capability Login {
      input LoginInput;
      output TokenPairView;
      fails BadLogin;
      requires atomic;
      expose command;
      workflow {
        load User by name: input.name as holder else BadLogin;
        validate holder.passwordHash matches input.password else BadLogin;
        create AccessToken as access {
          owner: holder;
          expiresAt: now() + 15 minutes;
        }
        persist access;
        create RefreshToken as refresh {
          owner: holder;
          expiresAt: now() + 7 days;
          used: false;
        }
        persist refresh;
        return pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: refresh.id;
          refreshExpiresAt: refresh.expiresAt;
        };
      }
    }
    capability Refresh {
      input RefreshInput;
      output TokenPairView;
      fails InvalidRefreshToken;
      requires atomic;
      expose command;
      workflow {
        load RefreshToken by input.refreshToken as old else InvalidRefreshToken;
        validate old.expiresAt > now() else InvalidRefreshToken;
        update old when old.used == false and old.expiresAt > now() else InvalidRefreshToken {
          used: true;
        }
        create AccessToken as access {
          owner: old.owner;
          expiresAt: now() + 15 minutes;
        }
        persist access;
        create RefreshToken as refresh {
          owner: old.owner;
          expiresAt: now() + 7 days;
          used: false;
        }
        persist refresh;
        persist old;
        return pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: refresh.id;
          refreshExpiresAt: refresh.expiresAt;
        };
      }
    }
    capability Logout {
      input RefreshInput;
      output Flag;
      requires atomic;
      expose command;
      workflow {
        load RefreshToken by input.refreshToken as old else InvalidRefreshToken;
        update old when old.used == false {
          used: true;
        }
        persist old;
        return true;
      }
    }
  }
}
