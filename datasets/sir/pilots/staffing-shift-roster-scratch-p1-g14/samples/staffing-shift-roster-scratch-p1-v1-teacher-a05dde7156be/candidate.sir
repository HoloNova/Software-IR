sir 0.3
software StaffingShiftRoster {
  metadata { displayName "StaffingShiftRoster"; namespace "example.staffing"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    enum ShiftBand { OPENING, CLOSING }

    entity User persistent {
      identity id: Id generated auto;
      field name: Name unique;
    }

    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }

    entity Store persistent {
      identity id: Id generated auto;
      field name: Name;
      field manager: Ref<User>;
    }

    entity Employee persistent {
      identity id: Id generated auto;
      field store: Ref<Store>;
      field name: Name;
    }

    entity Shift persistent {
      identity id: Id generated auto;
      field store: Ref<Store>;
      field day: Day;
      field band: ShiftBand;
      unique (store, day, band);
    }

    entity Assignment persistent {
      identity id: Id generated auto;
      field employee: Ref<Employee>;
      field shift: Ref<Shift>;
      unique (employee, shift);
    }

    input ListStoresInput {
      field page: PageNo;
      field size: PageSize;
    }

    input GenerateWeeklyShiftsInput {
      field storeId: Id;
      field firstDay: Day;
      field band: ShiftBand;
      field weeks: Count where min(1);
    }

    input StoreShiftsInput {
      field storeId: Id;
      field page: PageNo;
      field size: PageSize;
    }

    input StoreEmployeesInput {
      field storeId: Id;
      field page: PageNo;
      field size: PageSize;
    }

    input AssignEmployeeInput {
      field shiftId: Id;
      field employeeId: Id;
    }

    input ShiftHeadcountInput {
      field shiftId: Id;
    }

    input EmployeeRosterInput {
      field employeeId: Id;
      field page: PageNo;
      field size: PageSize;
    }

    view StoreView from Store {
      field id: Id;
      field name: Name;
    }

    view ShiftView from Shift {
      field id: Id;
      field store: Ref<Store>;
      field day: Day;
      field band: ShiftBand;
    }

    view EmployeeView from Employee {
      field id: Id;
      field store: Ref<Store>;
      field name: Name;
    }

    view AssignmentView from Assignment {
      field id: Id;
      field employee: Ref<Employee>;
      field shift: Ref<Shift>;
    }

    error BadPage http 400;
    error StoreNotFound http 404;
    error ShiftNotFound http 404;
    error EmployeeNotFound http 404;
    error Forbidden http 403;
    error TooManyWeeks http 409;
    error ShiftExists http 409;
    error WrongStore http 409;
    error AlreadyAssigned http 409;

    capability ListStores {
      input ListStoresInput;
      output Page<StoreView>;
      fails BadPage;
      requires readonly;
      expose query at "/stores";
      workflow {
        find Store where true order by name ascending, id ascending Page input.page, input.size else BadPage as stores;
        return stores;
      }
    }

    capability GenerateWeeklyShifts {
      actor Ref<User>;
      input GenerateWeeklyShiftsInput;
      output Unit;
      fails Forbidden;
      fails ShiftExists;
      fails StoreNotFound;
      fails TooManyWeeks;
      requires authenticated;
      requires atomic;
      expose command at "/stores/{storeId}/weekly-shifts";
      workflow {
        validate input.weeks <= 8 else TooManyWeeks;
        load Store by input.storeId as store for update else StoreNotFound;
        validate store.manager == actor else Forbidden;
        repeat input.weeks times limit 8 else TooManyWeeks as week {
          create Shift as made {
            store: store;
            day: addDays(input.firstDay, week * 7);
            band: input.band;
          }
          persist made else ShiftExists;
        }
        return unit;
      }
    }

    capability StoreShifts {
      actor Ref<User>;
      input StoreShiftsInput;
      output Page<ShiftView>;
      fails BadPage;
      fails Forbidden;
      fails StoreNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/stores/{storeId}/shifts";
      workflow {
        load Store by input.storeId as store else StoreNotFound;
        validate store.manager == actor else Forbidden;
        find Shift where item.store == store order by day ascending, id ascending Page input.page, input.size else BadPage as shifts;
        return shifts;
      }
    }

    capability StoreEmployees {
      actor Ref<User>;
      input StoreEmployeesInput;
      output Page<EmployeeView>;
      fails BadPage;
      fails Forbidden;
      fails StoreNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/stores/{storeId}/employees";
      workflow {
        load Store by input.storeId as store else StoreNotFound;
        validate store.manager == actor else Forbidden;
        find Employee where item.store == store order by name ascending, id ascending Page input.page, input.size else BadPage as staff;
        return staff;
      }
    }

    capability AssignEmployee {
      actor Ref<User>;
      input AssignEmployeeInput;
      output AssignmentView;
      fails AlreadyAssigned;
      fails EmployeeNotFound;
      fails Forbidden;
      fails ShiftNotFound;
      fails StoreNotFound;
      fails WrongStore;
      requires authenticated;
      requires atomic;
      expose command at "/shifts/{shiftId}/assignments";
      workflow {
        load Shift by input.shiftId as shift for update else ShiftNotFound;
        load Store by shift.store as store else StoreNotFound;
        validate store.manager == actor else Forbidden;
        load Employee by input.employeeId as staff else EmployeeNotFound;
        validate staff.store == store else WrongStore;
        exists Assignment where item.employee == staff and item.shift == shift as found;
        validate not found else AlreadyAssigned;
        create Assignment as made {
          employee: staff;
          shift: shift;
        }
        persist made else AlreadyAssigned;
        return made;
      }
    }

    capability ShiftHeadcount {
      actor Ref<User>;
      input ShiftHeadcountInput;
      output Serial;
      fails Forbidden;
      fails ShiftNotFound;
      fails StoreNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/shifts/{shiftId}/headcount";
      workflow {
        load Shift by input.shiftId as shift else ShiftNotFound;
        load Store by shift.store as store else StoreNotFound;
        validate store.manager == actor else Forbidden;
        count Assignment where item.shift == shift as headcount;
        return headcount;
      }
    }

    capability EmployeeRoster {
      actor Ref<User>;
      input EmployeeRosterInput;
      output Page<AssignmentView>;
      fails BadPage;
      fails EmployeeNotFound;
      fails Forbidden;
      fails StoreNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/employees/{employeeId}/roster";
      workflow {
        load Employee by input.employeeId as staff else EmployeeNotFound;
        load Store by staff.store as store else StoreNotFound;
        validate store.manager == actor else Forbidden;
        find Assignment where item.employee == staff order by id ascending Page input.page, input.size else BadPage as roster;
        return roster;
      }
    }
  }
}
