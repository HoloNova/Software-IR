sir 0.3
software TokenDesk {
  metadata { displayName "TokenDesk"; namespace "com.example.tokendesk"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    entity Credential persistent {
      identity id: Token generated uuid;
      field owner: Name;
      field used: Flag default false;
      field expiresAt: Moment;
    }

    entity Account persistent {
      identity id: Id generated auto;
      field name: Name unique;
      field passwordHash: Secret;
    }

    view CredentialView from Credential {
      field id: Token;
      field owner: Name;
      field expiresAt: Moment;
    }

    view AccountView from Account {
      field id: Id;
      field name: Name;
    }

    input GetCredentialInput {
      field id: Token;
    }

    input RefreshInput {
      field token: Token;
    }

    input TouchInput {
      field token: Token;
    }

    input RegisterInput {
      field name: Name where length(1, 64);
      field password: Text where notBlank;
    }

    input LoginInput {
      field name: Name where length(1, 64);
      field password: Text where notBlank;
    }

    input FindAccountInput {
      field name: Name where length(1, 64);
    }

    error CredentialNotFound http 404;
    error AccountNotFound http 404;
    error BadLogin http 401;
    error Expired http 400;
    error Invalid http 409;

    capability GetCredential {
      input GetCredentialInput;
      output CredentialView;
      fails CredentialNotFound;
      requires readonly;
      expose query at "/get-credential";
      workflow {
        load Credential by input.id as credential else CredentialNotFound;
        return credential;
      }
    }

    capability Refresh {
      input RefreshInput;
      output CredentialView;
      fails Expired;
      fails Invalid;
      requires atomic;
      expose command at "/refresh";
      workflow {
        load Credential by input.token as old else Invalid;
        validate old.used == false else Invalid;
        validate old.expiresAt > now() else Expired;
        update old { used: true; }
        persist old;
        create Credential as fresh {
          owner: old.owner;
          used: false;
          expiresAt: now() + 7 days;
        }
        persist fresh;
        return fresh;
      }
    }

    capability Touch {
      input TouchInput;
      output CredentialView;
      fails Invalid;
      requires atomic;
      expose command at "/touch";
      workflow {
        load Credential by input.token as credential else Invalid;
        validate credential.owner == "alice" else Invalid;
        update credential { used: true; }
        persist credential;
        return credential;
      }
    }

    capability Register {
      input RegisterInput;
      output AccountView;
      requires atomic;
      expose command at "/register";
      workflow {
        create Account as account {
          name: input.name;
          passwordHash: input.password;
        }
        persist account;
        return account;
      }
    }

    capability Login {
      input LoginInput;
      output AccountView;
      fails BadLogin;
      requires readonly;
      expose command at "/login";
      workflow {
        load Account by name: input.name as account else BadLogin;
        validate account.passwordHash matches input.password else BadLogin;
        return account;
      }
    }

    capability FindAccount {
      input FindAccountInput;
      output AccountView;
      fails AccountNotFound;
      requires readonly;
      expose query at "/find-account";
      workflow {
        load Account by name: input.name as account else AccountNotFound;
        return account;
      }
    }
  }
}
