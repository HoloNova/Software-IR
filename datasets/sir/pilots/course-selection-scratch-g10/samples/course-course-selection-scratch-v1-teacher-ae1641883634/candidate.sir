sir 0.3
software CourseSelection {
  metadata { displayName "CourseSelection"; namespace "example.course"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    enum Role { STUDENT, TEACHER, ADMIN }

    entity User persistent {
      identity id: Id generated auto;
      field role: Role default Role.STUDENT;
      field name: Name unique;
      field passwordHash: Secret;
    }

    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }

    entity RefreshToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field used: Flag default false;
      field expiresAt: Moment;
    }

    entity TokenPair persistent {
      identity id: Id generated auto;
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }

    entity Course persistent {
      identity id: Id generated auto;
      field code: Code unique;
      field name: Name;
      field teacher: Ref<User>;
      field capacity: Quantity;
      field enrolled: Count default 0;
      field weekday: Count where min(1), max(7);
      field startPeriod: Count where min(1), max(12);
      field endPeriod: Count where min(1), max(13);
      field published: Flag default false;
    }

    entity Enrollment persistent {
      identity id: Id generated auto;
      field student: Ref<User>;
      field course: Ref<Course>;
      field createdAt: Moment;
      unique (student, course);
    }

    entity Prerequisite persistent {
      identity id: Id generated auto;
      field targetCourse: Ref<Course>;
      field required: Ref<Course>;
      unique (targetCourse, required);
    }

    entity CompletedCourse persistent {
      identity id: Id generated auto;
      field student: Ref<User>;
      field course: Ref<Course>;
      field completedAt: Moment;
      unique (student, course);
    }

    input RegisterInput {
      field name: Name where length(1, 64);
      field password: Secret;
    }

    input LoginInput {
      field name: Name where length(1, 64);
      field password: Secret;
    }

    input RefreshInput {
      field refreshToken: Token;
    }

    input LogoutInput {
      field refreshToken: Token;
    }

    input CreateCourseInput {
      field code: Code;
      field name: Name where length(1, 64);
      field teacherId: Id;
      field capacity: Quantity;
      field weekday: Count where min(1), max(7);
      field startPeriod: Count where min(1), max(12);
      field endPeriod: Count where min(1), max(13);
    }

    input SearchCoursesInput {
      field keyword: Optional<Text>;
      field page: PageNo;
      field size: PageSize;
    }

    input PublishCourseInput {
      field id: Id;
    }

    input AddPrerequisiteInput {
      field courseId: Id;
      field requiredId: Id;
    }

    input RemovePrerequisiteInput {
      field id: Id;
    }

    input RecordCompletionInput {
      field studentId: Id;
      field courseId: Id;
    }

    input EnrollInput {
      field id: Id;
    }

    input DropInput {
      field id: Id;
    }

    input MyEnrollmentsInput {
      field page: PageNo;
      field size: PageSize;
    }

    input RosterInput {
      field courseId: Id;
      field page: PageNo;
      field size: PageSize;
    }

    view UserView from User {
      field id: Id;
      field name: Name;
      field role: Role;
    }

    view TeacherSummary from User {
      field id: Id;
      field name: Name;
    }

    view CourseView from Course {
      field id: Id;
      field code: Code;
      field name: Name;
      field teacher: TeacherSummary;
      field capacity: Quantity;
      field enrolled: Count;
      field remaining: Count = item.capacity - item.enrolled;
      field full: Flag = item.enrolled >= item.capacity;
      field weekday: Count;
      field startPeriod: Count;
      field endPeriod: Count;
      field published: Flag;
    }

    view EnrollmentView from Enrollment {
      field id: Id;
      field course: Ref<Course>;
      field createdAt: Moment;
    }

    view TokenPairView from TokenPair {
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }

    error BadPage http 400;
    error InvalidSchedule http 400;
    error InvalidPrerequisite http 400;
    error Forbidden http 403;
    error CourseNotFound http 404;
    error TeacherNotFound http 404;
    error StudentNotFound http 404;
    error PrerequisiteNotFound http 404;
    error EnrollmentNotFound http 404;
    error AlreadyEnrolled http 409;
    error CompletionExists http 409;
    error CourseFull http 409;
    error CourseNotOpen http 409;
    error CoursePublished http 409;
    error EnrollmentCounterMismatch http 409;
    error MissingPrerequisites http 409;
    error PrerequisiteExists http 409;
    error TimeConflict http 409;

    capability Register {
      input RegisterInput;
      output UserView;
      fails Forbidden;
      requires atomic;
      expose command at "/register";
      workflow {
        exists User where item.name == input.name as taken;
        validate not taken else Forbidden;
        create User as made {
          name: input.name;
          passwordHash: input.password;
        }
        persist made else Forbidden;
        return made;
      }
    }

    capability Login {
      input LoginInput;
      output TokenPairView;
      fails Forbidden;
      requires atomic;
      expose command at "/login";
      workflow {
        load User by name: input.name as account else Forbidden;
        validate account.passwordHash matches input.password else Forbidden;
        create AccessToken as access {
          owner: account;
          expiresAt: now() + 15 minutes;
        }
        persist access;
        create RefreshToken as fresh {
          owner: account;
          used: false;
          expiresAt: now() + 7 days;
        }
        persist fresh;
        create TokenPair as pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: fresh.id;
          refreshExpiresAt: fresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }

    capability Refresh {
      input RefreshInput;
      output TokenPairView;
      fails Forbidden;
      requires atomic;
      expose command at "/refresh";
      workflow {
        load RefreshToken by input.refreshToken as stored else Forbidden;
        validate stored.used == false else Forbidden;
        validate stored.expiresAt > now() else Forbidden;
        update stored { used: true; }
        persist stored;
        create AccessToken as access {
          owner: stored.owner;
          expiresAt: now() + 15 minutes;
        }
        persist access;
        create RefreshToken as fresh {
          owner: stored.owner;
          used: false;
          expiresAt: now() + 7 days;
        }
        persist fresh;
        create TokenPair as pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: fresh.id;
          refreshExpiresAt: fresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }

    capability Logout {
      input LogoutInput;
      output Unit;
      requires atomic;
      expose command at "/logout";
      workflow {
        load RefreshToken by input.refreshToken as stored else Forbidden;
        update stored { used: true; }
        persist stored;
        return unit;
      }
    }

    capability CreateCourse {
      actor Ref<User>;
      input CreateCourseInput;
      output CourseView;
      fails Forbidden;
      fails InvalidSchedule;
      fails TeacherNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/courses";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        validate input.endPeriod > input.startPeriod else InvalidSchedule;
        load User by input.teacherId as teacher else TeacherNotFound;
        create Course as made {
          code: input.code;
          name: input.name;
          teacher: teacher;
          capacity: input.capacity;
          enrolled: 0;
          weekday: input.weekday;
          startPeriod: input.startPeriod;
          endPeriod: input.endPeriod;
          published: false;
        }
        persist made;
        return made;
      }
    }

    capability SearchCourses {
      input SearchCoursesInput;
      output Page<CourseView>;
      fails BadPage;
      requires readonly;
      expose query at "/courses";
      workflow {
        find Course where item.published == true and (input.keyword is none or item.name containsLiteral input.keyword or item.code containsLiteral input.keyword) order by code ascending, id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }

    capability PublishCourse {
      actor Ref<User>;
      input PublishCourseInput;
      output CourseView;
      fails CourseNotFound;
      fails CoursePublished;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command at "/courses/{id}/publish";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Course by input.id as course else CourseNotFound;
        validate course.published == false else CoursePublished;
        update course { published: true; }
        persist course;
        return course;
      }
    }

    capability AddPrerequisite {
      actor Ref<User>;
      input AddPrerequisiteInput;
      output Unit;
      fails CourseNotFound;
      fails CoursePublished;
      fails Forbidden;
      fails InvalidPrerequisite;
      fails PrerequisiteExists;
      requires authenticated;
      requires atomic;
      expose command at "/courses/{courseId}/prerequisites";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Course by input.courseId as targetCourse else CourseNotFound;
        load Course by input.requiredId as required else CourseNotFound;
        validate targetCourse.published == false else CoursePublished;
        validate required.published == true else InvalidPrerequisite;
        validate required.id != targetCourse.id else InvalidPrerequisite;
        exists Prerequisite where item.targetCourse == targetCourse and item.required == required as dup;
        validate not dup else PrerequisiteExists;
        create Prerequisite as made {
          targetCourse: targetCourse;
          required: required;
        }
        persist made else PrerequisiteExists;
        return unit;
      }
    }

    capability RemovePrerequisite {
      actor Ref<User>;
      input RemovePrerequisiteInput;
      output Unit;
      fails CoursePublished;
      fails Forbidden;
      fails PrerequisiteNotFound;
      requires authenticated;
      requires atomic;
      expose command delete at "/prerequisites/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Prerequisite by input.id as link else PrerequisiteNotFound;
        load Course by link.targetCourse as targetCourse else CourseNotFound;
        validate targetCourse.published == false else CoursePublished;
        delete link;
        return unit;
      }
    }

    capability RecordCompletion {
      actor Ref<User>;
      input RecordCompletionInput;
      output Unit;
      fails CompletionExists;
      fails CourseNotFound;
      fails Forbidden;
      fails StudentNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/completions";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load User by input.studentId as learner else StudentNotFound;
        load Course by input.courseId as course else CourseNotFound;
        exists CompletedCourse where item.student == learner and item.course == course as dup;
        validate not dup else CompletionExists;
        create CompletedCourse as made {
          student: learner;
          course: course;
          completedAt: now();
        }
        persist made else CompletionExists;
        return unit;
      }
    }

    capability Enroll {
      actor Ref<User>;
      input EnrollInput;
      output EnrollmentView;
      fails AlreadyEnrolled;
      fails CourseFull;
      fails CourseNotFound;
      fails CourseNotOpen;
      fails EnrollmentCounterMismatch;
      fails Forbidden;
      fails MissingPrerequisites;
      fails TimeConflict;
      requires authenticated;
      requires atomic;
      expose command at "/courses/{id}/enroll";
      workflow {
        validate actor.role == Role.STUDENT else Forbidden;
        load User by actor.id as student for update else Forbidden;
        load Course by input.id as course else CourseNotFound;
        validate course.published == true else CourseNotOpen;
        exists Enrollment where item.student == student and item.course == course as dup;
        validate not dup else AlreadyEnrolled;
        count Prerequisite where item.targetCourse == course and not any(CompletedCourse, student == student and course == item.required) as missing;
        validate missing == 0 else MissingPrerequisites;
        exists Enrollment where item.student == student and any(Course, id == item.course and weekday == course.weekday and startPeriod < course.endPeriod and endPeriod > course.startPeriod) as clash;
        validate not clash else TimeConflict;
        validate course.enrolled < course.capacity else CourseFull;
        validate course.enrolled >= 0 else EnrollmentCounterMismatch;
        update course when course.enrolled < course.capacity else CourseFull { enrolled: course.enrolled + 1; }
        persist course;
        create Enrollment as made {
          student: student;
          course: course;
          createdAt: now();
        }
        persist made else AlreadyEnrolled;
        return made;
      }
    }

    capability Drop {
      actor Ref<User>;
      input DropInput;
      output Unit;
      fails EnrollmentNotFound;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command delete at "/enrollments/{id}";
      workflow {
        load Enrollment by input.id as record else EnrollmentNotFound;
        validate record.student == actor else Forbidden;
        load Course by record.course as course else CourseNotFound;
        delete record;
        update course when course.enrolled > 0 else EnrollmentCounterMismatch { enrolled: course.enrolled - 1; }
        persist course;
        return unit;
      }
    }

    capability MyEnrollments {
      actor Ref<User>;
      input MyEnrollmentsInput;
      output Page<EnrollmentView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/enrollments";
      workflow {
        find Enrollment where item.student == actor order by createdAt descending, id descending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }

    capability Roster {
      actor Ref<User>;
      input RosterInput;
      output Page<EnrollmentView>;
      fails BadPage;
      fails CourseNotFound;
      fails Forbidden;
      requires authenticated;
      requires readonly;
      expose query at "/courses/{courseId}/roster";
      workflow {
        load Course by input.courseId as course else CourseNotFound;
        validate course.teacher == actor else Forbidden;
        find Enrollment where item.course == course order by createdAt ascending, id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
  }
}
