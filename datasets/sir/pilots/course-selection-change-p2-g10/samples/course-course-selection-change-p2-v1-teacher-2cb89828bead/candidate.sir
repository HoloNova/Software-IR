sir 0.3
software CourseSelection {
  metadata {
    displayName "Course Selection";
    namespace "example.course";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    enum Role { STUDENT, TEACHER, ADMIN }
    entity User persistent {
      identity id: Id generated auto;
      field name: Name unique;
      field passwordHash: Secret;
      field role: Role default Role.STUDENT;
    }
    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }
    entity RefreshToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field used: Flag default false;
      field expiresAt: Moment;
    }
    entity TokenPair persistent {
      identity id: Id generated auto;
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }
    error BadLogin http 401;
    error InvalidToken http 401;
    error TokenUsed http 401;
    input LoginInput {
      field name: Name;
      field password: Secret;
    }
    view TokenPairView from TokenPair {
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }
    capability Login {
      input LoginInput;
      output TokenPairView;
      fails BadLogin;
      requires atomic;
      expose command at "/login";
      workflow {
        load User by name: input.name as account else BadLogin;
        validate account.passwordHash matches input.password else BadLogin;
        create AccessToken as access {
          owner: account;
          expiresAt: now() + 15 minutes;
        }
        persist access;
        create RefreshToken as refresh {
          owner: account;
          expiresAt: now() + 7 days;
        }
        persist refresh;
        create TokenPair as pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: refresh.id;
          refreshExpiresAt: refresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }
    input RefreshInput {
      field refreshToken: Token;
    }
    capability Refresh {
      input RefreshInput;
      output TokenPairView;
      fails InvalidToken;
      fails TokenUsed;
      requires atomic;
      expose command at "/refresh";
      workflow {
        load RefreshToken by input.refreshToken as refresh for update else InvalidToken;
        validate refresh.used == false else TokenUsed;
        validate refresh.expiresAt > now() else InvalidToken;
        load User by refresh.owner as account else InvalidToken;
        update refresh {
          used: true;
        }
        persist refresh;
        create AccessToken as access {
          owner: account;
          expiresAt: now() + 15 minutes;
        }
        persist access;
        create RefreshToken as fresh {
          owner: account;
          expiresAt: now() + 7 days;
        }
        persist fresh;
        create TokenPair as pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: fresh.id;
          refreshExpiresAt: fresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }
    input LogoutInput {
      field refreshToken: Token;
    }
    capability Logout {
      input LogoutInput;
      output Unit;
      fails InvalidToken;
      requires atomic;
      expose command at "/logout";
      workflow {
        load RefreshToken by input.refreshToken as refresh for update else InvalidToken;
        update refresh {
          used: true;
        }
        persist refresh;
        return unit;
      }
    }
    input RegisterInput {
      field name: Name;
      field password: Secret;
    }
    view UserView from User {
      field id: Id;
      field name: Name;
      field role: Role;
    }
    error NameTaken http 409;
    capability Register {
      input RegisterInput;
      output UserView;
      fails NameTaken;
      requires atomic;
      expose command at "/register";
      workflow {
        exists User where item.name == input.name as taken;
        validate not taken else NameTaken;
        create User as account {
          name: input.name;
          passwordHash: input.password;
          role: Role.STUDENT;
        }
        persist account else NameTaken;
        return account;
      }
    }

    error BadPage;
    error Forbidden http 403;
    input PageOnly {
      field page: PageNo;
      field size: PageSize;
    }

    entity Course persistent {
      identity id: Id generated auto;
      field code: Code unique;
      field name: Name;
      field teacher: Ref<User>;
      field capacity: Quantity;
      field enrolled: Count default 0;
      field weekday: Quantity where min(1), max(7);
      field startPeriod: Quantity where min(1), max(12);
      field endPeriod: Quantity where min(1), max(13);
      field published: Flag default false;
    }
    entity Enrollment persistent {
      identity id: Id generated auto;
      field student: Ref<User>;
      field course: Ref<Course>;
      field createdAt: Moment default now();
      unique (student, course);
    }
    entity Prerequisite persistent {
      identity id: Id generated auto;
      field targetCourse: Ref<Course>;
      field required: Ref<Course>;
      unique (targetCourse, required);
    }
    entity CompletedCourse persistent {
      identity id: Id generated auto;
      field student: Ref<User>;
      field course: Ref<Course>;
      field completedAt: Moment default now();
      unique (student, course);
    }
    view CourseView from Course {
      field id: Id;
      field code: Code;
      field name: Name;
      field teacher: UserView;
      field capacity: Quantity;
      field enrolled: Count;
      field remaining: Count = item.capacity - item.enrolled;
      field full: Flag = item.enrolled >= item.capacity;
      field weekday: Quantity;
      field startPeriod: Quantity;
      field endPeriod: Quantity;
      field published: Flag;
    }
    view EnrollmentView from Enrollment {
      field id: Id;
      field course: CourseView;
      field createdAt: Moment;
    }

    error InvalidSchedule http 400;
    input CourseSearch {
      field keyword: Optional<Text>;
      field page: PageNo;
      field size: PageSize;
    }
    capability SearchCourses {
      input CourseSearch;
      output Page<CourseView>;
      fails BadPage;
      requires readonly;
      expose query at "/courses";
      workflow {
        find Course
          where item.published == true and (input.keyword is none or item.name containsLiteral input.keyword or item.code containsLiteral input.keyword)
          order by code ascending, id ascending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }

    input CourseRef {
      field id: Id;
    }
    error AlreadyEnrolled http 409;
    error CourseFull http 409;
    error CourseNotFound http 404;
    error CourseNotOpen http 409;
    error CoursePublished http 409;
    error InvalidPrerequisite http 400;
    error MissingPrerequisites http 409;
    error StudentNotFound http 404;
    error TimeConflict http 409;
    error EnrollmentCounterMismatch http 409;
    error PrerequisiteExists http 409;
    error PrerequisiteNotFound http 404;
    error CompletionExists http 409;
    capability Enroll {
      actor Ref<User>;
      input CourseRef;
      output EnrollmentView;
      fails AlreadyEnrolled;
      fails CourseFull;
      fails CourseNotFound;
      fails CourseNotOpen;
      fails MissingPrerequisites;
      fails StudentNotFound;
      fails TimeConflict;
      requires authenticated;
      requires atomic;
      expose command at "/courses/{id}/enroll";
      workflow {
        load User by actor as learner for update else StudentNotFound;
        load Course by input.id as selected for update else CourseNotFound;
        validate selected.published == true else CourseNotOpen;
        exists Enrollment where item.student == actor and item.course == selected as already;
        validate not already else AlreadyEnrolled;
        exists Course where item.weekday == selected.weekday
          and item.startPeriod < selected.endPeriod and item.endPeriod > selected.startPeriod
          and any(Enrollment, course == item and student == actor) as clashes;
        validate not clashes else TimeConflict;
        exists Course where any(Prerequisite, required == item and targetCourse == selected)
          and not any(CompletedCourse, course == item and student == actor) as missing;
        validate not missing else MissingPrerequisites;
        update selected when selected.enrolled < selected.capacity else CourseFull {
          enrolled: selected.enrolled + 1;
        }
        create Enrollment as made {
          student: actor;
          course: selected;
        }
        persist selected;
        persist made else AlreadyEnrolled;
        return made;
      }
    }
    input EnrollmentRef {
      field id: Id;
    }
    error EnrollmentNotFound http 404;
    capability Drop {
      actor Ref<User>;
      input EnrollmentRef;
      output Unit;
      fails CourseNotFound;
      fails EnrollmentCounterMismatch;
      fails EnrollmentNotFound;
      fails Forbidden;
      fails StudentNotFound;
      requires authenticated;
      requires atomic;
      expose command delete at "/enrollments/{id}";
      workflow {
        load User by actor as learner for update else StudentNotFound;
        load Enrollment by input.id as made for update else EnrollmentNotFound;
        validate made.student == actor else Forbidden;
        load Course by made.course as course for update else CourseNotFound;
        update course when course.enrolled > 0 else EnrollmentCounterMismatch {
          enrolled: course.enrolled - 1;
        }
        persist course;
        delete made;
        return unit;
      }
    }
    capability MyEnrollments {
      actor Ref<User>;
      input PageOnly;
      output Page<EnrollmentView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/enrollments";
      workflow {
        find Enrollment
          where item.student == actor
          order by createdAt descending, id descending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }
    input RosterQuery {
      field courseId: Id;
      field page: PageNo;
      field size: PageSize;
    }
    capability Roster {
      actor Ref<User>;
      input RosterQuery;
      output Page<EnrollmentView>;
      fails BadPage;
      fails CourseNotFound;
      fails Forbidden;
      requires authenticated;
      requires readonly;
      expose query at "/courses/{courseId}/roster";
      workflow {
        load Course by input.courseId as course else CourseNotFound;
        validate course.teacher == actor else Forbidden;
        find Enrollment
          where item.course == course
          order by createdAt ascending, id ascending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }

    input CreateCourseInput {
      field code: Code;
      field name: Name;
      field teacherId: Id;
      field capacity: Quantity;
      field weekday: Quantity where min(1), max(7);
      field startPeriod: Quantity where min(1), max(12);
      field endPeriod: Quantity where min(1), max(13);
    }
    capability CreateCourse {
      actor Ref<User>;
      input CreateCourseInput;
      output CourseView;
      fails Forbidden;
      fails InvalidSchedule;
      fails TeacherNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/courses";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        validate input.endPeriod > input.startPeriod else InvalidSchedule;
        load User by input.teacherId as teacher else TeacherNotFound;
        validate teacher.role == Role.TEACHER else TeacherNotFound;
        create Course as made {
          code: input.code;
          name: input.name;
          teacher: teacher;
          capacity: input.capacity;
          weekday: input.weekday;
          startPeriod: input.startPeriod;
          endPeriod: input.endPeriod;
          published: false;
          enrolled: 0;
        }
        persist made;
        return made;
      }
    }

    input AddPrerequisiteInput {
      field courseId: Id;
      field requiredId: Id;
    }
    capability AddPrerequisite {
      actor Ref<User>;
      input AddPrerequisiteInput;
      output Unit;
      fails CourseNotFound;
      fails CoursePublished;
      fails Forbidden;
      fails InvalidPrerequisite;
      fails PrerequisiteExists;
      requires authenticated;
      requires atomic;
      expose command at "/courses/{courseId}/prerequisites";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Course by input.courseId as target for update else CourseNotFound;
        validate target.published == false else CoursePublished;
        validate input.requiredId != input.courseId else InvalidPrerequisite;
        load Course by input.requiredId as required else InvalidPrerequisite;
        validate required.published == false else InvalidPrerequisite;
        exists Prerequisite where item.targetCourse == target and item.required == required as dup;
        validate not dup else PrerequisiteExists;
        create Prerequisite as made {
          targetCourse: target;
          required: required;
        }
        persist made else PrerequisiteExists;
        return unit;
      }
    }

    input PrerequisiteRef {
      field id: Id;
    }
    capability RemovePrerequisite {
      actor Ref<User>;
      input PrerequisiteRef;
      output Unit;
      fails CoursePublished;
      fails Forbidden;
      fails PrerequisiteNotFound;
      requires authenticated;
      requires atomic;
      expose command delete at "/prerequisites/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Prerequisite by input.id as link else PrerequisiteNotFound;
        load Course by link.targetCourse as target for update else PrerequisiteNotFound;
        validate target.published == false else CoursePublished;
        delete link;
        return unit;
      }
    }

    capability PublishCourse {
      actor Ref<User>;
      input CourseRef;
      output CourseView;
      fails CourseNotFound;
      fails CoursePublished;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command at "/courses/{id}/publish";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Course by input.id as target for update else CourseNotFound;
        validate target.published == false else CoursePublished;
        update target {
          published: true;
        }
        persist target;
        return target;
      }
    }

    input RecordCompletionInput {
      field studentId: Id;
      field courseId: Id;
    }
    capability RecordCompletion {
      actor Ref<User>;
      input RecordCompletionInput;
      output Unit;
      fails CompletionExists;
      fails CourseNotFound;
      fails Forbidden;
      fails StudentNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/completions";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load User by input.studentId as learner else StudentNotFound;
        load Course by input.courseId as passed else CourseNotFound;
        exists CompletedCourse where item.student == learner and item.course == passed as dup;
        validate not dup else CompletionExists;
        create CompletedCourse as made {
          student: learner;
          course: passed;
        }
        persist made else CompletionExists;
        return unit;
      }
    }
  }
}
