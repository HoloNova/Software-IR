sir 0.3
software TokenDesk {
  metadata { displayName "TokenDesk"; namespace "com.example.tokendesk"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    entity Account persistent {
      identity id: Id generated auto;
      field name: Name where length(1, 64) unique;
      field passwordHash: Secret;
    }

    entity Credential persistent {
      identity id: Token generated uuid;
      field owner: Ref<Account>;
      field used: Flag default false;
      field expiresAt: Moment;
    }

    input GetCredentialInput {
      field id: Id;
    }

    input RefreshInput {
      field token: Token;
    }

    input TouchInput {
      field token: Token;
    }

    input RegisterInput {
      field name: Name where length(1, 64);
      field password: Secret;
    }

    input LoginInput {
      field name: Name where length(1, 64);
      field password: Secret;
    }

    input FindAccountInput {
      field name: Name where length(1, 64);
    }

    view AccountView from Account {
      field id: Id;
      field name: Name;
    }

    view CredentialView from Credential {
      field id: Token;
      field owner: Ref<Account>;
      field expiresAt: Moment;
    }

    error AccountNotFound http 404;
    error BadLogin http 401;
    error CredentialNotFound http 404;
    error Expired http 400;
    error Invalid http 409;

    capability GetCredential {
      input GetCredentialInput;
      output CredentialView;
      fails CredentialNotFound;
      requires readonly;
      expose query;
      workflow {
        load Credential by input.id as found else CredentialNotFound;
        return found;
      }
    }

    capability Refresh {
      input RefreshInput;
      output CredentialView;
      fails Expired;
      fails Invalid;
      requires atomic;
      expose command;
      workflow {
        load Credential by input.token as current else Invalid;
        validate current.used == false else Invalid;
        validate current.expiresAt > now() else Expired;
        update current { used: true; }
        persist current;
        create Credential as made { owner: current.owner; used: false; expiresAt: now() + 7 days; }
        persist made;
        return made;
      }
    }

    capability Touch {
      input TouchInput;
      output CredentialView;
      fails Invalid;
      requires atomic;
      expose command;
      workflow {
        load Credential by input.token as current else Invalid;
        validate current.owner == actor else Invalid;
        update current { used: true; }
        persist current;
        return current;
      }
    }

    capability Register {
      input RegisterInput;
      output AccountView;
      requires atomic;
      expose command;
      workflow {
        exists Account where item.name == input.name as taken;
        validate not taken else Invalid;
        create Account as made { name: input.name; passwordHash: input.password; }
        persist made else Invalid;
        return made;
      }
    }

    capability Login {
      input LoginInput;
      output AccountView;
      fails BadLogin;
      requires readonly;
      expose command;
      workflow {
        load Account by name: input.name as account else BadLogin;
        validate account.passwordHash matches input.password else BadLogin;
        return account;
      }
    }

    capability FindAccount {
      input FindAccountInput;
      output AccountView;
      fails AccountNotFound;
      requires readonly;
      expose query;
      workflow {
        load Account by name: input.name as account else AccountNotFound;
        return account;
      }
    }
  }
}
