sir 0.3
software OnlineShop {
  metadata { displayName "OnlineShop"; namespace "example.multiplication"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    enum Role { CUSTOMER, ADMIN }
    enum OrderState { CREATED, PAID, SHIPPED, CANCELLED }
    enum ProductState { ON_SHELF, OFF_SHELF }

    type UnitPrice = Money where precision(21, 4), min(0);

    entity User persistent {
      identity id: Id generated auto;
      field role: Role default Role.CUSTOMER;
      field name: Name unique;
      field passwordHash: Secret;
    }

    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }

    entity RefreshToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field used: Flag default false;
      field expiresAt: Moment;
    }

    entity TokenPair persistent {
      identity id: Id generated auto;
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }

    entity ShopProduct persistent {
      identity id: Id generated auto;
      field name: Name;
      field description: Optional<Text>;
      field price: Money;
      field stock: Count;
      field state: ProductState default ProductState.ON_SHELF;
    }

    entity PurchaseOrder persistent {
      identity id: Id generated auto;
      field buyer: Ref<User>;
      field state: OrderState default OrderState.CREATED;
      field total: Money;
      field createdAt: Moment;
    }

    entity OrderLine persistent {
      identity id: Id generated auto;
      field purchase: Ref<PurchaseOrder>;
      field product: Ref<ShopProduct>;
      field quantity: Quantity;
      field unitPrice: Money;
    }

    entity CartItem persistent {
      identity id: Id generated auto;
      field owner: Ref<User>;
      field product: Ref<ShopProduct>;
      field quantity: Quantity;
      unique (owner, product);
    }

    entity Coupon persistent {
      identity id: Id generated auto;
      field code: Code unique;
      field amountOff: Money;
      field minSpend: Money;
      field startsAt: Moment;
      field endsAt: Moment;
      field totalLimit: Count;
      field used: Count default 0;
    }

    entity Redemption persistent {
      identity id: Id generated auto;
      field coupon: Ref<Coupon>;
      field buyer: Ref<User>;
      field purchase: Ref<PurchaseOrder>;
      field amountOff: Money;
      unique (coupon, buyer);
      unique (purchase, buyer);
    }

    entity Calculation persistent {
      identity id: Id generated auto;
      field amount: Money;
      field count: Count;
      field wide: Serial;
    }

    entity Product persistent {
      identity id: Id generated auto;
      field price: UnitPrice;
      field stock: Count;
    }

    entity Receipt persistent {
      identity id: Id generated auto;
      field product: Ref<Product>;
      field total: Money;
      field quantity: Quantity;
    }

    entity ReceiptLine persistent {
      identity id: Id generated auto;
      field receipt: Ref<Receipt>;
      field quantity: Quantity;
      field unitPrice: UnitPrice;
    }

    entity Course persistent {
      identity id: Id generated auto;
      field capacity: Quantity;
      field enrolled: Count default 0;
    }

    entity Room persistent {
      identity id: Id generated auto;
      field name: Name unique;
    }

    entity Booking persistent {
      identity id: Id generated auto;
      field room: Ref<Room>;
      field startsAt: Moment;
      field endsAt: Moment;
    }

    error BadPage http 400;
    error InvalidWindow http 400;
    error AlreadyInCart http 409;
    error CartEmpty http 409;
    error CartItemNotFound http 404;
    error CartTooLarge http 409;
    error CouponAlreadyUsed http 409;
    error CouponCodeTaken http 409;
    error CouponExhausted http 409;
    error CouponExpired http 409;
    error CouponNotFound http 404;
    error Forbidden http 403;
    error Full http 409;
    error InconsistentOrder http 409;
    error MinSpendNotMet http 409;
    error Missing http 404;
    error NotCancellable http 409;
    error NotPayable http 409;
    error NotShippable http 409;
    error NotYourOrder http 403;
    error OrderNotFound http 404;
    error OrderTooLarge http 409;
    error OutOfStock http 409;
    error ProductNotFound http 404;
    error RoomMissing http 404;
    error StockLimit http 409;
    error TooManyWeeks http 409;

    input RegisterInput { field name: Name where length(1, 64); field password: Secret where length(1, 128); }
    input LoginInput { field name: Name where length(1, 64); field password: Secret where length(1, 128); }
    input RefreshInput { field refreshToken: Token; }
    input LogoutInput { field refreshToken: Token; }

    view UserView from User { field id: Id; field name: Name; field role: Role; }
    view TokenView from TokenPair { field accessToken: Token; field accessExpiresAt: Moment; field refreshToken: Token; field refreshExpiresAt: Moment; }

    input AddProductInput { field name: Name where length(1, 64); field description: Optional<Text> where length(0, 255); field price: Money where min(0); field stock: Count where min(0); }
    view ProductView from ShopProduct { field id: Id; field name: Name; field description: Optional<Text>; field price: Money; field stock: Count; field state: ProductState; }
    view ProductDisplayView from ShopProduct { field id: Id; field price: Money; field stock: Count; field inventoryValue: UnitPrice = item.price * item.stock; field soldOut: Flag = item.stock == 0; }
    input SearchProductsInput { field keyword: Text where notBlank; field page: PageNo; field size: PageSize; }

    input BuyNowInput { field productId: Id; field quantity: Quantity where min(1); }
    view OrderView from PurchaseOrder { field id: Id; field state: OrderState; field total: Money; field createdAt: Moment; }
    view OrderLineView from OrderLine { field id: Id; field product: Ref<ShopProduct>; field quantity: Quantity; field unitPrice: Money; }
    view OrderLinePageView from OrderLine { field id: Id; field product: Ref<ShopProduct>; field quantity: Quantity; field unitPrice: Money; }

    input AddToCartInput { field productId: Id; field quantity: Quantity where min(1); }
    view CartItemView from CartItem { field id: Id; field product: Ref<ShopProduct>; field quantity: Quantity; }
    input ChangeCartQuantityInput { field id: Id; field quantity: Quantity where min(1); }
    input RemoveFromCartInput { field id: Id; }

    input AddCouponInput { field code: Code where length(1, 64); field amountOff: Money where min(0); field minSpend: Money where min(0); field startsAt: Moment; field endsAt: Moment; field totalLimit: Count where min(0); }
    view CouponView from Coupon { field id: Id; field code: Code; field amountOff: Money; field minSpend: Money; field startsAt: Moment; field endsAt: Moment; field totalLimit: Count; field used: Count; }
    input ApplyCouponInput { field orderId: Id; field code: Code where length(1, 64); }

    input PayInput { field id: Id; }
    input ShipInput { field id: Id; }
    input CancelOrderInput { field id: Id; }

    input MultiplyInput { field price: UnitPrice; field quantity: Quantity; field left: Count; field right: Count; field wide: Serial; }
    view CalculationView from Calculation { field id: Id; field amount: Money; field count: Count; field wide: Serial; }

    input PurchaseProductInput { field id: Id; field quantity: Quantity where min(1), max(2147483647); }
    view ReceiptView from Receipt { field id: Id; field total: Money; field quantity: Quantity; field doubledTotal: Money = item.total * 2; }

    input ShowProductInput { field id: Id; }

    input EnrollCourseInput { field id: Id; }
    input ShowCourseInput { field id: Id; }
    view CourseView from Course { field id: Id; field capacity: Quantity; field enrolled: Count; field remaining: Count = item.capacity - item.enrolled; field full: Flag = item.enrolled >= item.capacity; }

    input BookInput { field roomId: Id; field startsAt: Moment; field endsAt: Moment; }
    view BookingView from Booking { field id: Id; field startsAt: Moment; field endsAt: Moment; }
    input BookWeeklyInput { field roomId: Id; field startsAt: Moment; field endsAt: Moment; field weeks: Count where min(1), max(12); }

    capability Register {
      input RegisterInput;
      output UserView;
      fails Missing;
      requires atomic;
      expose command at "/register";
      workflow {
        validate input.name is present else Missing;
        create User as made { name: input.name; passwordHash: input.password; role: Role.CUSTOMER; }
        persist made;
        return made;
      }
    }

    capability Login {
      input LoginInput;
      output TokenView;
      fails Missing;
      requires atomic;
      expose command at "/login";
      workflow {
        validate input.name is present else Missing;
        find User where item.name == input.name as found else Missing;
        validate found.passwordHash matches input.password else Missing;
        create AccessToken as access { owner: found; expiresAt: now() + 15 minutes; }
        persist access;
        create RefreshToken as refresh { owner: found; expiresAt: now() + 7 days; }
        persist refresh;
        create TokenPair as made { accessToken: access.id; accessExpiresAt: access.expiresAt; refreshToken: refresh.id; refreshExpiresAt: refresh.expiresAt; }
        persist made;
        return made;
      }
    }

    capability Refresh {
      input RefreshInput;
      output TokenView;
      fails Missing;
      requires atomic;
      expose command at "/refresh";
      workflow {
        validate input.refreshToken is present else Missing;
        load RefreshToken by input.refreshToken as found else Missing;
        validate found.expiresAt > now() else Missing;
        validate found.used == false else Missing;
        update found { used: true; }
        persist found;
        create AccessToken as access { owner: found.owner; expiresAt: now() + 15 minutes; }
        persist access;
        create RefreshToken as refresh { owner: found.owner; expiresAt: now() + 7 days; }
        persist refresh;
        create TokenPair as made { accessToken: access.id; accessExpiresAt: access.expiresAt; refreshToken: refresh.id; refreshExpiresAt: refresh.expiresAt; }
        persist made;
        return made;
      }
    }

    capability Logout {
      input LogoutInput;
      output Unit;
      fails Missing;
      requires atomic;
      expose command at "/logout";
      workflow {
        validate input.refreshToken is present else Missing;
        load RefreshToken by input.refreshToken as found else Missing;
        delete found;
        return unit;
      }
    }

    capability AddProduct {
      actor Ref<User>;
      input AddProductInput;
      output ProductView;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command at "/products";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        create ShopProduct as made { name: input.name; description: input.description; price: input.price; stock: input.stock; state: ProductState.ON_SHELF; }
        persist made;
        return made;
      }
    }

    capability SearchProducts {
      input SearchProductsInput;
      output Page<ProductView>;
      fails BadPage;
      requires readonly;
      expose query at "/products";
      workflow {
        find ShopProduct where item.state == ProductState.ON_SHELF and item.name containsLiteral input.keyword order by name ascending, id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }

    capability ShowProduct {
      input ShowProductInput;
      output ProductDisplayView;
      fails ProductNotFound;
      requires readonly;
      expose query at "/products/show";
      workflow {
        load Product by input.id as found else ProductNotFound;
        return found;
      }
    }

    capability BuyNow {
      actor Ref<User>;
      input BuyNowInput;
      output OrderView;
      fails NotYourOrder;
      fails OutOfStock;
      fails ProductNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/orders";
      workflow {
        load ShopProduct by input.productId as goods else ProductNotFound;
        validate goods.state == ProductState.ON_SHELF else ProductNotFound;
        update goods when goods.stock >= input.quantity else OutOfStock { stock: goods.stock - input.quantity; }
        persist goods;
        create PurchaseOrder as made { buyer: actor; state: OrderState.CREATED; total: goods.price * input.quantity; createdAt: now(); }
        persist made;
        create OrderLine as line { purchase: made; product: goods; quantity: input.quantity; unitPrice: goods.price; }
        persist line;
        return made;
      }
    }

    capability AddToCart {
      actor Ref<User>;
      input AddToCartInput;
      output CartItemView;
      fails AlreadyInCart;
      fails ProductNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/cart";
      workflow {
        load ShopProduct by input.productId as goods else ProductNotFound;
        exists CartItem where item.owner == actor and item.product == goods as present;
        validate not present else AlreadyInCart;
        create CartItem as made { owner: actor; product: goods; quantity: input.quantity; }
        persist made;
        return made;
      }
    }

    capability ChangeCartQuantity {
      actor Ref<User>;
      input ChangeCartQuantityInput;
      output CartItemView;
      fails CartItemNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/cart/{id}/quantity";
      workflow {
        load CartItem by input.id as found else CartItemNotFound;
        validate found.owner == actor else CartItemNotFound;
        update found { quantity: input.quantity; }
        persist found;
        return found;
      }
    }

    capability RemoveFromCart {
      actor Ref<User>;
      input RemoveFromCartInput;
      output Unit;
      fails CartItemNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/cart/{id}/remove";
      workflow {
        load CartItem by input.id as found else CartItemNotFound;
        validate found.owner == actor else CartItemNotFound;
        delete found;
        return unit;
      }
    }

    capability MyCart {
      actor Ref<User>;
      input MyCartInput;
      output Page<CartItemView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/cart";
      workflow {
        find CartItem where item.owner == actor order by id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }

    capability ClearCart {
      actor Ref<User>;
      input ClearCartInput;
      output Unit;
      requires authenticated;
      requires atomic;
      expose command at "/cart/clear";
      workflow {
        each CartItem where item.owner == actor order by id ascending limit 100 as row {
          delete row;
        }
        return unit;
      }
    }

    capability Checkout {
      actor Ref<User>;
      input CheckoutInput;
      output OrderView;
      fails CartEmpty;
      fails CartTooLarge;
      fails OutOfStock;
      requires authenticated;
      requires atomic;
      expose command at "/cart/checkout";
      workflow {
        count CartItem where item.owner == actor as size;
        validate size > 0 else CartEmpty;
        validate size <= 50 else CartTooLarge;
        create PurchaseOrder as made { buyer: actor; state: OrderState.CREATED; total: 0.00; createdAt: now(); }
        persist made;
        each CartItem where item.owner == actor order by id ascending limit 50 as row {
          load ShopProduct by row.product as goods else OutOfStock;
          update goods when goods.stock >= row.quantity else OutOfStock { stock: goods.stock - row.quantity; }
          persist goods;
          create OrderLine as line { purchase: made; product: goods; quantity: row.quantity; unitPrice: goods.price; }
          persist line;
          update made { total: made.total + goods.price * row.quantity; }
          delete row;
        }
        persist made;
        return made;
      }
    }

    capability AddCoupon {
      actor Ref<User>;
      input AddCouponInput;
      output CouponView;
      fails CouponCodeTaken;
      fails Forbidden;
      fails InvalidWindow;
      requires authenticated;
      requires atomic;
      expose command at "/coupons";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        validate input.startsAt < input.endsAt else InvalidWindow;
        exists Coupon where item.code == input.code as present;
        validate not present else CouponCodeTaken;
        create Coupon as made { code: input.code; amountOff: input.amountOff; minSpend: input.minSpend; startsAt: input.startsAt; endsAt: input.endsAt; totalLimit: input.totalLimit; used: 0; }
        persist made;
        return made;
      }
    }

    capability ApplyCoupon {
      actor Ref<User>;
      input ApplyCouponInput;
      output OrderView;
      fails CouponAlreadyUsed;
      fails CouponExhausted;
      fails CouponExpired;
      fails CouponNotFound;
      fails MinSpendNotMet;
      fails NotYourOrder;
      fails OrderNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/orders/{orderId}/coupon";
      workflow {
        load PurchaseOrder by input.orderId as made else OrderNotFound;
        validate made.buyer == actor else NotYourOrder;
        load Coupon by code: input.code as found else CouponNotFound;
        validate found.startsAt <= now() else CouponExpired;
        validate found.endsAt > now() else CouponExpired;
        validate made.total >= found.minSpend else MinSpendNotMet;
        validate made.total >= found.amountOff else MinSpendNotMet;
        exists Redemption where item.purchase == made and item.buyer == actor as used;
        validate not used else CouponAlreadyUsed;
        update found when found.used < found.totalLimit else CouponExhausted { used: found.used + 1; }
        persist found;
        create Redemption as red { coupon: found; buyer: actor; purchase: made; amountOff: found.amountOff; }
        persist red;
        update made { total: made.total - found.amountOff; }
        persist made;
        return made;
      }
    }

    capability Pay {
      actor Ref<User>;
      input PayInput;
      output OrderView;
      fails NotPayable;
      fails NotYourOrder;
      fails OrderNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/orders/{id}/pay";
      workflow {
        load PurchaseOrder by input.id as made else OrderNotFound;
        validate made.buyer == actor else NotYourOrder;
        update made when made.state == OrderState.CREATED else NotPayable { state: OrderState.PAID; }
        persist made;
        return made;
      }
    }

    capability Ship {
      actor Ref<User>;
      input ShipInput;
      output OrderView;
      fails Forbidden;
      fails NotShippable;
      fails OrderNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/orders/{id}/ship";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load PurchaseOrder by input.id as made else OrderNotFound;
        update made when made.state == OrderState.PAID else NotShippable { state: OrderState.SHIPPED; }
        persist made;
        return made;
      }
    }

    capability CancelOrder {
      actor Ref<User>;
      input CancelOrderInput;
      output OrderView;
      fails InconsistentOrder;
      fails NotCancellable;
      fails NotYourOrder;
      fails OrderNotFound;
      fails OrderTooLarge;
      fails StockLimit;
      requires authenticated;
      requires atomic;
      expose command at "/orders/{id}/cancel";
      workflow {
        load PurchaseOrder by input.id as made for update else OrderNotFound;
        validate made.buyer == actor else NotYourOrder;
        validate made.state == OrderState.CREATED else NotCancellable;
        count OrderLine where item.purchase == made as size;
        validate size > 0 else InconsistentOrder;
        validate size <= 100 else OrderTooLarge;
        update made when made.state == OrderState.CREATED else NotCancellable { state: OrderState.CANCELLED; }
        persist made;
        each OrderLine where item.purchase == made order by product ascending, id ascending limit 100 as line {
          validate line.quantity > 0 else InconsistentOrder;
          load ShopProduct by line.product as goods else InconsistentOrder;
          update goods when goods.stock <= 2147483647 - line.quantity else StockLimit { stock: goods.stock + line.quantity; }
          persist goods;
        }
        exists Redemption where item.purchase == made as redeemed;
        validate true else NotCancellable;
        return made;
      }
    }

    capability MyOrders {
      actor Ref<User>;
      input MyOrdersInput;
      output Page<OrderView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/orders";
      workflow {
        find PurchaseOrder where item.buyer == actor order by createdAt descending, id descending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }

    capability OrderLines {
      actor Ref<User>;
      input OrderLinesInput;
      output Page<OrderLinePageView>;
      fails BadPage;
      fails NotYourOrder;
      fails OrderNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/orders/{orderId}/lines";
      workflow {
        load PurchaseOrder by input.orderId as made else OrderNotFound;
        validate made.buyer == actor else NotYourOrder;
        find OrderLine where item.purchase == made order by id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }

    capability Multiply {
      input MultiplyInput;
      output CalculationView;
      requires atomic;
      expose command at "/multiply";
      workflow {
        create Calculation as made { amount: input.price * input.quantity; count: input.left * input.right; wide: input.wide * 2; }
        persist made;
        return made;
      }
    }

    capability Wide {
      input MultiplyInput;
      output CalculationView;
      requires atomic;
      expose command at "/wide";
      workflow {
        create Calculation as made { amount: input.price * input.quantity; count: input.left * input.right; wide: input.wide * 2; }
        persist made;
        return made;
      }
    }

    capability Reverse {
      input MultiplyInput;
      output CalculationView;
      requires atomic;
      expose command at "/reverse";
      workflow {
        create Calculation as made { amount: input.price * input.quantity; count: input.left * input.right; wide: input.wide * 2; }
        persist made;
        return made;
      }
    }

    capability PurchaseProduct {
      input PurchaseProductInput;
      output ReceiptView;
      fails OutOfStock;
      fails ProductNotFound;
      requires atomic;
      expose command at "/purchase";
      workflow {
        load Product by input.id as goods else ProductNotFound;
        update goods when goods.stock >= input.quantity else OutOfStock { stock: goods.stock - input.quantity; }
        persist goods;
        create Receipt as made { product: goods; total: goods.price * input.quantity; quantity: input.quantity; }
        persist made;
        create ReceiptLine as line { receipt: made; quantity: input.quantity; unitPrice: goods.price; }
        persist line;
        return made;
      }
    }

    capability EnrollCourse {
      input EnrollCourseInput;
      output CourseView;
      fails Full;
      fails Missing;
      requires atomic;
      expose command at "/courses/enroll";
      workflow {
        load Course by input.id as course else Missing;
        update course when course.enrolled < course.capacity else Full { enrolled: course.enrolled + 1; }
        persist course;
        return course;
      }
    }

    capability ShowCourse {
      input ShowCourseInput;
      output CourseView;
      fails Missing;
      requires readonly;
      expose query at "/courses/show";
      workflow {
        load Course by input.id as course else Missing;
        return course;
      }
    }

    capability Book {
      input BookInput;
      output BookingView;
      fails InvalidWindow;
      fails RoomMissing;
      fails SlotTaken;
      requires atomic;
      expose command at "/bookings";
      workflow {
        validate input.startsAt < input.endsAt else InvalidWindow;
        load Room by input.roomId as room for update else RoomMissing;
        exists Booking where item.room == room and item.startsAt < input.endsAt and item.endsAt > input.startsAt as taken;
        validate not taken else SlotTaken;
        create Booking as made { room: room; startsAt: input.startsAt; endsAt: input.endsAt; }
        persist made;
        return made;
      }
    }

    capability BookAfterRead {
      input BookInput;
      output BookingView;
      fails InvalidWindow;
      fails RoomMissing;
      fails SlotTaken;
      requires atomic;
      expose command at "/bookings/after-read";
      workflow {
        validate input.startsAt < input.endsAt else InvalidWindow;
        load Room by input.roomId as room else RoomMissing;
        exists Booking where item.room == room and item.startsAt < input.endsAt and item.endsAt > input.startsAt as taken;
        validate not taken else SlotTaken;
        load Room by input.roomId as locked for update else RoomMissing;
        exists Booking where item.room == locked and item.startsAt < input.endsAt and item.endsAt > input.startsAt as takenNow;
        validate not takenNow else SlotTaken;
        create Booking as made { room: locked; startsAt: input.startsAt; endsAt: input.endsAt; }
        persist made;
        return made;
      }
    }

    capability BookWeekly {
      input BookWeeklyInput;
      output Unit;
      fails InvalidWindow;
      fails RoomMissing;
      fails SlotTaken;
      fails TooManyWeeks;
      requires atomic;
      expose command at "/bookings/weekly";
      workflow {
        validate input.startsAt < input.endsAt else InvalidWindow;
        validate input.weeks >= 1 else TooManyWeeks;
        validate input.weeks <= 12 else TooManyWeeks;
        load Room by input.roomId as room for update else RoomMissing;
        repeat input.weeks times limit 12 else TooManyWeeks as week {
          exists Booking where item.room == room and item.startsAt < addDays(input.endsAt, week * 7) and item.endsAt > addDays(input.startsAt, week * 7) as taken;
          validate not taken else SlotTaken;
          create Booking as made { room: room; startsAt: addDays(input.startsAt, week * 7); endsAt: addDays(input.endsAt, week * 7); }
          persist made;
        }
        return unit;
      }
    }
  }
}
