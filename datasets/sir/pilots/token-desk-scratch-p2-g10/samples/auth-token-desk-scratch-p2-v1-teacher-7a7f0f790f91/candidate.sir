sir 0.3
software TokenDesk {
  metadata { displayName "TokenDesk"; namespace "com.example.tokendesk"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    entity Account persistent {
      identity id: Id generated auto;
      field name: Name where length(1, 64) unique;
      field passwordHash: Secret;
    }

    entity Credential persistent {
      identity id: Token generated uuid;
      field owner: Ref<Account>;
      field used: Flag default false;
      field expiresAt: Moment;
    }

    input GetCredentialInput {
      field id: Token;
    }

    input CredentialWriteInput {
      field token: Token;
    }

    input RegisterInput {
      field name: Name where length(1, 64);
      field password: Secret;
    }

    input LoginInput {
      field name: Name where length(1, 64);
      field password: Secret;
    }

    input FindAccountInput {
      field name: Name where length(1, 64);
    }

    view AccountView from Account {
      field id: Id;
      field name: Name;
    }

    view CredentialView from Credential {
      field id: Token;
      field owner: Ref<Account>;
      field expiresAt: Moment;
    }

    error AccountNotFound http 404;
    error BadLogin http 401;
    error CredentialNotFound http 404;
    error Expired http 400;
    error Invalid http 409;

    capability GetCredential {
      input GetCredentialInput;
      output CredentialView;
      fails CredentialNotFound;
      requires readonly;
      expose query at "/get-credential";
      workflow {
        load Credential by input.id as found else CredentialNotFound;
        return found;
      }
    }

    capability Refresh {
      input CredentialWriteInput;
      output CredentialView;
      fails Expired;
      fails Invalid;
      requires atomic;
      expose command at "/refresh";
      workflow {
        load Credential by input.token as old else Invalid;
        validate not (old.used == true) else Invalid;
        validate not (old.expiresAt <= now()) else Expired;
        update old { used: true; }
        persist old;
        create Credential as made {
          owner: old.owner;
          used: false;
          expiresAt: now() + 7 days;
        }
        persist made;
        return made;
      }
    }

    capability Touch {
      input CredentialWriteInput;
      output CredentialView;
      fails Invalid;
      requires atomic;
      expose command at "/touch";
      workflow {
        load Credential by input.token as found else Invalid;
        validate found.owner == actor else Invalid;
        update found { used: true; }
        persist found;
        return found;
      }
    }

    capability Register {
      input RegisterInput;
      output AccountView;
      fails AccountNotFound;
      requires atomic;
      expose command at "/register";
      workflow {
        exists Account where item.name == input.name as taken;
        validate not taken else AccountNotFound;
        create Account as made {
          name: input.name;
          passwordHash: input.password;
        }
        persist made else AccountNotFound;
        return made;
      }
    }

    capability Login {
      input LoginInput;
      output AccountView;
      fails BadLogin;
      requires readonly;
      expose command at "/login";
      workflow {
        load Account by name: input.name as account else BadLogin;
        validate account.passwordHash matches input.password else BadLogin;
        return account;
      }
    }

    capability FindAccount {
      input FindAccountInput;
      output AccountView;
      fails AccountNotFound;
      requires readonly;
      expose query at "/find-account";
      workflow {
        load Account by name: input.name as account else AccountNotFound;
        return account;
      }
    }
  }
}
