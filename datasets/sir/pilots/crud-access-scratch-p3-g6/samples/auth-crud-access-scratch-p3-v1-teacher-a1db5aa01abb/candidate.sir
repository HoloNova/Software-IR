sir 0.3
software CrudAccess {
  metadata { displayName "CrudAccess"; namespace "example.crudaccess"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    enum Role { READER, ADMIN }
    enum PostState { open, hidden }

    entity User persistent {
      identity id: Id generated auto;
      field role: Role default Role.READER;
    }

    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }

    entity Book persistent {
      identity id: Id generated auto;
      field title: Name where length(1, 64);
      field stock: Count default 5;
    }

    entity Post persistent {
      identity id: Id generated auto;
      field author: Ref<User>;
      field body: Text where length(1, 255);
      field state: PostState default PostState.open;
      field version: Version;
    }

    input CreateBookInput {
      field title: Name where length(1, 64);
    }

    input UpdateBookInput {
      field id: Id;
      field title: Name where length(1, 64);
    }

    input GetBookInput {
      field id: Id;
    }

    input ListBookInput {
      field page: PageNo;
      field size: PageSize;
    }

    input DeleteBookInput {
      field id: Id;
    }

    input CreatePostInput {
      field body: Text where length(1, 255);
    }

    input UpdatePostInput patch of Post {
      field id: Id;
      field body: Text;
    }

    input GetPostInput {
      field id: Id;
    }

    input ListPostInput {
      field page: PageNo;
      field size: PageSize;
    }

    input DeletePostInput {
      field id: Id;
    }

    view BookView from Book {
      field id: Id;
      field title: Name;
      field stock: Count;
    }

    view PostView from Post {
      field id: Id;
      field author: Ref<User>;
      field body: Text;
      field state: PostState;
      field version: Version;
    }

    error BookNotFound http 404;
    error PostNotFound http 404;
    error Forbidden http 403;
    error StalePost http 409;
    error InvalidRequest http 400;

    capability CreateBook {
      actor Ref<User>;
      input CreateBookInput;
      output BookView;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command at "/library/books";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        create Book as book {
          title: input.title;
        }
        persist book;
        return book;
      }
    }

    capability GetBook {
      input GetBookInput;
      output BookView;
      fails BookNotFound;
      requires readonly;
      expose query at "/library/books/{id}";
      workflow {
        load Book by input.id as book else BookNotFound;
        return book;
      }
    }

    capability ListBook {
      input ListBookInput;
      output Page<BookView>;
      requires readonly;
      expose query at "/library/books";
      workflow {
        find Book where true order by id ascending Page input.page, input.size as books;
        return books;
      }
    }

    capability UpdateBook {
      actor Ref<User>;
      input UpdateBookInput;
      output BookView;
      fails BookNotFound;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command put at "/library/books/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Book by input.id as book else BookNotFound;
        update book {
          title: input.title;
        }
        persist book;
        return book;
      }
    }

    capability DeleteBook {
      actor Ref<User>;
      input DeleteBookInput;
      output Unit;
      fails BookNotFound;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command delete at "/library/books/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Book by input.id as book else BookNotFound;
        delete book;
        return unit;
      }
    }

    capability CreatePost {
      actor Ref<User>;
      input CreatePostInput;
      output PostView;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command at "/public/posts";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        create Post as post {
          author: actor;
          body: input.body;
          state: PostState.open;
          version: 1;
        }
        persist post;
        return post;
      }
    }

    capability GetPost {
      input GetPostInput;
      output PostView;
      fails PostNotFound;
      requires readonly;
      expose query at "/public/posts/{id}";
      workflow {
        load Post by input.id as post else PostNotFound;
        validate post.state == PostState.open else PostNotFound;
        return post;
      }
    }

    capability ListPost {
      input ListPostInput;
      output Page<PostView>;
      requires readonly;
      expose query at "/public/posts";
      workflow {
        find Post where item.state == PostState.open order by id ascending Page input.page, input.size as posts;
        return posts;
      }
    }

    capability UpdatePost {
      actor Ref<User>;
      input UpdatePostInput;
      output PostView;
      fails PostNotFound;
      fails StalePost;
      requires authenticated;
      requires atomic;
      expose command at "/public/posts/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Post by input.id as post else PostNotFound;
        validate post.author == actor else PostNotFound;
        validate input.body.present else InvalidRequest;
        update post {
          body: input.body;
        }
        persist post else StalePost;
        return post;
      }
    }

    capability DeletePost {
      actor Ref<User>;
      input DeletePostInput;
      output Unit;
      fails PostNotFound;
      requires authenticated;
      requires atomic;
      expose command delete at "/public/posts/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Post by input.id as post else PostNotFound;
        validate post.author == actor else PostNotFound;
        delete post;
        return unit;
      }
    }
  }
}
