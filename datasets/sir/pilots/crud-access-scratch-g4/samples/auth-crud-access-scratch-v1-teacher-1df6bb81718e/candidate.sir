sir 0.3
software LibraryPosts {
  metadata { displayName "LibraryPosts"; namespace "example.crudaccess"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    enum Role { READER, ADMIN }

    entity User persistent {
      identity id: Id generated auto;
      field role: Role default Role.READER;
    }

    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }

    entity Book persistent {
      identity id: Id generated auto;
      field title: Name where length(1, 64);
      field stock: Count default 5;
    }

    entity Post persistent {
      identity id: Id generated auto;
      field author: Ref<User>;
      field body: Text where length(1, 255);
      field state: Code default "open";
      field version: Version default 1;
    }

    view BookView from Book {
      field id: Id;
      field title: Name;
      field stock: Count;
    }

    view PostView from Post {
      field id: Id;
      field author: Ref<User>;
      field body: Text;
      field state: Code;
      field version: Version;
    }

    input CreateBookInput {
      field title: Name where length(1, 64);
    }

    input UpdateBookInput {
      field id: Id;
      field title: Name where length(1, 64);
    }

    input GetBookInput {
      field id: Id;
    }

    input DeleteBookInput {
      field id: Id;
    }

    input ListBookInput {
      field page: PageNo;
      field size: PageSize;
    }

    input CreatePostInput {
      field body: Text where length(1, 255);
    }

    input UpdatePostInput patch of Post {
      field id: Id;
      field body: Text;
    }

    input GetPostInput {
      field id: Id;
    }

    input DeletePostInput {
      field id: Id;
    }

    input ListPostInput {
      field page: PageNo;
      field size: PageSize;
    }

    error Forbidden http 403;
    error BookNotFound http 404;
    error PostNotFound http 404;
    error StalePost http 409;

    capability CreateBook {
      actor Ref<User>;
      input CreateBookInput;
      output BookView;
      fails Forbidden;
      requires authenticated;
      expose command post at "/library/books";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        create Book as book { title: input.title; stock: 5; }
        persist book;
        return book;
      }
    }

    capability GetBook {
      input GetBookInput;
      output BookView;
      fails BookNotFound;
      expose query at "/library/books/{id}";
      workflow {
        load Book by input.id as book else BookNotFound;
        return book;
      }
    }

    capability ListBook {
      input ListBookInput;
      output Page<BookView>;
      expose query at "/library/books";
      workflow {
        find Book where true order by id ascending Page input.page, input.size as books;
        return books;
      }
    }

    capability UpdateBook {
      actor Ref<User>;
      input UpdateBookInput;
      output BookView;
      fails Forbidden;
      fails BookNotFound;
      requires authenticated;
      requires atomic;
      expose command put at "/library/books/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Book by input.id as book else BookNotFound;
        update book { title: input.title; }
        persist book;
        return book;
      }
    }

    capability DeleteBook {
      actor Ref<User>;
      input DeleteBookInput;
      output Unit;
      fails Forbidden;
      fails BookNotFound;
      requires authenticated;
      requires atomic;
      expose command delete at "/library/books/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Book by input.id as book else BookNotFound;
        delete book;
        return unit;
      }
    }

    capability CreatePost {
      actor Ref<User>;
      input CreatePostInput;
      output PostView;
      fails Forbidden;
      requires authenticated;
      expose command post at "/public/posts";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        create Post as post { author: actor; body: input.body; state: "open"; version: 1; }
        persist post;
        return post;
      }
    }

    capability GetPost {
      input GetPostInput;
      output PostView;
      fails PostNotFound;
      expose query at "/public/posts/{id}";
      workflow {
        load Post by input.id as post else PostNotFound;
        return post;
      }
    }

    capability ListPost {
      input ListPostInput;
      output Page<PostView>;
      expose query at "/public/posts";
      workflow {
        find Post where item.state != "hidden" order by id ascending Page input.page, input.size as posts;
        return posts;
      }
    }

    capability UpdatePost {
      actor Ref<User>;
      input UpdatePostInput;
      output PostView;
      fails Forbidden;
      fails PostNotFound;
      fails StalePost;
      requires authenticated;
      requires atomic;
      expose command patch at "/public/posts/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Post by input.id as post else PostNotFound;
        validate post.author == actor else PostNotFound;
        validate input.body.present else StalePost;
        update post { body: input.body; version: post.version + 1; }
        persist post else StalePost;
        return post;
      }
    }

    capability DeletePost {
      actor Ref<User>;
      input DeletePostInput;
      output Unit;
      fails Forbidden;
      fails PostNotFound;
      requires authenticated;
      requires atomic;
      expose command delete at "/public/posts/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Post by input.id as post else PostNotFound;
        validate post.author == actor else PostNotFound;
        delete post;
        return unit;
      }
    }
  }
}
