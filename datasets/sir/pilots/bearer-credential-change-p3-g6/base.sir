sir 0.3

software NoteDesk {
  metadata {
    displayName "Note Desk";
    namespace "example.notes";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Id generated auto;
      field name: Text unique;
      field passwordHash: Secret;
    }
    entity Note persistent {
      identity id: Id generated auto;
      field author: Ref<User>;
      field text: Text;
    }
    view UserView from User {
      field id: Id;
      field name: Text;
    }
    view NoteView from Note {
      field id: Id;
      field text: Text;
    }
    input LoginInput {
      field name: Text;
      field password: Text;
    }
    input UserRef {
      field id: Id;
    }
    input NoteInput {
      field text: Text where notBlank;
    }
    error UserNotFound http 404;
    capability GetUser {
      input UserRef;
      output UserView;
      fails UserNotFound;
      requires readonly;
      expose query;
      workflow {
        load User by input.id as user else UserNotFound;
        return user;
      }
    }
    capability Register {
      input LoginInput;
      output UserView;
      requires atomic;
      expose command;
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user;
        return user;
      }
    }
    capability PostNote {
      actor Ref<User>;
      input NoteInput;
      output NoteView;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        create Note as note {
          author: actor;
          text: input.text;
        }
        persist note;
        return note;
      }
    }
  }
}
