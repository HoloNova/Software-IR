sir 0.3
software CourseSelection {
  metadata { displayName "CourseSelection"; namespace "example.course"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    enum Role { STUDENT, TEACHER, ADMIN }

    entity User persistent {
      identity id: Id generated auto;
      field name: Name unique;
      field passwordHash: Secret;
      field role: Role default Role.STUDENT;
    }

    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }

    entity RefreshToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field used: Flag default false;
      field expiresAt: Moment;
    }

    entity TokenPair persistent {
      identity id: Id generated auto;
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }

    entity Course persistent {
      identity id: Id generated auto;
      field code: Code unique;
      field name: Name;
      field teacher: Ref<User>;
      field capacity: Quantity;
      field enrolled: Count default 0;
      field weekday: Count;
      field startPeriod: Count;
      field endPeriod: Count;
      field published: Flag default false;
    }

    entity Enrollment persistent {
      identity id: Id generated auto;
      field student: Ref<User>;
      field course: Ref<Course>;
      field createdAt: Moment;
      unique (student, course);
    }

    entity Prerequisite persistent {
      identity id: Id generated auto;
      field targetCourse: Ref<Course>;
      field required: Ref<Course>;
      unique (targetCourse, required);
    }

    entity CompletedCourse persistent {
      identity id: Id generated auto;
      field student: Ref<User>;
      field course: Ref<Course>;
      field completedAt: Moment;
      unique (student, course);
    }

    input RegisterInput {
      field name: Name where length(1, 64);
      field password: Text where notBlank;
    }

    input LoginInput {
      field name: Name;
      field password: Text where notBlank;
    }

    input RefreshInput {
      field refreshToken: Token;
    }

    input LogoutInput {
      field refreshToken: Token;
    }

    input SearchCoursesInput {
      field keyword: Optional<Text>;
      field page: PageNo;
      field size: PageSize;
    }

    input CreateCourseInput {
      field code: Code where length(1, 32);
      field name: Name where length(1, 100);
      field teacherId: Id;
      field capacity: Quantity where min(1);
      field weekday: Count where min(1), max(7);
      field startPeriod: Count where min(1), max(12);
      field endPeriod: Count where min(1), max(13);
    }

    input AddPrerequisiteInput {
      field courseId: Id;
      field requiredId: Id;
    }

    input RemovePrerequisiteInput {
      field id: Id;
    }

    input PublishCourseInput {
      field id: Id;
    }

    input RecordCompletionInput {
      field studentId: Id;
      field courseId: Id;
    }

    input EnrollInput {
      field id: Id;
    }

    input DropInput {
      field id: Id;
    }

    input MyEnrollmentsInput {
      field page: PageNo;
      field size: PageSize;
    }

    input RosterInput {
      field courseId: Id;
      field page: PageNo;
      field size: PageSize;
    }

    view UserSummary from User {
      field id: Id;
      field name: Name;
      field role: Role;
    }

    view RegisterView from User {
      field id: Id;
      field name: Name;
      field role: Role;
    }

    view LoginView from TokenPair {
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }

    view CourseView from Course {
      field id: Id;
      field code: Code;
      field name: Name;
      field teacher: UserSummary;
      field capacity: Quantity;
      field enrolled: Count;
      field remaining: Count = item.capacity - item.enrolled;
      field full: Flag = item.enrolled >= item.capacity;
      field weekday: Count;
      field startPeriod: Count;
      field endPeriod: Count;
      field published: Flag;
    }

    view EnrollmentView from Enrollment {
      field id: Id;
      field course: CourseView;
      field createdAt: Moment;
    }

    error BadPage http 400;
    error InvalidRequest http 400;
    error InvalidSchedule http 400;
    error InvalidPrerequisite http 400;
    error Forbidden http 403;
    error CourseNotFound http 404;
    error TeacherNotFound http 404;
    error StudentNotFound http 404;
    error PrerequisiteNotFound http 404;
    error EnrollmentNotFound http 404;
    error AlreadyEnrolled http 409;
    error CourseFull http 409;
    error CourseNotOpen http 409;
    error CoursePublished http 409;
    error PrerequisiteExists http 409;
    error CompletionExists http 409;
    error MissingPrerequisites http 409;
    error TimeConflict http 409;
    error EnrollmentCounterMismatch http 409;

    capability Register {
      input RegisterInput;
      output RegisterView;
      expose command at "/register";
      workflow {
        validate input.name.present else InvalidRequest;
        create User as made { name: input.name; passwordHash: input.password; role: Role.STUDENT; }
        persist made;
        return made;
      }
    }

    capability Login {
      input LoginInput;
      output LoginView;
      expose command at "/login";
      workflow {
        load User by name: input.name as found else Forbidden;
        validate found.passwordHash matches input.password else Forbidden;
        create AccessToken as access { owner: found; expiresAt: now() + 15 minutes; }
        persist access;
        create RefreshToken as refresh { owner: found; used: false; expiresAt: now() + 7 days; }
        persist refresh;
        create TokenPair as pair { accessToken: access.id; accessExpiresAt: access.expiresAt; refreshToken: refresh.id; refreshExpiresAt: refresh.expiresAt; }
        persist pair;
        return pair;
      }
    }

    capability Refresh {
      input RefreshInput;
      output LoginView;
      expose command at "/refresh";
      workflow {
        load RefreshToken by input.refreshToken as old else Forbidden;
        validate old.expiresAt > now() else Forbidden;
        update old when old.used == false else Forbidden { used: true; }
        persist old;
        create AccessToken as access { owner: old.owner; expiresAt: now() + 15 minutes; }
        persist access;
        create RefreshToken as refresh { owner: old.owner; used: false; expiresAt: now() + 7 days; }
        persist refresh;
        create TokenPair as pair { accessToken: access.id; accessExpiresAt: access.expiresAt; refreshToken: refresh.id; refreshExpiresAt: refresh.expiresAt; }
        persist pair;
        return pair;
      }
    }

    capability Logout {
      input LogoutInput;
      output Unit;
      expose command at "/logout";
      workflow {
        load RefreshToken by input.refreshToken as old else Forbidden;
        update old when old.used == false else Forbidden { used: true; }
        persist old;
        return unit;
      }
    }

    capability SearchCourses {
      input SearchCoursesInput;
      output Page<CourseView>;
      fails BadPage;
      requires readonly;
      expose query at "/courses";
      workflow {
        find Course where item.published == true and (item.name containsLiteral input.keyword or item.code containsLiteral input.keyword) order by code ascending, id ascending Page input.page, input.size else BadPage as found;
        return found;
      }
    }

    capability CreateCourse {
      actor Ref<User>;
      input CreateCourseInput;
      output CourseView;
      fails Forbidden;
      fails InvalidSchedule;
      fails TeacherNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/courses";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        validate input.endPeriod > input.startPeriod else InvalidSchedule;
        load User by input.teacherId as teacher else TeacherNotFound;
        create Course as made { code: input.code; name: input.name; teacher: teacher; capacity: input.capacity; enrolled: 0; weekday: input.weekday; startPeriod: input.startPeriod; endPeriod: input.endPeriod; published: false; }
        persist made;
        return made;
      }
    }

    capability AddPrerequisite {
      actor Ref<User>;
      input AddPrerequisiteInput;
      output Unit;
      fails CourseNotFound;
      fails CoursePublished;
      fails Forbidden;
      fails InvalidPrerequisite;
      fails PrerequisiteExists;
      requires authenticated;
      requires atomic;
      expose command at "/courses/{courseId}/prerequisites";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Course by input.courseId as targetCourse else CourseNotFound;
        validate targetCourse.published == false else CoursePublished;
        load Course by input.requiredId as required else InvalidPrerequisite;
        validate required.published == true else InvalidPrerequisite;
        validate required.id != targetCourse.id else InvalidPrerequisite;
        exists Prerequisite where targetCourse == targetCourse and required == required as dup;
        validate not dup else PrerequisiteExists;
        create Prerequisite as made { targetCourse: targetCourse; required: required; }
        persist made;
        return unit;
      }
    }

    capability RemovePrerequisite {
      actor Ref<User>;
      input RemovePrerequisiteInput;
      output Unit;
      fails CoursePublished;
      fails Forbidden;
      fails PrerequisiteNotFound;
      requires authenticated;
      requires atomic;
      expose command delete at "/prerequisites/{id}";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Prerequisite by input.id as found else PrerequisiteNotFound;
        load Course by found.targetCourse.id as targetCourse else PrerequisiteNotFound;
        validate targetCourse.published == false else CoursePublished;
        delete found;
        return unit;
      }
    }

    capability PublishCourse {
      actor Ref<User>;
      input PublishCourseInput;
      output CourseView;
      fails CourseNotFound;
      fails CoursePublished;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command at "/courses/{id}/publish";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load Course by input.id as targetCourse else CourseNotFound;
        validate targetCourse.published == false else CoursePublished;
        update targetCourse { published: true; }
        persist targetCourse;
        return targetCourse;
      }
    }

    capability RecordCompletion {
      actor Ref<User>;
      input RecordCompletionInput;
      output Unit;
      fails CompletionExists;
      fails CourseNotFound;
      fails Forbidden;
      fails StudentNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/completions";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        load User by input.studentId as student else StudentNotFound;
        load Course by input.courseId as course else CourseNotFound;
        exists CompletedCourse where student == student and course == course as dup;
        validate not dup else CompletionExists;
        create CompletedCourse as made { student: student; course: course; completedAt: now(); }
        persist made;
        return unit;
      }
    }

    capability Enroll {
      actor Ref<User>;
      input EnrollInput;
      output EnrollmentView;
      fails AlreadyEnrolled;
      fails CourseFull;
      fails CourseNotFound;
      fails CourseNotOpen;
      fails EnrollmentCounterMismatch;
      fails Forbidden;
      fails MissingPrerequisites;
      fails TimeConflict;
      requires authenticated;
      requires atomic;
      expose command at "/courses/{id}/enroll";
      workflow {
        validate actor.role == Role.STUDENT else Forbidden;
        load User by actor.id as student for update else Forbidden;
        load Course by input.id as course else CourseNotFound;
        validate course.published == true else CourseNotOpen;
        exists Enrollment where student == student and course == course as dup;
        validate not dup else AlreadyEnrolled;
        count Prerequisite where targetCourse == course as requiredCount;
        count CompletedCourse where student == student and any(Prerequisite, targetCourse == course and required == item.course) as passedCount;
        validate passedCount == requiredCount else MissingPrerequisites;
        exists Enrollment where student == student and any(Course, id == item.course and weekday == course.weekday and startPeriod < course.endPeriod and endPeriod > course.startPeriod) as clash;
        validate not clash else TimeConflict;
        validate course.enrolled == course.enrolled else EnrollmentCounterMismatch;
        update course when course.enrolled < course.capacity else CourseFull { enrolled: course.enrolled + 1; }
        persist course;
        create Enrollment as made { student: student; course: course; createdAt: now(); }
        persist made;
        return made;
      }
    }

    capability Drop {
      actor Ref<User>;
      input DropInput;
      output Unit;
      fails EnrollmentCounterMismatch;
      fails EnrollmentNotFound;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command delete at "/enrollments/{id}";
      workflow {
        load Enrollment by input.id as found else EnrollmentNotFound;
        validate found.student == actor else Forbidden;
        load Course by found.course.id as course for update else EnrollmentNotFound;
        validate course.enrolled > 0 else EnrollmentCounterMismatch;
        update course { enrolled: course.enrolled - 1; }
        persist course;
        delete found;
        return unit;
      }
    }

    capability MyEnrollments {
      actor Ref<User>;
      input MyEnrollmentsInput;
      output Page<EnrollmentView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/enrollments";
      workflow {
        find Enrollment where item.student == actor order by createdAt descending, id descending Page input.page, input.size else BadPage as found;
        return found;
      }
    }

    capability Roster {
      actor Ref<User>;
      input RosterInput;
      output Page<EnrollmentView>;
      fails BadPage;
      fails CourseNotFound;
      fails Forbidden;
      requires authenticated;
      requires readonly;
      expose query at "/courses/{courseId}/roster";
      workflow {
        load Course by input.courseId as course else CourseNotFound;
        validate course.teacher == actor else Forbidden;
        find Enrollment where item.course == course order by createdAt ascending, id ascending Page input.page, input.size else BadPage as found;
        return found;
      }
    }
  }
}
