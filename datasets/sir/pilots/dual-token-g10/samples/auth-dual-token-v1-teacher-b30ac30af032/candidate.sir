sir 0.3
software DualTokenDesk {
  metadata {
    displayName "Dual Token Desk";
    namespace "example.dualtoken";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Id generated auto;
      field name: Name unique;
      field passwordHash: Secret;
    }
    entity Note persistent {
      identity id: Id generated auto;
      field author: Ref<User>;
      field text: Text;
    }
    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }
    entity RefreshToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      field revoked: Flag default false;
    }
    entity TokenPair persistent {
      identity id: Id generated auto;
      field owner: Ref<User>;
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }
    view NoteView from Note {
      field id: Id;
      field text: Text;
    }
    input NoteInput {
      field text: Text where notBlank;
    }
    view UserView from User {
      field id: Id;
      field name: Text;
    }
    input UserRef {
      field id: Id;
    }
    view TokenPairView from TokenPair {
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }
    input LoginInput {
      field name: Text where notBlank;
      field password: Text where notBlank;
    }
    input RefreshInput {
      field refreshToken: Token;
    }
    input LogoutInput {
      field refreshToken: Token;
    }
    error UserNotFound http 404;
    error BadLogin http 401;
    error InvalidRefresh http 401;
    capability GetUser {
      input UserRef;
      output UserView;
      fails UserNotFound;
      requires readonly;
      expose query;
      workflow {
        load User by input.id as user else UserNotFound;
        return user;
      }
    }
    capability Register {
      input RegisterInput;
      output UserView;
      requires atomic;
      expose command;
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user;
        return user;
      }
    }
    capability PostNote {
      actor Ref<User>;
      input NoteInput;
      output NoteView;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        create Note as note {
          author: actor;
          text: input.text;
        }
        persist note;
        return note;
      }
    }
    capability Login {
      input LoginInput;
      output TokenPairView;
      fails BadLogin;
      requires atomic;
      expose command;
      workflow {
        load User by name: input.name as account else BadLogin;
        validate account.passwordHash matches input.password else BadLogin;
        create AccessToken as access {
          owner: account;
          expiresAt: now() + 15 minutes;
        }
        create RefreshToken as refresh {
          owner: account;
          expiresAt: now() + 7 days;
        }
        persist access;
        persist refresh;
        create TokenPair as pair {
          owner: account;
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: refresh.id;
          refreshExpiresAt: refresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }
    capability Refresh {
      input RefreshInput;
      output TokenPairView;
      fails InvalidRefresh;
      requires atomic;
      expose command;
      workflow {
        load RefreshToken by input.refreshToken as current else InvalidRefresh;
        update current when current.revoked == false and current.expiresAt > now() else InvalidRefresh {
          revoked: true;
        }
        persist current;
        create AccessToken as access {
          owner: current.owner;
          expiresAt: now() + 15 minutes;
        }
        create RefreshToken as refresh {
          owner: current.owner;
          expiresAt: now() + 7 days;
        }
        persist access;
        persist refresh;
        create TokenPair as pair {
          owner: current.owner;
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: refresh.id;
          refreshExpiresAt: refresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }
    capability Logout {
      input LogoutInput;
      output Unit;
      fails InvalidRefresh;
      requires atomic;
      expose command;
      workflow {
        load RefreshToken by input.refreshToken as current else InvalidRefresh;
        update current when current.revoked == false else InvalidRefresh {
          revoked: true;
        }
        persist current;
        return unit;
      }
    }
  }
}
