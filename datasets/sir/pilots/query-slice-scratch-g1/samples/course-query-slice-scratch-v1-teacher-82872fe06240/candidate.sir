sir 0.3
software CourseCatalog {
  metadata { displayName "CourseCatalog"; namespace "com.example.coursecatalog"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    entity Course persistent {
      identity id: Id generated auto;
      field code: Code;
      field name: Name;
      field description: Optional<Text> where length(0, 500);
      field capacity: Quantity;
    }

    input SearchCoursesInput {
      field keyword: Text;
      field page: PageNo default 1;
      field size: PageSize default 20;
    }

    view CourseSummary from Course {
      field code: Code;
      field name: Name;
      field capacity: Quantity;
    }

    error InvalidPageParam http 400;

    capability SearchCourses {
      input SearchCoursesInput;
      output Page<CourseSummary>;
      fails InvalidPageParam;
      requires readonly;
      expose query at "/api/search-courses";
      workflow {
        validate input.keyword is present else InvalidPageParam;
        validate input.keyword != "" else InvalidPageParam;
        validate input.page >= 1 else InvalidPageParam;
        validate input.page <= 10000 else InvalidPageParam;
        validate input.size >= 1 else InvalidPageParam;
        validate input.size <= 100 else InvalidPageParam;
        find Course where item.name containsLiteral input.keyword order by code ascending, id ascending Page input.page, input.size else InvalidPageParam as results;
        return results;
      }
    }
  }
}
