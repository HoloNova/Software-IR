sir 0.3
software EventsRegistration {
  metadata { displayName "EventsRegistration"; namespace "example.events"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources { }
  imports { }
  declarations {
    type EventFee = Money where precision(10, 2), min(0);

    entity User persistent {
      identity id: Id generated auto;
      field name: Name where length(1, 100) unique;
    }

    entity AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<User>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }

    entity Event persistent {
      identity id: Id generated auto;
      field organizer: Ref<User>;
      field title: Name where length(1, 100);
      field startsAt: Moment;
      field capacity: Quantity;
      field registered: Count default 0;
      field fee: EventFee;
    }

    entity Registration persistent {
      identity id: Id generated auto;
      field event: Ref<Event>;
      field attendee: Ref<User>;
      field fee: EventFee;
      field registeredAt: Moment;
      unique (event, attendee);
    }

    view EventView from Event {
      field id: Id;
      field organizer: Ref<User>;
      field title: Name;
      field startsAt: Moment;
      field capacity: Quantity;
      field registered: Count;
      field remaining: Count = item.capacity - item.registered;
      field fee: EventFee;
    }

    view RegistrationView from Registration {
      field id: Id;
      field event: Ref<Event>;
      field attendee: Ref<User>;
      field fee: EventFee;
      field registeredAt: Moment;
    }

    input CreateEventInput {
      field title: Name where length(1, 100);
      field startsAt: Moment;
      field capacity: Quantity;
      field fee: EventFee;
    }

    input ListEventsInput {
      field page: PageNo;
      field size: PageSize;
    }

    input RegisterInput {
      field id: Id;
    }

    input MyRegistrationsInput {
      field page: PageNo;
      field size: PageSize;
    }

    input EventRevenueInput {
      field id: Id;
    }

    input EventRegistrationCountInput {
      field id: Id;
    }

    error BadPage http 400;
    error EventNotFound http 404;
    error Forbidden http 403;
    error RegistrationClosed http 409;
    error AlreadyRegistered http 409;
    error EventFull http 409;

    capability CreateEvent {
      actor Ref<User>;
      input CreateEventInput;
      output EventView;
      requires authenticated;
      requires atomic;
      expose command at "/events";
      workflow {
        create Event as made {
          organizer: actor;
          title: input.title;
          startsAt: input.startsAt;
          capacity: input.capacity;
          fee: input.fee;
        }
        persist made;
        return made;
      }
    }

    capability ListEvents {
      input ListEventsInput;
      output Page<EventView>;
      fails BadPage;
      requires readonly;
      expose query at "/events";
      workflow {
        find Event where item.startsAt > now() order by startsAt ascending, id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }

    capability Register {
      actor Ref<User>;
      input RegisterInput;
      output RegistrationView;
      fails AlreadyRegistered;
      fails EventFull;
      fails EventNotFound;
      fails RegistrationClosed;
      requires authenticated;
      requires atomic;
      expose command at "/events/{id}/registrations";
      workflow {
        load Event by input.id as course for update else EventNotFound;
        validate course.startsAt > now() else RegistrationClosed;
        exists Registration where item.event == course and item.attendee == actor as found;
        validate not found else AlreadyRegistered;
        update course when course.registered < course.capacity else EventFull {
          registered: course.registered + 1;
        }
        persist course;
        create Registration as row {
          event: course;
          attendee: actor;
          fee: course.fee;
          registeredAt: now();
        }
        persist row else AlreadyRegistered;
        return row;
      }
    }

    capability MyRegistrations {
      actor Ref<User>;
      input MyRegistrationsInput;
      output Page<RegistrationView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/my/registrations";
      workflow {
        find Registration where item.attendee == actor order by registeredAt descending, id descending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }

    capability EventRevenue {
      actor Ref<User>;
      input EventRevenueInput;
      output Money;
      fails EventNotFound;
      fails Forbidden;
      requires authenticated;
      requires readonly;
      expose query at "/events/{id}/revenue";
      workflow {
        load Event by input.id as made else EventNotFound;
        validate made.organizer == actor else Forbidden;
        sum Registration.fee where item.event == made as total;
        return total;
      }
    }

    capability EventRegistrationCount {
      actor Ref<User>;
      input EventRegistrationCountInput;
      output Serial;
      fails EventNotFound;
      fails Forbidden;
      requires authenticated;
      requires readonly;
      expose query at "/events/{id}/registration-count";
      workflow {
        load Event by input.id as made else EventNotFound;
        validate made.organizer == actor else Forbidden;
        count Registration where item.event == made as total;
        return total;
      }
    }
  }
}
