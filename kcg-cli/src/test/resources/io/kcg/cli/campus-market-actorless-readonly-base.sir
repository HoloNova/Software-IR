sir 0.1

software CampusMarketActorless {
  metadata {
    displayName "校园二手交易只读示例";
    namespace "com.example.campusmarketactorless";
  }

  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }

  declarations {
    enum GoodsStatus {
      AVAILABLE,
      SOLD
    }

    entity Goods persistent {
      identity id: Int64 generated auto;
      field title: String where notBlank;
      field status: GoodsStatus;
    }

    capability ListAvailableGoods {
      output List<Ref<Goods>>;
      requires readonly;
      expose query;

      workflow {
        find Goods where item.status == GoodsStatus.AVAILABLE as goods;
        return goods;
      }
    }
  }
}
