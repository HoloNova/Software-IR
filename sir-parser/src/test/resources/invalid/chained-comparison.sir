sir 0.3

software BadComparison {
  metadata {
    displayName "Bad Comparison";
    namespace "example.badcomparison";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    input Values {
      field a: Count;
      field b: Count;
      field c: Count;
    }
    error Invalid;
    capability Bad {
      input Values;
      output Count;
      fails Invalid;
      expose command;
      workflow {
        validate input.a < input.b < input.c else Invalid;
        return input.a;
      }
    }
  }
}
