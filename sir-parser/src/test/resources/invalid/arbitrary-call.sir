sir 0.3

software BadCall {
  metadata {
    displayName "Bad Call";
    namespace "example.badcall";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    capability Bad {
      output Text;
      expose command;
      workflow {
        return calculatePrice();
      }
    }
  }
}
