sir 0.3

software TaskBoard {
  metadata {
    displayName "Task Board";
    namespace "example.tasks";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    enum TaskState { TODO, DOING, DONE }
    entity User persistent {
      identity id: Id generated auto;
    }
    use DualTokenLogin {
      account: User;
      name: name;
      password: passwordHash;
    }
    input RegisterInput {
      field name: Name;
      field password: Text where length(6, 64);
    }
    view UserView from User {
      field id: Id;
      field name: Name;
    }
    error NameTaken http 409;
    capability Register {
      input RegisterInput;
      output UserView;
      fails NameTaken;
      requires atomic;
      expose command at "/register";
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user else NameTaken;
        return user;
      }
    }
    error BadPage;
    error Forbidden http 403;
    input PageOnly {
      field page: PageNo;
      field size: PageSize;
    }

    entity Project persistent {
      identity id: Id generated auto;
      field owner: Ref<User>;
      field name: Name;
      field description: Optional<Remark>;
    }
    entity ProjectMember persistent {
      identity id: Id generated auto;
      field project: Ref<Project>;
      field user: Ref<User>;
      unique (project, user);
    }
    entity Task persistent {
      identity id: Id generated auto;
      field project: Ref<Project>;
      field title: Name;
      field detail: Optional<Text>;
      // GAP: an optional reference or time cannot be compared (`assignee == actor`, `dueAt < now()`), so both are
      // required: a new task is assigned to its creator and carries a due time.
      // G7: assignee and due time may now be absent; the preceding GAP records the old workaround.
      field assignee: Optional<Ref<User>>;
      field state: TaskState default TaskState.TODO;
      field priority: Count default 3;
      field dueAt: Optional<Moment>;
      field createdAt: Moment default now();
    }
    use Crud {
      entity: Project;
      owner: owner;
      path: projects;
    }
    view TaskView from Task {
      field id: Id;
      field title: Name;
      field detail: Optional<Text>;
      field assignee: Optional<Ref<User>>;
      field state: TaskState;
      field priority: Count;
      field dueAt: Optional<Moment>;
    }
    input NewTask {
      field projectId: Id;
      field title: Name;
      field priority: Count where min(1), max(5);
      field dueAt: Optional<Moment>;
    }
    capability CreateTask {
      actor Ref<User>;
      input NewTask;
      output TaskView;
      fails Forbidden;
      fails ProjectNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/projects/{projectId}/tasks";
      workflow {
        load Project by input.projectId as project else ProjectNotFound;
        exists ProjectMember where item.project == project and item.user == actor as isMember;
        validate project.owner == actor or isMember else Forbidden;
        create Task as task {
          project: project;
          title: input.title;

          priority: input.priority;
          dueAt: input.dueAt;
        }
        persist task;
        return task;
      }
    }
    input Assign {
      field taskId: Id;
      field userId: Id;
    }
    error TaskNotFound http 404;
    error UserNotFound http 404;
    capability AssignTask {
      actor Ref<User>;
      input Assign;
      output TaskView;
      fails Forbidden;
      fails ProjectNotFound;
      fails TaskNotFound;
      fails UserNotFound;
      requires authenticated;
      requires atomic;
      expose command put at "/tasks/{taskId}/assignee";
      workflow {
        load Task by input.taskId as task else TaskNotFound;
        load Project by task.project as project else ProjectNotFound;
        exists ProjectMember where item.project == project and item.user == actor as isMember;
        validate project.owner == actor or isMember else Forbidden;
        load User by input.userId as user else UserNotFound;
        update task {
          assignee: user;
        }
        persist task;
        return task;
      }
    }
    input AddMember {
      field projectId: Id;
      field userId: Id;
    }
    error AlreadyMember http 409;
    capability AddProjectMember {
      actor Ref<User>;
      input AddMember;
      output Unit;
      fails AlreadyMember;
      fails Forbidden;
      fails ProjectNotFound;
      fails UserNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/projects/{projectId}/members";
      workflow {
        load Project by input.projectId as project else ProjectNotFound;
        validate project.owner == actor else Forbidden;
        load User by input.userId as user else UserNotFound;
        create ProjectMember as member { project: project; user: user; }
        persist member else AlreadyMember;
        return unit;
      }
    }
    input Move {
      field taskId: Id;
      field state: TaskState;
    }
    capability MoveTask {
      actor Ref<User>;
      input Move;
      output TaskView;
      fails Forbidden;
      fails ProjectNotFound;
      fails TaskNotFound;
      requires authenticated;
      requires atomic;
      expose command put at "/tasks/{taskId}/state";
      workflow {
        load Task by input.taskId as task else TaskNotFound;
        load Project by task.project as project else ProjectNotFound;
        exists ProjectMember where item.project == project and item.user == actor as isMember;
        validate task.assignee == actor or project.owner == actor or isMember else Forbidden;
        update task {
          state: input.state;
        }
        persist task;
        return task;
      }
    }
    input TaskQuery {
      field projectId: Id;
      field state: Optional<TaskState>;
      field priority: Optional<Count>;
      field page: PageNo;
      field size: PageSize;
    }
    capability TasksOfProject {
      actor Ref<User>;
      input TaskQuery;
      output Page<TaskView>;
      fails BadPage;
      fails Forbidden;
      fails ProjectNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/projects/{projectId}/tasks";
      workflow {
        load Project by input.projectId as project else ProjectNotFound;
        exists ProjectMember where item.project == project and item.user == actor as isMember;
        validate project.owner == actor or isMember else Forbidden;
        find Task
           where item.project == project
             and (input.state is none or item.state == input.state)
             and (input.priority is none or item.priority == input.priority)
          order by priority descending, id ascending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }
    capability MyTasks {
      actor Ref<User>;
      input PageOnly;
      output Page<TaskView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/tasks/mine";
      workflow {
        find Task
          where item.assignee == actor and item.state != TaskState.DONE
          order by priority descending, id ascending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }
    capability UnassignedTasks {
      actor Ref<User>;
      input TaskQuery;
      output Page<TaskView>;
      fails BadPage;
      fails Forbidden;
      fails ProjectNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/projects/{projectId}/tasks/unassigned";
      workflow {
        load Project by input.projectId as project else ProjectNotFound;
        exists ProjectMember where item.project == project and item.user == actor as isMember;
        validate project.owner == actor or isMember else Forbidden;
        find Task where item.project == project and item.assignee is none
          order by priority descending, id ascending
          Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    capability OverdueTasks {
      actor Ref<User>;
      input PageOnly;
      output Page<TaskView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/tasks/overdue";
      workflow {
        find Task
          where item.assignee == actor and item.dueAt < now() and item.state != TaskState.DONE
          order by dueAt ascending, id ascending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }
  }
}
