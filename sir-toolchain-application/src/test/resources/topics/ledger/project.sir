sir 0.3

software PersonalLedger {
  metadata {
    displayName "Personal Ledger";
    namespace "example.ledger";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    enum Direction { INCOME, EXPENSE }
    type ZoneName = Text where timeZone, length(1, 64);
    entity User persistent {
      identity id: Id generated auto;
      field timeZone: Optional<ZoneName>;
    }
    use DualTokenLogin {
      account: User;
      name: name;
      password: passwordHash;
    }
    input RegisterInput {
      field name: Name;
      field password: Text where length(6, 64);
    }
    view UserView from User {
      field id: Id;
      field name: Name;
    }
    error NameTaken http 409;
    capability Register {
      input RegisterInput;
      output UserView;
      fails NameTaken;
      requires atomic;
      expose command at "/register";
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user else NameTaken;
        return user;
      }
    }
    error BadPage;
    error Forbidden http 403;
    input PageOnly {
      field page: PageNo;
      field size: PageSize;
    }

    entity Category persistent {
      identity id: Id generated auto;
      field owner: Ref<User>;
      field name: Name;
      field direction: Direction;
    }
    // Exact decimal amounts; 0.01 is the smallest positive value at Money's default scale.
    entity Entry persistent {
      identity id: Id generated auto;
      field owner: Ref<User>;
      field category: Ref<Category>;
      field amount: Money where min(0.01);
      field note: Optional<Remark>;
      field occurredAt: Moment;
    }
    entity Budget persistent {
      identity id: Id generated auto;
      field owner: Ref<User>;
      field category: Ref<Category>;
      field monthlyLimit: Money where min(0.01);
    }
    use Crud {
      entity: Category;
      owner: owner;
      path: categories;
    }
    use Crud {
      entity: Entry;
      owner: owner;
      path: entries;
    }
    use Crud {
      entity: Budget;
      owner: owner;
      path: budgets;
    }
    input RangeQuery {
      field since: Moment;
      field until: Moment;
      field page: PageNo;
      field size: PageSize;
    }
    error BadRange;
    capability EntriesBetween {
      actor Ref<User>;
      input RangeQuery;
      output Page<EntryView>;
      fails BadPage;
      fails BadRange;
      requires authenticated;
      requires readonly;
      expose query at "/entries/between";
      workflow {
        validate input.until > input.since else BadRange;
        find Entry
          where item.owner == actor and item.occurredAt >= input.since and item.occurredAt < input.until
          order by occurredAt descending, id descending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }
    input CategoryRange {
      field categoryId: Id;
      field since: Moment;
      field until: Moment;
      field page: PageNo;
      field size: PageSize;
    }
    capability EntriesOfCategory {
      actor Ref<User>;
      input CategoryRange;
      output Page<EntryView>;
      fails BadPage;
      fails BadRange;
      fails CategoryNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/categories/{categoryId}/entries";
      workflow {
        validate input.until > input.since else BadRange;
        load Category by input.categoryId as category else CategoryNotFound;
        find Entry
          where item.owner == actor and item.category == category and item.occurredAt >= input.since and item.occurredAt < input.until
          order by occurredAt descending, id descending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }
    type TotalAmount = Money;
    input SumRange {
      field since: Optional<Moment>;
      field until: Optional<Moment>;
    }
    input CategorySumRange {
      field categoryId: Id;
      field since: Optional<Moment>;
      field until: Optional<Moment>;
    }
    capability TotalBetween {
      actor Ref<User>;
      input SumRange;
      output TotalAmount;
      fails BadRange;
      requires authenticated;
      requires readonly;
      expose query at "/entries/total";
      workflow {
        validate input.until > input.since else BadRange;
        sum Entry.amount where item.owner == actor
          and item.occurredAt >= input.since and item.occurredAt < input.until as total;
        return total;
      }
    }
    capability TotalOfCategory {
      actor Ref<User>;
      input CategorySumRange;
      output TotalAmount;
      fails BadRange;
      fails CategoryNotFound;
      requires authenticated;
      requires readonly;
      expose query at "/categories/{categoryId}/total";
      workflow {
        validate input.until > input.since else BadRange;
        load Category by input.categoryId as category else CategoryNotFound;
        validate category.owner == actor else CategoryNotFound;
        sum Entry.amount where item.owner == actor and item.category == category
          and item.occurredAt >= input.since and item.occurredAt < input.until as total;
        return total;
      }
    }
    input GroupRange {
      field since: Optional<Moment>;
      field until: Optional<Moment>;
      field page: PageNo;
      field size: PageSize;
    }
    capability TotalsByCategory {
      actor Ref<User>;
      input GroupRange;
      output Page<SumGroup<Ref<Category>>>;
      fails BadPage;
      fails BadRange;
      requires authenticated;
      requires readonly;
      expose query at "/entries/totals-by-category";
      workflow {
        validate input.until > input.since else BadRange;
        sum Entry.amount by category
          where item.owner == actor and any(Category, id == item.category and owner == actor)
            and item.occurredAt >= input.since and item.occurredAt < input.until
          Page input.page, input.size else BadPage
        as totals;
        return totals;
      }
    }
    // The average of an entry in the period, rounded half up to the cent; a period with no entries answers 0.
    capability AverageBetween {
      actor Ref<User>;
      input SumRange;
      output TotalAmount;
      fails BadRange;
      requires authenticated;
      requires readonly;
      expose query at "/entries/average";
      workflow {
        validate input.until > input.since else BadRange;
        avg Entry.amount where item.owner == actor
          and item.occurredAt >= input.since and item.occurredAt < input.until as mean;
        return mean;
      }
    }
    capability AveragesByCategory {
      actor Ref<User>;
      input GroupRange;
      output Page<SumGroup<Ref<Category>>>;
      fails BadPage;
      fails BadRange;
      requires authenticated;
      requires readonly;
      expose query at "/entries/averages-by-category";
      workflow {
        validate input.until > input.since else BadRange;
        avg Entry.amount by category
          where item.owner == actor and any(Category, id == item.category and owner == actor)
            and item.occurredAt >= input.since and item.occurredAt < input.until
          Page input.page, input.size else BadPage
        as means;
        return means;
      }
    }
    // A missing preference is deliberate: old users must choose, never silently inherit the server's zone.
    view TimeZoneView from User { field timeZone: Optional<Text>; }
    input PreferredTimeZone { field timeZone: ZoneName where notBlank; }
    error UserNotFound http 404;
    error BadPeriod http 400;
    capability ReadTimeZone {
      actor Ref<User>; output TimeZoneView; fails UserNotFound;
      requires authenticated; requires readonly; expose query at "/me/time-zone";
      workflow {
        load User by actor as account else UserNotFound;
        return account;
      }
    }
    capability SetTimeZone {
      actor Ref<User>; input PreferredTimeZone; output TimeZoneView; fails UserNotFound;
      requires authenticated; requires atomic; expose command at "/me/time-zone";
      workflow {
        load User by actor as account else UserNotFound;
        update account { timeZone: input.timeZone; }
        persist account;
        return account;
      }
    }
    input MonthQuery {
      field month: Optional<Text>;
      field page: PageNo;
      field size: PageSize;
    }
    capability TotalsForMonth {
      actor Ref<User>; input MonthQuery; output Page<SumGroup<Ref<Category>>>;
      fails BadPage; fails BadPeriod; fails UserNotFound;
      requires authenticated; requires readonly; expose query at "/entries/monthly-totals";
      workflow {
        load User by actor as account else UserNotFound;
        month input.month in account.timeZone as since, until else BadPeriod;
        sum Entry.amount by category
          where item.owner == actor and any(Category, id == item.category and owner == actor)
            and item.occurredAt >= since and item.occurredAt < until
          Page input.page, input.size else BadPage as totals;
        return totals;
      }
    }
    input BudgetMonthQuery { field budgetId: Id; field month: Optional<Text>; }
    capability BudgetExceededForMonth {
      actor Ref<User>; input BudgetMonthQuery; output Flag;
      fails BadPeriod; fails BudgetNotFound; fails UserNotFound;
      requires authenticated; requires readonly; expose query at "/budgets/{budgetId}/exceeded";
      workflow {
        load User by actor as account else UserNotFound;
        month input.month in account.timeZone as since, until else BadPeriod;
        load Budget by input.budgetId as budget else BudgetNotFound;
        validate budget.owner == actor else BudgetNotFound;
        load Category by budget.category as category else BudgetNotFound;
        validate category.owner == actor else BudgetNotFound;
        sum Entry.amount where item.owner == actor and item.category == category
          and item.occurredAt >= since and item.occurredAt < until as total;
        return total > budget.monthlyLimit;
      }
    }
    // Current preferences, rules and mutable entries determine historical re-queries; no period snapshots.
    // Zero-entry categories are absent; mutable directions are not historical net-income facts.
  }
}
