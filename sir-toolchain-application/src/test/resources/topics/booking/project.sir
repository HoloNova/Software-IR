sir 0.3

software RoomBooking {
  metadata {
    displayName "Room Booking";
    namespace "example.booking";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    enum Role { MEMBER, ADMIN }
    entity User persistent {
      identity id: Id generated auto;
      field role: Role default Role.MEMBER;
    }
    use DualTokenLogin {
      account: User;
      name: name;
      password: passwordHash;
    }
    input RegisterInput {
      field name: Name;
      field password: Text where length(6, 64);
    }
    view UserView from User {
      field id: Id;
      field name: Name;
      field role: Role;
    }
    error NameTaken http 409;
    capability Register {
      input RegisterInput;
      output UserView;
      fails NameTaken;
      requires atomic;
      expose command at "/register";
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user else NameTaken;
        return user;
      }
    }
    error BadPage;
    error Forbidden http 403;
    input PageOnly {
      field page: PageNo;
      field size: PageSize;
    }

    entity Room persistent {
      identity id: Id generated auto;
      field name: Name unique;
      field location: Name;
      field capacity: Quantity;
    }
    // A booking is the half-open interval [startsAt, endsAt). Every writer locks Room first;
    // uniqueness alone cannot reject overlapping intervals with different starts.
    entity Booking persistent {
      identity id: Id generated auto;
      field room: Ref<Room>;
      field booker: Ref<User>;
      field startsAt: Moment;
      field endsAt: Moment;
      field purpose: Remark;
      unique (room, startsAt);
    }
    view RoomView from Room {
      field id: Id;
      field name: Name;
      field location: Name;
      field capacity: Quantity;
    }
    view BookingView from Booking {
      field id: Id;
      field room: RoomView;
      field startsAt: Moment;
      field endsAt: Moment;
      field purpose: Remark;
    }

    input NewRoom {
      field name: Name;
      field location: Name;
      field capacity: Quantity;
    }
    capability AddRoom {
      actor Ref<User>;
      input NewRoom;
      output RoomView;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command at "/rooms";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        create Room as room {
          name: input.name;
          location: input.location;
          capacity: input.capacity;
        }
        persist room;
        return room;
      }
    }
    capability Rooms {
      input PageOnly;
      output Page<RoomView>;
      fails BadPage;
      requires readonly;
      expose query at "/rooms";
      workflow {
        find Room where true order by name ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }

    input NewBooking {
      field roomId: Id;
      field startsAt: Moment;
      field endsAt: Moment;
      field purpose: Remark where notBlank;
    }
    error HourTaken http 409;
    error InvalidInterval http 400;
    error RoomNotFound http 404;
    capability Book {
      actor Ref<User>;
      input NewBooking;
      output BookingView;
      fails HourTaken;
      fails InvalidInterval;
      fails RoomNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/bookings";
      workflow {
        validate input.startsAt < input.endsAt else InvalidInterval;
        load Room by input.roomId as room for update else RoomNotFound;
        exists Booking where item.room == room and item.startsAt < input.endsAt and item.endsAt > input.startsAt as taken;
        validate not taken else HourTaken;
        create Booking as made {
          room: room;
          booker: actor;
          startsAt: input.startsAt;
          endsAt: input.endsAt;
          purpose: input.purpose;
        }
        persist made else HourTaken;
        return made;
      }
    }
    // A weekly series books the same hours on consecutive weeks. The room is locked once, then each week is checked for
    // an overlap and written; one taken week stops the series and rolls back every earlier week.
    input WeeklyBooking {
      field roomId: Id;
      field startsAt: Moment;
      field endsAt: Moment;
      field purpose: Remark where notBlank;
      field weeks: Quantity;
    }
    error TooManyWeeks http 409;
    capability BookWeekly {
      actor Ref<User>;
      input WeeklyBooking;
      output Unit;
      fails HourTaken;
      fails InvalidInterval;
      fails RoomNotFound;
      fails TooManyWeeks;
      requires authenticated;
      requires atomic;
      expose command at "/bookings/weekly";
      workflow {
        validate input.startsAt < input.endsAt else InvalidInterval;
        load Room by input.roomId as room for update else RoomNotFound;
        repeat input.weeks times limit 12 else TooManyWeeks as week {
          exists Booking where item.room == room and item.startsAt < addDays(input.endsAt, week * 7) and item.endsAt > addDays(input.startsAt, week * 7) as taken;
          validate not taken else HourTaken;
          create Booking as made {
            room: room;
            booker: actor;
            startsAt: addDays(input.startsAt, week * 7);
            endsAt: addDays(input.endsAt, week * 7);
            purpose: input.purpose;
          }
          persist made else HourTaken;
        }
        return unit;
      }
    }
    input BookingRef {
      field id: Id;
    }
    error BookingNotFound http 404;
    // Cancelling takes the booking away, so this interval is free again; past bookings are unchanged.
    capability CancelBooking {
      actor Ref<User>;
      input BookingRef;
      output Unit;
      fails BookingNotFound;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command delete at "/bookings/{id}";
      workflow {
        load Booking by input.id as made else BookingNotFound;
        validate made.booker == actor else Forbidden;
        delete made;
        return unit;
      }
    }
    capability MyBookings {
      actor Ref<User>;
      input PageOnly;
      output Page<BookingView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/bookings";
      workflow {
        find Booking
          where item.booker == actor
          order by startsAt ascending, id ascending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }
    input Schedule {
      field roomId: Id;
      field startsAt: Moment;
      field endsAt: Moment;
      field page: PageNo;
      field size: PageSize;
    }
    capability RoomSchedule {
      input Schedule;
      output Page<BookingView>;
      fails BadPage;
      fails InvalidInterval;
      fails RoomNotFound;
      requires readonly;
      expose query at "/rooms/{roomId}/bookings";
      workflow {
        validate input.startsAt < input.endsAt else InvalidInterval;
        load Room by input.roomId as room else RoomNotFound;
        find Booking
          where item.room == room and item.startsAt < input.endsAt and item.endsAt > input.startsAt
          order by startsAt ascending, id ascending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }
  }
}
