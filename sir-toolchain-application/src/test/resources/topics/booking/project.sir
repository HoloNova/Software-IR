sir 0.3

software RoomBooking {
  metadata {
    displayName "Room Booking";
    namespace "example.booking";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    enum Role { MEMBER, ADMIN }
    entity User persistent {
      identity id: Id generated auto;
      field role: Role default Role.MEMBER;
    }
    use DualTokenLogin {
      account: User;
      name: name;
      password: passwordHash;
    }
    input RegisterInput {
      field name: Name;
      field password: Text where length(6, 64);
    }
    view UserView from User {
      field id: Id;
      field name: Name;
      field role: Role;
    }
    error NameTaken http 409;
    capability Register {
      input RegisterInput;
      output UserView;
      fails NameTaken;
      requires atomic;
      expose command at "/register";
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user else NameTaken;
        return user;
      }
    }
    error BadPage;
    error Forbidden http 403;
    input PageOnly {
      field page: PageNo;
      field size: PageSize;
    }

    entity Room persistent {
      identity id: Id generated auto;
      field name: Name unique;
      field location: Name;
      field capacity: Quantity;
    }
    // A booking is one hour of one room. The (room, day, hour) triple is unique, so the database refuses a second
    // booking of the same hour even when two people ask at the same moment. GAP: a meeting of several hours is
    // several bookings (a request cannot carry a list the workflow walks).
    entity Booking persistent {
      identity id: Id generated auto;
      field room: Ref<Room>;
      field booker: Ref<User>;
      field day: Day;
      field hour: Count where min(0), max(23);
      field purpose: Remark;
      unique (room, day, hour);
    }
    view RoomView from Room {
      field id: Id;
      field name: Name;
      field location: Name;
      field capacity: Quantity;
    }
    view BookingView from Booking {
      field id: Id;
      field room: RoomView;
      field day: Day;
      field hour: Count;
      field purpose: Remark;
    }

    input NewRoom {
      field name: Name;
      field location: Name;
      field capacity: Quantity;
    }
    capability AddRoom {
      actor Ref<User>;
      input NewRoom;
      output RoomView;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command at "/rooms";
      workflow {
        validate actor.role == Role.ADMIN else Forbidden;
        create Room as room {
          name: input.name;
          location: input.location;
          capacity: input.capacity;
        }
        persist room;
        return room;
      }
    }
    capability Rooms {
      input PageOnly;
      output Page<RoomView>;
      fails BadPage;
      requires readonly;
      expose query at "/rooms";
      workflow {
        find Room where true order by name ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }

    input NewBooking {
      field roomId: Id;
      field day: Day;
      field hour: Count where min(0), max(23);
      field purpose: Remark where notBlank;
    }
    error HourTaken http 409;
    error RoomNotFound http 404;
    capability Book {
      actor Ref<User>;
      input NewBooking;
      output BookingView;
      fails HourTaken;
      fails RoomNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/bookings";
      workflow {
        load Room by input.roomId as room else RoomNotFound;
        create Booking as made {
          room: room;
          booker: actor;
          day: input.day;
          hour: input.hour;
          purpose: input.purpose;
        }
        persist made else HourTaken;
        return made;
      }
    }
    input BookingRef {
      field id: Id;
    }
    error BookingNotFound http 404;
    // Cancelling takes the booking away, so the hour is free again. GAP: whether the hour is already past cannot be
    // asked (a Day cannot be compared with now()).
    capability CancelBooking {
      actor Ref<User>;
      input BookingRef;
      output Unit;
      fails BookingNotFound;
      fails Forbidden;
      requires authenticated;
      requires atomic;
      expose command delete at "/bookings/{id}";
      workflow {
        load Booking by input.id as made else BookingNotFound;
        validate made.booker == actor else Forbidden;
        delete made;
        return unit;
      }
    }
    capability MyBookings {
      actor Ref<User>;
      input PageOnly;
      output Page<BookingView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/bookings";
      workflow {
        find Booking
          where item.booker == actor
          order by day ascending, hour ascending, id ascending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }
    input Schedule {
      field roomId: Id;
      field day: Day;
      field page: PageNo;
      field size: PageSize;
    }
    capability RoomSchedule {
      input Schedule;
      output Page<BookingView>;
      fails BadPage;
      fails RoomNotFound;
      requires readonly;
      expose query at "/rooms/{roomId}/bookings";
      workflow {
        load Room by input.roomId as room else RoomNotFound;
        find Booking
          where item.room == room and item.day == input.day
          order by hour ascending, id ascending
          Page input.page, input.size else BadPage
        as rows;
        return rows;
      }
    }
  }
}
