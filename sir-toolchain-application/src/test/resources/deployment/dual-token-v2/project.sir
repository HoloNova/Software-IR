sir 0.2

software DualTokenDesk {
  metadata {
    displayName "Dual Token Desk";
    namespace "example.dualtoken";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Int64 generated auto;
      field name: String where length(1, 64) unique;
      field passwordHash: String secret;
    }
    entity Note persistent {
      identity id: Int64 generated auto;
      field author: Ref<User>;
      field text: String;
      field title: Optional<String> where length(0, 120);
    }
    entity Label persistent {
      identity id: Int64 generated auto;
      field note: Ref<Note>;
      field name: String where length(1, 64);
    }
    view LabelView from Label {
      field id: Int64;
      field name: String;
    }
    input LabelInput {
      field noteId: Int64;
      field name: String where notBlank, length(1, 64);
    }
    error NoteNotFound http 404;
    capability AddLabel {
      input LabelInput;
      output LabelView;
      fails NoteNotFound;
      requires atomic;
      expose command;
      workflow {
        load Note by input.noteId as note else NoteNotFound;
        create Label as label {
          note: note;
          name: input.name;
        }
        persist label;
        return label;
      }
    }
    view NoteView from Note {
      field id: Int64;
      field text: String;
    }
    input NoteInput {
      field text: String where notBlank;
    }
    view UserView from User {
      field id: Int64;
      field name: String;
    }
    input UserRef {
      field id: Int64;
    }
    error UserNotFound http 404;
    input RegisterInput {
      field name: String;
      field password: String;
    }
    capability GetUser {
      input UserRef;
      output UserView;
      fails UserNotFound;
      requires readonly;
      expose query;
      workflow {
        load User by input.id as user else UserNotFound;
        return user;
      }
    }
    capability Register {
      input RegisterInput;
      output UserView;
      requires atomic;
      expose command;
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user;
        return user;
      }
    }
    capability PostNote {
      actor Ref<User>;
      input NoteInput;
      output NoteView;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        create Note as note {
          author: actor;
          text: input.text;
        }
        persist note;
        return note;
      }
    }
    capability Login {
      input LoginInput;
      output TokenPairView;
      fails BadLogin;
      requires atomic;
      expose command;
      workflow {
        load User by name: input.name as holder else BadLogin;
        validate holder.passwordHash matches input.password else BadLogin;
        create AccessToken as access {
          owner: holder;
          expiresAt: now() + 15 minutes;
        }
        create RefreshToken as refresh {
          owner: holder;
          used: false;
          expiresAt: now() + 7 days;
        }
        persist access;
        persist refresh;
        create TokenPair as pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: refresh.id;
          refreshExpiresAt: refresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }
    capability Logout {
      input RefreshInput;
      output LoggedOutView;
      fails InvalidRefreshToken;
      requires atomic;
      expose command;
      workflow {
        load RefreshToken by input.refreshToken as token else InvalidRefreshToken;
        update token {
          used: true;
        }
        persist token;
        return token;
      }
    }
    capability Refresh {
      input RefreshInput;
      output TokenPairView;
      fails ExpiredRefreshToken;
      fails InvalidRefreshToken;
      requires atomic;
      expose command;
      workflow {
        load RefreshToken by input.refreshToken as old else InvalidRefreshToken;
        validate old.expiresAt > now() else ExpiredRefreshToken;
        update old when old.used == false and old.expiresAt > now() else InvalidRefreshToken {
          used: true;
        }
        create AccessToken as access {
          owner: old.owner;
          expiresAt: now() + 15 minutes;
        }
        create RefreshToken as refresh {
          owner: old.owner;
          used: false;
          expiresAt: now() + 7 days;
        }
        persist old;
        persist access;
        persist refresh;
        create TokenPair as pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: refresh.id;
          refreshExpiresAt: refresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }
    entity AccessToken persistent {
      identity id: Uuid generated uuid;
      field owner: Ref<User>;
      field expiresAt: DateTime;
      credential subject owner expires expiresAt;
    }
    entity RefreshToken persistent {
      identity id: Uuid generated uuid;
      field owner: Ref<User>;
      field used: Boolean;
      field expiresAt: DateTime;
    }
    entity TokenPair persistent {
      identity id: Int64 generated auto;
      field accessToken: Uuid;
      field accessExpiresAt: DateTime;
      field refreshToken: Uuid;
      field refreshExpiresAt: DateTime;
    }
    error BadLogin http 401;
    error ExpiredRefreshToken http 401;
    error InvalidRefreshToken http 401;
    input LoginInput {
      field name: String;
      field password: String;
    }
    input RefreshInput {
      field refreshToken: Uuid;
    }
    view LoggedOutView from RefreshToken {
      field id: Uuid;
      field used: Boolean;
    }
    view TokenPairView from TokenPair {
      field accessToken: Uuid;
      field accessExpiresAt: DateTime;
      field refreshToken: Uuid;
      field refreshExpiresAt: DateTime;
    }
  }
}
