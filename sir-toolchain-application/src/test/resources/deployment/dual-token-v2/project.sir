sir 0.2

software DualTokenDesk {
  metadata {
    displayName "Dual Token Desk";
    namespace "example.dualtoken";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Int64 generated auto;
      field name: String where length(1, 64) unique;
      field passwordHash: String secret;
    }
    entity Note persistent {
      identity id: Int64 generated auto;
      field author: Ref<User>;
      field body: String @id("note-text");
      field title: Optional<String> where length(0, 120);
    }
    entity Label persistent {
      identity id: Int64 generated auto;
      field note: Ref<Note>;
      field name: String where length(1, 64);
    }
    view LabelView from Label {
      field id: Int64;
      field name: String;
    }
    input LabelInput {
      field noteId: Int64;
      field name: String where notBlank, length(1, 64);
    }
    error NoteNotFound http 404;
    capability AddLabel {
      input LabelInput;
      output LabelView;
      fails NoteNotFound;
      requires atomic;
      expose command;
      workflow {
        load Note by input.noteId as note else NoteNotFound;
        create Label as label {
          note: note;
          name: input.name;
        }
        persist label;
        return label;
      }
    }
    view NoteView from Note {
      field id: Int64;
      field body: String;
    }
    input NoteInput {
      field text: String where notBlank;
    }
    view UserView from User {
      field id: Int64;
      field name: String;
    }
    input UserRef {
      field id: Int64;
    }
    error UserNotFound http 404;
    input RegisterInput {
      field name: String;
      field password: String;
    }
    capability GetUser {
      input UserRef;
      output UserView;
      fails UserNotFound;
      requires readonly;
      expose query;
      workflow {
        load User by input.id as user else UserNotFound;
        return user;
      }
    }
    capability Register {
      input RegisterInput;
      output UserView;
      requires atomic;
      expose command;
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user;
        return user;
      }
    }
    capability PostNote {
      actor Ref<User>;
      input NoteInput;
      output NoteView;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        create Note as note {
          author: actor;
          body: input.text;
        }
        persist note;
        return note;
      }
    }
    use DualTokenLogin {
      account: User;
      name: name;
      password: passwordHash;
      access: 15 minutes;
      refresh: 7 days;
    }
  }
}
