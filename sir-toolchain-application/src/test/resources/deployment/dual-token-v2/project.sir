sir 0.3

software DualTokenDesk {
  metadata {
    displayName "Dual Token Desk";
    namespace "example.dualtoken";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Id generated auto;
    }
    entity Note persistent {
      identity id: Id generated auto;
      field author: Ref<User>;
      field body: Text @id("note-text");
      field pinned: Flag default true;
      field title: Optional<Text> where length(0, 120);
      field state: Text where length(1, 16) default "open";
    }
    entity Label persistent {
      identity id: Id generated auto;
      field note: Ref<Note>;
      field name: Text where length(1, 64);
    }
    use Crud {
      entity: Label;
    }
    input LabelInput {
      field noteId: Id;
      field name: Name where length(1, 64);
    }
    error NoteNotFound http 404;
    capability AddLabel {
      input LabelInput;
      output LabelView;
      fails NoteNotFound;
      requires atomic;
      expose command;
      workflow {
        load Note by input.noteId as note else NoteNotFound;
        create Label as label {
          note: note;
          name: input.name;
        }
        persist label;
        return label;
      }
    }
    view NoteView from Note {
      field id: Id;
      field body: Text;
    }
    input NoteInput {
      field text: Text where notBlank;
    }
    view UserView from User {
      field id: Id;
      field name: Text;
    }
    input UserRef {
      field id: Id;
    }
    error UserNotFound http 404;
    input RegisterInput {
      field name: Text;
      field password: Text;
    }
    capability GetUser {
      input UserRef;
      output UserView;
      fails UserNotFound;
      requires readonly;
      expose query;
      workflow {
        load User by input.id as user else UserNotFound;
        return user;
      }
    }
    capability Register {
      input RegisterInput;
      output UserView;
      requires atomic;
      expose command;
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user;
        return user;
      }
    }
    capability PostNote {
      actor Ref<User>;
      input NoteInput;
      output NoteView;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        create Note as note {
          author: actor;
          body: input.text;
        }
        persist note;
        return note;
      }
    }
    use DualTokenLogin {
      account: User;
      name: name;
      password: passwordHash;
      access: 15 minutes;
      refresh: 7 days;
    }
  }
}
