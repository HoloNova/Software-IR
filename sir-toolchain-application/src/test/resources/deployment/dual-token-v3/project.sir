sir 0.3

software DualTokenDesk {
  metadata {
    displayName "Dual Token Desk";
    namespace "example.dualtoken";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Id generated auto;
      field favorites: Count default 0;
    }
    entity Note persistent {
      identity id: Id generated auto;
      field author: Ref<User>;
      field body: Text @id("note-text");
      field pinned: Flag default true;
      field state: Text where length(1, 64) default "open";
      scope state != "hidden";
    }
    use Crud {
      entity: Note;
      owner: author;
    }
    // A reader favourites a note once: the pair is unique, and the database says no to the second time. The reader's
    // count of favourites is added to by the database, so requests that run at the same moment are all counted. The counted
    // row is persisted first: inserting `made` locks the rows it refers to for reading, and two requests that each hold
    // that lock and then ask to change the reader would wait for each other.
    entity Favorite persistent {
      identity id: Id generated auto;
      field note: Ref<Note>;
      field owner: Ref<User>;
      field score: Optional<Count>;
      field amount: Money default 0.0;
      field rebate: Optional<Money>;
      unique (note, owner);
    }
    // Optional-value and Money delivery conformance use this newly-created table; the chain remains V1..V11.
    view FavoriteView from Favorite {
      field id: Id;
      field score: Optional<Count>;
    }
    input FavoriteFilter {
      field minimum: Optional<Count>;
      field maximum: Optional<Count>;
      field page: PageNo;
      field size: PageSize;
    }
    input FavoriteScore {
      field id: Id;
      field score: Optional<Count>;
    }
    input FavoriteCountCheck {
      field expected: Serial;
      field hasRows: Flag;
      field minimum: Optional<Count>;
    }
    error CountRejected http 409;
    capability CheckFavoriteCount {
      actor Ref<User>;
      input FavoriteCountCheck;
      output Unit;
      fails CountRejected;
      requires authenticated;
      requires readonly;
      expose query at "/favorites/check-count";
      workflow {
        count Favorite where item.owner == actor and (input.minimum is none or item.score >= input.minimum) as actual;
        exists Favorite where item.owner == actor and (input.minimum is none or item.score >= input.minimum) as anyRows;
        validate actual == input.expected and anyRows == input.hasRows else CountRejected;
        return unit;
      }
    }
    capability CheckVisibleNoteCount {
      actor Ref<User>;
      input FavoriteCountCheck;
      output Unit;
      fails CountRejected;
      requires authenticated;
      requires readonly;
      expose query at "/notes/check-count";
      workflow {
        count Note where item.author == actor as actual;
        exists Note where item.author == actor as anyRows;
        validate actual == input.expected and anyRows == input.hasRows else CountRejected;
        return unit;
      }
    }
    input FavoritedNoteFilter {
      field text: Text;
      field minimum: Optional<Count>;
      field page: PageNo;
      field size: PageSize;
    }
    capability FavoritedNotes {
      actor Ref<User>;
      input FavoritedNoteFilter;
      output Page<NoteView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/notes/favorited";
      workflow {
        find Note where any(Favorite, note == item and owner == actor and item.body == input.text
          and (input.minimum is none or score >= input.minimum))
          order by id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    error BadPage;
    error ScoreRejected http 409;
    capability FilterFavorites {
      actor Ref<User>;
      input FavoriteFilter;
      output Page<FavoriteView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/favorites/filter";
      workflow {
        find Favorite where item.owner == actor
          and (input.minimum is none or item.score >= input.minimum)
          and (input.maximum is none or item.score <= input.maximum)
          order by id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    capability MissingFavoriteScores {
      actor Ref<User>;
      input FavoriteFilter;
      output Page<FavoriteView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/favorites/missing";
      workflow {
        find Favorite where item.owner == actor and item.score is none
          order by id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    capability DifferentFavoriteScores {
      actor Ref<User>;
      input FavoriteFilter;
      output Page<FavoriteView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/favorites/different";
      workflow {
        find Favorite where item.owner == actor and item.score != input.minimum
          order by id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    capability NotEqualFavoriteScores {
      actor Ref<User>;
      input FavoriteFilter;
      output Page<FavoriteView>;
      fails BadPage;
      requires authenticated;
      requires readonly;
      expose query at "/favorites/not-equal";
      workflow {
        find Favorite where item.owner == actor and not (item.score == input.minimum)
          order by id ascending Page input.page, input.size else BadPage as rows;
        return rows;
      }
    }
    capability RaiseFavoriteScore {
      actor Ref<User>;
      input FavoriteScore;
      output Unit;
      fails ScoreRejected;
      requires authenticated;
      requires atomic;
      expose command at "/favorites/raise";
      workflow {
        load Favorite by input.id as favorite else ScoreRejected;
        validate favorite.owner == actor else ScoreRejected;
        update favorite when favorite.score is none or favorite.score < input.score else ScoreRejected {
          score: input.score;
        }
        persist favorite;
        return unit;
      }
    }
    capability CheckFavoriteScore {
      actor Ref<User>;
      input FavoriteScore;
      output Unit;
      fails ScoreRejected;
      requires authenticated;
      requires readonly;
      expose query at "/favorites/check";
      workflow {
        load Favorite by input.id as favorite else ScoreRejected;
        validate favorite.owner == actor else ScoreRejected;
        validate favorite.score != input.score else ScoreRejected;
        return unit;
      }
    }
    error AlreadyFavorite http 409;
    capability FavoriteNote {
      actor Ref<User>;
      input NoteIdInput;
      output Unit;
      fails AlreadyFavorite;
      fails NoteNotFound;
      fails UserNotFound;
      requires authenticated;
      requires atomic;
      expose command at "/notes/{id}/favorite";
      workflow {
        load Note by input.id as note else NoteNotFound;
        load User by actor as reader else UserNotFound;
        create Favorite as made {
          note: note;
          owner: actor;
        }
        update reader {
          favorites: reader.favorites + 1;
        }
        persist reader;
        persist made else AlreadyFavorite;
        return unit;
      }
    }
    error NotAuthor http 403;
    capability PinNote {
      actor Ref<User>;
      input NoteIdInput;
      output NoteView;
      fails NotAuthor;
      fails NoteNotFound;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        load Note by input.id as note else NoteNotFound;
        validate note.author == actor else NotAuthor;
        update note {
          pinned: true;
        }
        persist note;
        return note;
      }
    }
    input NoteInput {
      field text: Text where notBlank;
    }
    view UserView from User {
      field id: Id;
      field name: Text;
    }
    input UserRef {
      field id: Id;
    }
    error UserNotFound http 404;
    input RegisterInput {
      field name: Text;
      field password: Text;
    }
    capability GetUser {
      input UserRef;
      output UserView;
      fails UserNotFound;
      requires readonly;
      expose query;
      workflow {
        load User by input.id as user else UserNotFound;
        return user;
      }
    }
    capability Register {
      input RegisterInput;
      output UserView;
      requires atomic;
      expose command;
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user;
        return user;
      }
    }
    capability PostNote {
      actor Ref<User>;
      input NoteInput;
      output NoteView;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        create Note as note {
          author: actor;
          body: input.text;
        }
        persist note;
        return note;
      }
    }
    use DualTokenLogin {
      account: User;
      name: name;
      password: passwordHash;
      access: 15 minutes;
      refresh: 7 days;
    }
  }
}
