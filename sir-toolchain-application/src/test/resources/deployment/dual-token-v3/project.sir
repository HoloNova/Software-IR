sir 0.3

software DualTokenDesk {
  metadata {
    displayName "Dual Token Desk";
    namespace "example.dualtoken";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Id generated auto;
    }
    entity Note persistent {
      identity id: Id generated auto;
      field author: Ref<User>;
      field body: Text @id("note-text");
      field pinned: Flag default true;
      field state: Text where length(1, 64) default "open";
    }
    use Crud {
      entity: Note;
      owner: author;
    }
    error NotAuthor http 403;
    capability PinNote {
      actor Ref<User>;
      input NoteIdInput;
      output NoteView;
      fails NotAuthor;
      fails NoteNotFound;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        load Note by input.id as note else NoteNotFound;
        validate note.author == actor else NotAuthor;
        update note {
          pinned: true;
        }
        persist note;
        return note;
      }
    }
    input NoteInput {
      field text: Text where notBlank;
    }
    view UserView from User {
      field id: Id;
      field name: Text;
    }
    input UserRef {
      field id: Id;
    }
    error UserNotFound http 404;
    input RegisterInput {
      field name: Text;
      field password: Text;
    }
    capability GetUser {
      input UserRef;
      output UserView;
      fails UserNotFound;
      requires readonly;
      expose query;
      workflow {
        load User by input.id as user else UserNotFound;
        return user;
      }
    }
    capability Register {
      input RegisterInput;
      output UserView;
      requires atomic;
      expose command;
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user;
        return user;
      }
    }
    capability PostNote {
      actor Ref<User>;
      input NoteInput;
      output NoteView;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        create Note as note {
          author: actor;
          body: input.text;
        }
        persist note;
        return note;
      }
    }
    use DualTokenLogin {
      account: User;
      name: name;
      password: passwordHash;
      access: 15 minutes;
      refresh: 7 days;
    }
  }
}
