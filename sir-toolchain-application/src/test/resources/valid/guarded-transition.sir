sir 0.2

software CredentialRotation {
  metadata {
    displayName "Credential Rotation";
    namespace "com.example.rotation";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity Credential persistent {
      identity id: Int64 generated auto;
      field owner: String;
      field used: Boolean;
      field expiresAt: DateTime;
    }
    view CredentialView from Credential {
      field id: Int64;
      field owner: String;
      field used: Boolean;
      field expiresAt: DateTime;
    }
    input GetCredentialInput {
      field id: Int64;
    }
    input RefreshInput {
      field id: Int64;
    }
    error CredentialNotFound http 404;
    error Expired http 400;
    error Invalid http 409;
    capability GetCredential {
      input GetCredentialInput;
      output CredentialView;
      fails CredentialNotFound;
      requires readonly;
      expose query;
      workflow {
        load Credential by input.id as credential else CredentialNotFound;
        return credential;
      }
    }
    capability Refresh {
      input RefreshInput;
      output CredentialView;
      fails CredentialNotFound;
      fails Expired;
      fails Invalid;
      requires atomic;
      expose command;
      workflow {
        load Credential by input.id as old else CredentialNotFound;
        validate old.expiresAt > now() else Expired;
        update old when old.used == false else Invalid { used: true; }
        create Credential as fresh {
          owner: old.owner;
          used: false;
          expiresAt: now() + 7 days;
        }
        persist old;
        persist fresh;
        return fresh;
      }
    }
  }
}
