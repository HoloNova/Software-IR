sir 0.1

software RenameCourseSearch {
  metadata {
    displayName "Rename Course Search";
    namespace "com.example.rename";
  }

  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }

  declarations {
    entity Course persistent {
      identity id: Int64 generated auto;
      field code: String where notBlank @id("course-code");
      field title: String where notBlank;
    }
    input GetCourseInput {
      field id: Int64;
    }
    error CourseNotFound http 404;
    /* capability */
    capability SearchCourseEnrollments @id("search-course-enrollments") {
      input GetCourseInput;
      output Ref<Course>;
      fails CourseNotFound;
      requires readonly;
      expose query;
      workflow {
        load Course by input.id as course else CourseNotFound;
        return course;
      }
    }
    capability CountCourses {
      output Unit;
      requires readonly;
      expose query;
      workflow {
        return unit;
      }
    }
  }
}
