sir 0.3
software Multiplication {
  metadata { displayName "Exact Multiplication"; namespace "example.multiplication"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus;
    database mysql; build maven; interface rest; }
  sources { } imports { }
  declarations {
    type UnitPrice = Money where precision(21, 4);
    entity Calculation persistent {
      identity id: Id generated auto;
      field amount: Money;
      field count: Count;
      field wide: Id;
    }
    view CalculationView from Calculation {
      field id: Id; field amount: Money; field count: Count; field wide: Id;
    }
    input Numbers {
      field price: UnitPrice; field quantity: Count;
      field left: Count; field right: Count; field wide: Id;
    }
    capability Multiply {
      input Numbers; output CalculationView; requires atomic; expose command;
      workflow {
        create Calculation as result {
          amount: input.price * input.quantity;
          count: input.left * input.right;
          wide: input.wide * 2;
        }
        persist result;
        return result;
      }
    }
    capability Wide {
      input Numbers; output CalculationView; requires atomic; expose command;
      workflow {
        create Calculation as result {
          amount: input.price * input.wide;
          count: 0;
          wide: input.wide;
        }
        persist result;
        return result;
      }
    }
    capability Reverse {
      input Numbers; output CalculationView; requires atomic; expose command;
      workflow {
        create Calculation as result {
          amount: input.quantity * input.price;
          count: input.left * (input.right + 1);
          wide: input.wide * (2 * input.wide);
        }
        persist result;
        return result;
      }
    }
    entity Product persistent {
      identity id: Id generated auto;
      field price: UnitPrice;
      field stock: Count where min(0);
    }
    entity Receipt persistent {
      identity id: Id generated auto;
      field product: Ref<Product>;
      field total: Money;
      field quantity: Quantity;
    }
    entity ReceiptLine persistent {
      identity id: Id generated auto;
      field receipt: Ref<Receipt>;
      field quantity: Quantity;
      field unitPrice: UnitPrice;
    }
    view ProductView from Product {
      field id: Id; field price: UnitPrice; field stock: Count;
      field inventoryValue: Money = item.price * item.stock;
      field soldOut: Flag = item.stock == 0;
    }
    view ReceiptView from Receipt {
      field id: Id; field total: Money; field quantity: Quantity;
      field doubledTotal: Money = item.total * 2;
    }
    input Purchase { field id: Id; field quantity: Quantity; }
    input ProductRef { field id: Id; }
    error Missing http 404;
    error OutOfStock http 409;
    capability PurchaseProduct {
      input Purchase; output ReceiptView; fails Missing; fails OutOfStock; requires atomic; expose command at "/purchase";
      workflow {
        load Product by input.id as product else Missing;
        update product when product.stock >= input.quantity else OutOfStock { stock: product.stock - input.quantity; }
        // An early SQL mutation deliberately proves whole-transaction rollback on a later invalid amount.
        persist product;
        create Receipt as receipt { product: product; total: product.price * input.quantity; quantity: input.quantity; }
        persist receipt;
        create ReceiptLine as line { receipt: receipt; quantity: input.quantity; unitPrice: product.price; }
        persist line;
        return receipt;
      }
    }
    entity Course persistent {
      identity id: Id generated auto;
      field capacity: Quantity;
      field enrolled: Count default 0;
    }
    view CourseCounterView from Course {
      field id: Id; field capacity: Quantity; field enrolled: Count;
      field remaining: Count = item.capacity - item.enrolled;
      field full: Flag = item.enrolled >= item.capacity;
    }
    input CourseKey { field id: Id; }
    error Full http 409;
    capability EnrollCourse {
      input CourseKey; output CourseCounterView; fails Full; fails Missing;
      requires atomic; expose command at "/courses/enroll";
      workflow {
        load Course by input.id as course else Missing;
        update course when course.enrolled < course.capacity else Full { enrolled: course.enrolled + 1; }
        persist course;
        return course;
      }
    }
    capability ShowCourse {
      input CourseKey; output CourseCounterView; fails Missing;
      requires readonly; expose query at "/courses/show";
      workflow { load Course by input.id as course else Missing; return course; }
    }
    capability ShowProduct {
      input ProductRef; output ProductView; fails Missing; requires readonly; expose query at "/products/show";
      workflow { load Product by input.id as product else Missing; return product; }
    }
    entity Room persistent { identity id: Id generated auto; field name: Text unique; }
    entity Booking persistent {
      identity id: Id generated auto;
      field room: Ref<Room>; field startsAt: Moment; field endsAt: Moment;
    }
    input NewBooking { field roomId: Id; field startsAt: Moment; field endsAt: Moment; }
    view BookingView from Booking { field id: Id; field startsAt: Moment; field endsAt: Moment; }
    error RoomMissing http 404; error SlotTaken http 409; error InvalidInterval http 400;
    capability Book {
      input NewBooking; output BookingView;
      fails InvalidInterval; fails RoomMissing; fails SlotTaken;
      requires atomic; expose command at "/bookings";
      workflow {
        validate input.startsAt < input.endsAt else InvalidInterval;
        load Room by input.roomId as room for update else RoomMissing;
        exists Booking where item.room == room and item.startsAt < input.endsAt and item.endsAt > input.startsAt as taken;
        validate not taken else SlotTaken;
        create Booking as made { room: room; startsAt: input.startsAt; endsAt: input.endsAt; }
        persist made;
        return made;
      }
    }
    capability BookAfterRead {
      input NewBooking; output BookingView;
      fails InvalidInterval; fails RoomMissing; fails SlotTaken;
      requires atomic; expose command at "/bookings/after-read";
      workflow {
        validate input.startsAt < input.endsAt else InvalidInterval;
        load Room by input.roomId as preview else RoomMissing;
        exists Booking where item.room == preview and item.startsAt < input.endsAt and item.endsAt > input.startsAt as beforeLock;
        load Room by input.roomId as room for update else RoomMissing;
        exists Booking where item.room == room and item.startsAt < input.endsAt and item.endsAt > input.startsAt as taken;
        validate not taken else SlotTaken;
        create Booking as made { room: room; startsAt: input.startsAt; endsAt: input.endsAt; }
        persist made;
        return made;
      }
    }
  }
}
