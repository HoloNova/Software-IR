sir 0.3

software CourseAdmin {
  metadata {
    displayName "Course Admin";
    namespace "com.example.courseadmin";
  }

  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }

  sources { }
  imports { }
  declarations {
    entity Course persistent {
      identity id: Id generated auto;
      field code: Code;
      field name: Name;
      field description: Optional<Remark>;
      field capacity: Quantity;
      field version: Version;
    }

    // Q13 chain base: the already accepted course-admin source (Q10) plus the enrollment slice
    // accepted by Q11. The slice is part of the *base* rather than something a change adds, because
    // the change layer refuses an AddCapability candidate that brings its own declarations
    // (SIR-CHANGE-SCOPE-101: "candidate must add exactly one new declaration; got 9").
    enum EnrollmentStatus {
      ACTIVE,
      CANCELLED
    }

    entity Student persistent {
      identity id: Id generated auto;
      field studentNo: Code where length(1, 16);
      field name: Name;
    }

    entity Enrollment persistent {
      identity id: Id generated auto;
      field course: Ref<Course>;
      field student: Ref<Student>;
      field status: EnrollmentStatus;
    }

    view CourseDetail from Course {
      field id: Id;
      field code: Text;
      field name: Text;
      field description: Optional<Text>;
      field capacity: Count;
      field version: Serial;
    }

    view StudentSummary from Student {
      field id: Id;
      field studentNo: Text;
      field name: Text;
    }

    view EnrollmentSummary from Enrollment {
      field id: Id;
      field student: StudentSummary;
      field status: EnrollmentStatus;
    }

    view CourseEnrollmentItem from Course {
      field id: Id;
      field code: Text;
      field name: Text;
      field capacity: Count;
      field enrollments: List<EnrollmentSummary>;
    }

    input GetCourseInput {
      field id: Id;
    }

    input CreateCourseInput {
      field code: Code;
      // Q13 R2 tightens the accepted length of a course name on the create input only. The entity
      // column keeps length(1, 100), which a tighter input constraint stays compatible with.
      field name: Code where length(1, 20);
      field description: Optional<Remark>;
      field capacity: Quantity;
    }

    input UpdateCourseInput patch of Course {
      field id: Id;
      field name: Text;
      field description: Optional<Text>;
      field capacity: Count;
    }

    input SearchCourseEnrollmentsInput {
      field page: PageNo;
      field size: PageSize;
    }

    error CourseNotFound http 404;
    error EmptyChange;
    error StaleVersion http 409;
    error InvalidPage;

    capability GetCourse {
      input GetCourseInput;
      output CourseDetail;
      fails CourseNotFound;
      requires readonly;
      expose query;
      workflow {
        load Course by input.id as course else CourseNotFound;
        return course;
      }
    }

    // Q13 R3b removes the last write capability: the generated service becomes read-only, and the
    // shared error-envelope and validation support artifacts must still exist afterwards.
    // Q13 R3a removes the UpdateCourse capability. Its input and error declarations stay behind on
    // purpose (same convention as campus-market-two-capabilities-remove-publish-goods.sir): a
    // surviving declaration keeps the plan to pure deletions instead of touching surviving files.
    capability SearchCourseEnrollments {
      input SearchCourseEnrollmentsInput;
      output Page<CourseEnrollmentItem>;
      fails InvalidPage;
      requires readonly;
      expose query;
      workflow {
        find Course
          where any(Enrollment, course == item)
          order by code ascending
          Page input.page, input.size else InvalidPage
        as courses;
        return courses;
      }
    }
  }
}
