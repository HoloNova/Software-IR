sir 0.3

software FaultMatrixDirs {
  metadata {
    displayName "故障矩阵：需要新建目录的基线";
    namespace "com.example.faultmatrixdirs";
  }

  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }

  sources { }
  imports { }
  declarations {
    enum GoodsStatus {
      AVAILABLE,
      SOLD
    }

    entity Goods persistent {
      identity id: Id generated auto;
      field title: Text where notBlank;
      field status: GoodsStatus;
    }

    capability SearchGoods {
      output List<Ref<Goods>>;
      requires readonly;
      expose query;

      workflow {
        find Goods where item.status == GoodsStatus.AVAILABLE as goods;
        return goods;
      }
    }
  }
}
