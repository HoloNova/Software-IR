sir 0.1

software FaultMatrixDirs {
  metadata {
    displayName "故障矩阵：需要新建目录的基线";
    namespace "com.example.faultmatrixdirs";
  }

  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }

  declarations {
    enum GoodsStatus {
      AVAILABLE,
      SOLD
    }

    entity Goods persistent {
      identity id: Int64 generated auto;
      field title: String where notBlank;
      field status: GoodsStatus;
    }
  }
}
