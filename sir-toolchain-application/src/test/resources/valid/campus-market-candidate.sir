sir 0.3

software CampusMarket {
  metadata {
    displayName "校园二手交易系统";
    namespace "com.example.campusmarket";
  }

  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }

  sources { }
  imports { }
  declarations {
    enum GoodsStatus {
      AVAILABLE,
      SOLD
    }

    entity User persistent {
      identity id: Id generated auto;
      field name: Text where notBlank;
      field email: Email;
    }

    entity Goods persistent {
      identity id: Id generated auto;
      field title: Name;
      field price: Money where min(0.01);
      field seller: Ref<User>;
      field status: GoodsStatus;
    }

    input PublishGoodsInput {
      field title: Text where notBlank;
      field price: Money where min(0.01);
    }

    error InvalidGoodsPrice;

    capability PublishGoods {
      actor Ref<User>;
      input PublishGoodsInput;
      output Ref<Goods>;
      fails InvalidGoodsPrice;
      requires authenticated;
      requires atomic;
      expose command;

      workflow {
        validate input.price > 0.0 else InvalidGoodsPrice;
        create Goods as goods {
          title: input.title;
          price: input.price;
          seller: actor;
          status: GoodsStatus.AVAILABLE;
        }
        persist goods;
        return goods;
      }
    }
  }
}
