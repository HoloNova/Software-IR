sir 0.1

software CampusMarket {
  metadata {
    displayName "校园二手交易双能力示例";
    namespace "com.example.campusmarket";
  }

  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }

  declarations {
    enum GoodsStatus {
      AVAILABLE,
      SOLD
    }

    entity Goods persistent {
      identity id: Int64 generated auto;
      field title: String where notBlank;
      field status: GoodsStatus;
    }

    input PublishGoodsInput {
      field title: String where notBlank;
    }

    error InvalidGoodsPrice;

    // PublishGoods is removed relative to campus-market-two-capabilities.sir. Its input and error
    // declarations stay behind on purpose: they survive as unchanged DTO/Exception files, so the
    // remove-capability plan reports deletions only and no changes to surviving artifacts.
    input SearchGoodsInput {
      field title: String where notBlank;
    }

    capability SearchGoods {
      input SearchGoodsInput;
      output List<Ref<Goods>>;
      requires readonly;
      expose query;

      workflow {
        find Goods where item.status == GoodsStatus.AVAILABLE as goods;
        return goods;
      }
    }
  }
}
