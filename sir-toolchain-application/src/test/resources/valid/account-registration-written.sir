sir 0.3

software SignUpDesk {
  metadata {
    displayName "Sign Up Desk";
    namespace "example.signup";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    enum Role { MEMBER, ADMIN }
    entity User persistent {
      identity id: Id generated auto;
      field role: Role default Role.MEMBER;
    }
    use DualTokenLogin {
      account: User;
      name: name;
      password: passwordHash;
    }
    input RegisterInput {
      field name: Name;
      field password: Text where length(6, 64);
    }
    view UserView from User {
      field id: Id;
      field name: Name;
      field role: Role;
    }
    error NameTaken http 409;
    capability Register {
      input RegisterInput;
      output UserView;
      fails NameTaken;
      requires atomic;
      expose command at "/register";
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user else NameTaken;
        return user;
      }
    }
  }
}
