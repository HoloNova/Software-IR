sir 0.3

software CrudDesk {
  metadata {
    displayName "Crud Desk";
    namespace "example.crud";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    enum Level {
      LOW,
      HIGH
    }
    entity Owner persistent {
      identity id: Token generated uuid;
      field name: Name;
    }
    entity Note persistent {
      identity id: Id generated auto;
      field title: Name unique;
      field body: Optional<Remark>;
      field level: Level default Level.LOW;
      field owner: Ref<Owner>;
      field pin: Secret;
      field code: Code where length(1, 8);
      field version: Version;
    }
    entity Item persistent {
      identity id: Token generated uuid;
      field title: Name;
      field removed: Flag default false;
      scope removed == false;
    }
    entity User persistent {
      identity id: Id generated auto;
      field nick: Optional<Name>;
    }
    entity Post persistent {
      identity id: Id generated auto;
      field author: Ref<User>;
      field text: Text;
    }
    view NoteView from Note {
      field id: Id;
      field title: Name;
      field body: Optional<Remark>;
      field level: Level;
      field owner: Ref<Owner>;
      field code: Code;
      field version: Version;
    }
    input CreateNoteInput {
      field title: Name;
      field body: Optional<Remark>;
      field owner: Ref<Owner>;
      field pin: Secret;
      field code: Code where length(1, 8);
    }
    input NoteIdInput {
      field id: Id;
    }
    input ListNoteInput {
      field page: PageNo;
      field size: PageSize;
    }
    input UpdateNoteInput patch of Note {
      field id: Id;
      field title: Text;
      field body: Optional<Text>;
      field level: Level;
      field owner: Ref<Owner>;
      field code: Text;
    }
    error StaleNote http 409;
    error NoteNotFound http 404;
    error InvalidNotePage;
    capability CreateNote {
      input CreateNoteInput;
      output NoteView;
      requires atomic;
      expose command at "/notes";
      workflow {
        create Note as row {
          title: input.title;
          body: input.body;
          owner: input.owner;
          pin: input.pin;
          code: input.code;
        }
        persist row;
        return row;
      }
    }
    capability GetNote {
      input NoteIdInput;
      output NoteView;
      fails NoteNotFound;
      requires readonly;
      expose query at "/notes/{id}";
      workflow {
        load Note by input.id as row else NoteNotFound;
        return row;
      }
    }
    capability ListNote {
      input ListNoteInput;
      output Page<NoteView>;
      fails InvalidNotePage;
      requires readonly;
      expose query at "/notes";
      workflow {
        find Note where true order by id ascending Page input.page, input.size else InvalidNotePage as rows;
        return rows;
      }
    }
    capability UpdateNote {
      input UpdateNoteInput;
      output NoteView;
      fails NoteNotFound;
      fails StaleNote;
      requires atomic;
      expose command at "/notes/{id}";
      workflow {
        load Note by input.id as row else NoteNotFound;
        update row {
          title: input.title;
          body: input.body;
          level: input.level;
          owner: input.owner;
          code: input.code;
        }
        persist row else StaleNote;
        return row;
      }
    }
    capability DeleteNote {
      input NoteIdInput;
      output Unit;
      fails NoteNotFound;
      requires atomic;
      expose command delete at "/notes/{id}";
      workflow {
        load Note by input.id as row else NoteNotFound;
        delete row;
        return unit;
      }
    }
    view ItemView from Item {
      field id: Token;
      field title: Name;
      field removed: Flag;
    }
    input CreateItemInput {
      field title: Name;
    }
    input ItemIdInput {
      field id: Token;
    }
    input ListItemInput {
      field page: PageNo;
      field size: PageSize;
    }
    input UpdateItemInput {
      field id: Token;
      field title: Name;
      field removed: Flag;
    }
    error ItemNotFound http 404;
    error InvalidItemPage;
    capability CreateItem {
      input CreateItemInput;
      output ItemView;
      requires atomic;
      expose command at "/items";
      workflow {
        create Item as row {
          title: input.title;
        }
        persist row;
        return row;
      }
    }
    capability GetItem {
      input ItemIdInput;
      output ItemView;
      fails ItemNotFound;
      requires readonly;
      expose query at "/items/{id}";
      workflow {
        load Item by input.id as row else ItemNotFound;
        return row;
      }
    }
    capability ListItem {
      input ListItemInput;
      output Page<ItemView>;
      fails InvalidItemPage;
      requires readonly;
      expose query at "/items";
      workflow {
        find Item where true order by id ascending Page input.page, input.size else InvalidItemPage as rows;
        return rows;
      }
    }
    capability UpdateItem {
      input UpdateItemInput;
      output ItemView;
      fails ItemNotFound;
      requires atomic;
      expose command put at "/items/{id}";
      workflow {
        load Item by input.id as row else ItemNotFound;
        update row {
          title: input.title;
          removed: input.removed;
        }
        persist row;
        return row;
      }
    }
    capability DeleteItem {
      input ItemIdInput;
      output Unit;
      fails ItemNotFound;
      requires atomic;
      expose command delete at "/items/{id}";
      workflow {
        load Item by input.id as row else ItemNotFound;
        delete row;
        return unit;
      }
    }
    view UserView from User {
      field id: Id;
      field nick: Optional<Name>;
      field loginName: Name;
    }
    input CreateUserInput {
      field nick: Optional<Name>;
      field loginName: Name;
      field password: Secret;
    }
    input UserIdInput {
      field id: Id;
    }
    input ListUserInput {
      field page: PageNo;
      field size: PageSize;
    }
    input UpdateUserInput {
      field id: Id;
      field nick: Optional<Name>;
      field loginName: Name;
    }
    error UserNotFound http 404;
    error InvalidUserPage;
    capability CreateUser {
      input CreateUserInput;
      output UserView;
      requires atomic;
      expose command;
      workflow {
        create User as row {
          nick: input.nick;
          loginName: input.loginName;
          password: input.password;
        }
        persist row;
        return row;
      }
    }
    capability GetUser {
      input UserIdInput;
      output UserView;
      fails UserNotFound;
      requires readonly;
      expose query;
      workflow {
        load User by input.id as row else UserNotFound;
        return row;
      }
    }
    capability ListUser {
      input ListUserInput;
      output Page<UserView>;
      fails InvalidUserPage;
      requires readonly;
      expose query;
      workflow {
        find User where true order by id ascending Page input.page, input.size else InvalidUserPage as rows;
        return rows;
      }
    }
    capability UpdateUser {
      input UpdateUserInput;
      output UserView;
      fails UserNotFound;
      requires atomic;
      expose command;
      workflow {
        load User by input.id as row else UserNotFound;
        update row {
          nick: input.nick;
          loginName: input.loginName;
        }
        persist row;
        return row;
      }
    }
    capability DeleteUser {
      input UserIdInput;
      output Unit;
      fails UserNotFound;
      requires atomic;
      expose command;
      workflow {
        load User by input.id as row else UserNotFound;
        delete row;
        return unit;
      }
    }
    view PostView from Post {
      field id: Id;
      field author: Ref<User>;
      field text: Text;
    }
    input CreatePostInput {
      field text: Text;
    }
    input PostIdInput {
      field id: Id;
    }
    input ListPostInput {
      field page: PageNo;
      field size: PageSize;
    }
    input UpdatePostInput {
      field id: Id;
      field text: Text;
    }
    error PostNotFound http 404;
    error InvalidPostPage;
    capability CreatePost {
      actor Ref<User>;
      input CreatePostInput;
      output PostView;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        create Post as row {
          text: input.text;
          author: actor;
        }
        persist row;
        return row;
      }
    }
    capability GetPost {
      actor Ref<User>;
      input PostIdInput;
      output PostView;
      fails PostNotFound;
      requires authenticated;
      requires readonly;
      expose query;
      workflow {
        load Post by input.id as row else PostNotFound;
        validate row.author == actor else PostNotFound;
        return row;
      }
    }
    capability ListPost {
      actor Ref<User>;
      input ListPostInput;
      output Page<PostView>;
      fails InvalidPostPage;
      requires authenticated;
      requires readonly;
      expose query;
      workflow {
        find Post where item.author == actor order by id ascending Page input.page, input.size else InvalidPostPage as rows;
        return rows;
      }
    }
    capability UpdatePost {
      actor Ref<User>;
      input UpdatePostInput;
      output PostView;
      fails PostNotFound;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        load Post by input.id as row else PostNotFound;
        validate row.author == actor else PostNotFound;
        update row {
          text: input.text;
        }
        persist row;
        return row;
      }
    }
    capability DeletePost {
      actor Ref<User>;
      input PostIdInput;
      output Unit;
      fails PostNotFound;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        load Post by input.id as row else PostNotFound;
        validate row.author == actor else PostNotFound;
        delete row;
        return unit;
      }
    }
    use DualTokenLogin { account: User; }
  }
}
