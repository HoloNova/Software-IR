sir 0.2

software SemanticFailure {
  metadata {
    displayName "Semantic Failure";
    namespace "example.semanticfailure";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Int64 generated auto;
      field name: String;
    }
    capability BrokenLookup {
      output String;
      requires readonly;
      expose query;
      workflow {
        return missingName;
      }
    }
  }
}
