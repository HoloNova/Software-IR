    entity ${p}AccessToken persistent {
      identity id: Uuid generated uuid;
      field owner: Ref<${account}>;
      field expiresAt: DateTime;
      credential subject owner expires expiresAt;
    }
    entity ${p}RefreshToken persistent {
      identity id: Uuid generated uuid;
      field owner: Ref<${account}>;
      field used: Boolean;
      field expiresAt: DateTime;
    }
    entity ${p}TokenPair persistent {
      identity id: Int64 generated auto;
      field accessToken: Uuid;
      field accessExpiresAt: DateTime;
      field refreshToken: Uuid;
      field refreshExpiresAt: DateTime;
    }
    view ${p}TokenPairView from ${p}TokenPair {
      field accessToken: Uuid;
      field accessExpiresAt: DateTime;
      field refreshToken: Uuid;
      field refreshExpiresAt: DateTime;
    }
    view ${p}LoggedOutView from ${p}RefreshToken {
      field id: Uuid;
      field used: Boolean;
    }
    input ${p}LoginInput {
      field name: String;
      field password: String;
    }
    input ${p}RefreshInput {
      field refreshToken: Uuid;
    }
    error ${p}BadLogin http 401;
    error ${p}ExpiredRefreshToken http 401;
    error ${p}InvalidRefreshToken http 401;
    capability ${p}Login {
      input ${p}LoginInput;
      output ${p}TokenPairView;
      fails ${p}BadLogin;
      requires atomic;
      expose command;
      workflow {
        load ${account} by ${nameField}: input.name as holder else ${p}BadLogin;
        validate holder.${passwordField} matches input.password else ${p}BadLogin;
        create ${p}AccessToken as access {
          owner: holder;
          expiresAt: now() + ${accessMinutes} minutes;
        }
        create ${p}RefreshToken as refresh {
          owner: holder;
          used: false;
          expiresAt: now() + ${refreshDays} days;
        }
        persist access;
        persist refresh;
        create ${p}TokenPair as pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: refresh.id;
          refreshExpiresAt: refresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }
    capability ${p}Refresh {
      input ${p}RefreshInput;
      output ${p}TokenPairView;
      fails ${p}ExpiredRefreshToken;
      fails ${p}InvalidRefreshToken;
      requires atomic;
      expose command;
      workflow {
        load ${p}RefreshToken by input.refreshToken as old else ${p}InvalidRefreshToken;
        validate old.expiresAt > now() else ${p}ExpiredRefreshToken;
        update old when old.used == false and old.expiresAt > now() else ${p}InvalidRefreshToken { used: true; }
        create ${p}AccessToken as access {
          owner: old.owner;
          expiresAt: now() + ${accessMinutes} minutes;
        }
        create ${p}RefreshToken as refresh {
          owner: old.owner;
          used: false;
          expiresAt: now() + ${refreshDays} days;
        }
        persist old;
        persist access;
        persist refresh;
        create ${p}TokenPair as pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: refresh.id;
          refreshExpiresAt: refresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }
    capability ${p}Logout {
      input ${p}RefreshInput;
      output ${p}LoggedOutView;
      fails ${p}InvalidRefreshToken;
      requires atomic;
      expose command;
      workflow {
        load ${p}RefreshToken by input.refreshToken as token else ${p}InvalidRefreshToken;
        update token {
          used: true;
        }
        persist token;
        return token;
      }
    }
