sir 0.3

software ActorMemberSample {
  metadata {
    displayName "Actor Member Sample";
    namespace "example.actormember";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Id generated auto;
      field name: Text;
    }
    capability CurrentActorName {
      actor Ref<User>;
      output Text;
      requires authenticated;
      requires readonly;
      expose query;
      workflow {
        return actor.name;
      }
    }
  }
}
