sir 0.3

software CredentialDesk {
  metadata {
    displayName "Credential Desk";
    namespace "example.credentials";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity Credential persistent {
      identity id: Token generated uuid;
      field owner: Text;
      field used: Flag;
      field expiresAt: Moment;
    }
    view CredentialView from Credential {
      field id: Token;
      field owner: Text;
      field expiresAt: Moment;
    }
    input RefreshInput {
      field token: Token;
    }
    error Expired;
    error Invalid http 409;
    capability Refresh {
      input RefreshInput;
      output CredentialView;
      fails Expired;
      fails Invalid;
      requires atomic;
      expose command;
      workflow {
        load Credential by input.token as old else Invalid;
        validate old.expiresAt > now() else Expired;
        update old when old.used == false and old.expiresAt > now() else Invalid { used: true; }
        create Credential as fresh {
          owner: old.owner;
          used: false;
          expiresAt: now() + 7 days;
        }
        persist old;
        persist fresh;
        return fresh;
      }
    }
  }
}
