sir 0.3

software AccountDesk {
  metadata {
    displayName "Account Desk";
    namespace "example.accounts";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity Account persistent {
      identity id: Id generated auto;
      field name: Name where length(1, 64) unique;
      field passwordHash: Secret;
    }
    view AccountView from Account {
      field id: Id;
      field name: Text;
    }
    input RegisterInput {
      field name: Text;
      field password: Text;
    }
    input LoginInput {
      field name: Text;
      field password: Text;
    }
    error BadLogin http 401;
    capability Register {
      input RegisterInput;
      output AccountView;
      requires atomic;
      expose command;
      workflow {
        create Account as account {
          name: input.name;
          passwordHash: input.password;
        }
        persist account;
        return account;
      }
    }
    capability Login {
      input LoginInput;
      output AccountView;
      fails BadLogin;
      requires readonly;
      expose command;
      workflow {
        load Account by name: input.name as account else BadLogin;
        validate account.passwordHash matches input.password else BadLogin;
        return account;
      }
    }
  }
}
