sir 0.2

software InputRefTest {
  metadata {
    displayName "Input Ref Test";
    namespace "example.inputreftest";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity Account persistent {
      identity id: Int64 generated auto;
      field name: String;
    }
    input LinkInput {
      field account: Ref<Account>;
    }
    error NotFound;
    capability Link {
      input LinkInput;
      output Unit;
      fails NotFound;
      requires readonly;
      expose query;
      workflow {
        return unit;
      }
    }
  }
}
