sir 0.3

software AccountLookup {
  metadata {
    displayName "Account Lookup";
    namespace "example.lookup";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity Account persistent {
      identity id: Id generated auto;
      field name: Name where length(1, 64) unique;
      field email: Text where notBlank unique;
      field badge: Serial unique;
      field token: Token unique;
      field nickname: Text;
    }
    view AccountView from Account {
      field id: Id;
      field name: Text;
      field nickname: Text;
    }
    input GetAccountInput { field id: Id; }
    input FindByNameInput { field name: Text; }
    input FindByBadgeInput { field badge: Serial; }
    input RenameInput { field name: Text; field nickname: Text; }
    error AccountNotFound http 404;
    capability FindAccountByBadge {
      input FindByBadgeInput;
      output AccountView;
      fails AccountNotFound;
      requires readonly;
      expose query;
      workflow {
        load Account by badge: input.badge as account else AccountNotFound;
        return account;
      }
    }
    capability FindAccountByName {
      input FindByNameInput;
      output AccountView;
      fails AccountNotFound;
      requires readonly;
      expose query;
      workflow {
        load Account by name: input.name as account else AccountNotFound;
        return account;
      }
    }
    capability GetAccount {
      input GetAccountInput;
      output AccountView;
      fails AccountNotFound;
      requires readonly;
      expose query;
      workflow {
        load Account by input.id as account else AccountNotFound;
        return account;
      }
    }
    capability RenameAccount {
      input RenameInput;
      output AccountView;
      fails AccountNotFound;
      requires atomic;
      expose command;
      workflow {
        load Account by name: input.name as account else AccountNotFound;
        update account { nickname: input.nickname; }
        persist account;
        return account;
      }
    }
  }
}
