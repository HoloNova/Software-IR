sir 0.1

software PersistProvenance {
  metadata {
    displayName "Persist Provenance";
    namespace "example.persistprovenance";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  declarations {
    entity User persistent {
      identity id: Int64 generated auto;
      field name: String;
    }
    input CreateInput {
      field id: Int64;
      field name: String;
    }
    error NotFound;
    capability CreateAndPersist {
      input CreateInput;
      output Ref<User>;
      fails NotFound;
      requires atomic;
      expose command;
      workflow {
        create User as user { name: input.name; }
        persist user;
        return user;
      }
    }
    capability LoadUpdatePersist {
      input CreateInput;
      output Ref<User>;
      fails NotFound;
      requires atomic;
      expose command;
      workflow {
        load User by input.id as user else NotFound;
        update user {
          name: input.name;
        }
        persist user;
        return user;
      }
    }
    capability CreateUpdatePersist {
      input CreateInput;
      output Ref<User>;
      fails NotFound;
      requires atomic;
      expose command;
      workflow {
        create User as user { name: input.name; }
        persist user;
        update user {
          name: input.name;
        }
        persist user;
        return user;
      }
    }
  }
}
