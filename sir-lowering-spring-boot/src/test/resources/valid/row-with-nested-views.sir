sir 0.3

software Bookshelf {
  metadata {
    displayName "Bookshelf";
    namespace "example.shelf";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity Author persistent {
      identity id: Id generated auto;
      field name: Name;
    }
    entity Book persistent {
      identity id: Id generated auto;
      field author: Ref<Author>;
      field title: Name;
    }
    entity Review persistent {
      identity id: Id generated auto;
      field book: Ref<Book>;
      field text: Remark;
    }
    view AuthorSummary from Author {
      field id: Id;
      field name: Name;
    }
    view ReviewView from Review {
      field id: Id;
      field text: Remark;
    }
    view BookDetail from Book {
      field id: Id;
      field title: Name;
      field author: AuthorSummary;
      field reviews: List<ReviewView>;
    }
    view BookCard from Book {
      field id: Id;
      field title: Name;
    }
    input BookRef {
      field id: Id;
    }
    input NewBook {
      field authorId: Id;
      field title: Name;
    }
    error AuthorNotFound http 404;
    error BookNotFound http 404;
    capability GetBook {
      input BookRef;
      output BookDetail;
      fails BookNotFound;
      requires readonly;
      expose query at "/books/{id}";
      workflow {
        load Book by input.id as book else BookNotFound;
        return book;
      }
    }
    capability AddBook {
      input NewBook;
      output BookDetail;
      fails AuthorNotFound;
      requires atomic;
      expose command at "/books";
      workflow {
        load Author by input.authorId as author else AuthorNotFound;
        create Book as made {
          author: author;
          title: input.title;
        }
        persist made;
        return made;
      }
    }
    capability GetBookCard {
      input BookRef;
      output BookCard;
      fails BookNotFound;
      requires readonly;
      expose query at "/cards/{id}";
      workflow {
        load Book by input.id as book else BookNotFound;
        return book;
      }
    }
  }
}
