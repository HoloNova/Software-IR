sir 0.3

software EntityDtoContract {
  metadata {
    displayName "Entity DTO Contract";
    namespace "com.example.entitydto";
  }

  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }

  sources { }
  imports { }
  declarations {
    enum AccountState {
      ACTIVE,
      LOCKED
    }

    entity Account persistent {
      identity accountId: Token generated uuid;
      field fullName: Name where length(1, 80);
      field email: Email;
      field active: Flag;
      field retryCount: Count;
      field legacyNumber: Serial;
      field creditLimit: Money where min(-10.50), max(999.99);
      field externalKey: Token;
      field openedOn: Day;
      field updatedAt: Moment;
      field nickname: Optional<Text>;
      field aliases: List<Text>;
      field state: AccountState;
    }

    entity Purchase persistent {
      identity id: Id generated auto;
      field account: Ref<Account>;
      field amount: Money;
    }

    input RegisterAccountInput {
      field fullName: Name where length(1, 80);
      field email: Email;
      field active: Flag;
      field retryCount: Count;
      field legacyNumber: Serial;
      field creditLimit: Money where min(-10.50), max(999.99);
      field externalKey: Token;
      field openedOn: Day;
      field updatedAt: Moment;
      field nickname: Optional<Text>;
      field tags: List<Text>;
      field state: AccountState;
    }
  }
}
