sir 0.1

software EntityDtoContract {
  metadata {
    displayName "Entity DTO Contract";
    namespace "com.example.entitydto";
  }

  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }

  declarations {
    enum AccountState {
      ACTIVE,
      LOCKED
    }

    entity Account persistent {
      identity accountId: Uuid generated uuid;
      field fullName: String where notBlank, length(1, 80);
      field email: String where email;
      field active: Boolean;
      field retryCount: Int32;
      field legacyNumber: Int64;
      field creditLimit: Decimal where min(-10.50), max(999.99);
      field externalKey: Uuid;
      field openedOn: Date;
      field updatedAt: DateTime;
      field nickname: Optional<String>;
      field aliases: List<String>;
      field state: AccountState;
    }

    entity Purchase persistent {
      identity id: Int64 generated auto;
      field account: Ref<Account>;
      field amount: Decimal;
    }

    input RegisterAccountInput {
      field fullName: String where notBlank, length(1, 80);
      field email: String where email;
      field active: Boolean;
      field retryCount: Int32;
      field legacyNumber: Int64;
      field creditLimit: Decimal where min(-10.50), max(999.99);
      field externalKey: Uuid;
      field openedOn: Date;
      field updatedAt: DateTime;
      field nickname: Optional<String>;
      field tags: List<String>;
      field state: AccountState;
    }
  }
}
