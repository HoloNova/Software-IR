sir 0.1

software ServiceWorkflowContract {
  metadata {
    displayName "Service Workflow Contract";
    namespace "example.serviceworkflow";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  declarations {
    enum State { ACTIVE, INACTIVE }
    entity User persistent {
      identity id: Uuid generated uuid;
      field state: State;
    }
    input LookupInput {
      field id: Uuid;
      field active: Boolean;
      field nickname: Optional<String>;
    }
    error NotFound;
    capability ExerciseSteps {
      input LookupInput;
      output List<Ref<User>>;
      fails NotFound;
      requires atomic;
      expose command;
      workflow {
        load User by input.id as user else NotFound;
        update user {
          state: State.ACTIVE;
        }
        persist user;
        find User where item.state == State.ACTIVE as users;
        return users;
      }
    }
    capability ReadNickname {
      input LookupInput;
      output Optional<String>;
      requires readonly;
      expose query;
      workflow {
        return input.nickname;
      }
    }
    capability EchoActive {
      input LookupInput;
      output Boolean;
      requires readonly;
      expose query;
      workflow {
        return input.active;
      }
    }
  }
}
