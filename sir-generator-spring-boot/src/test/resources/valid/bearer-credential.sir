sir 0.2

software NoteDesk {
  metadata {
    displayName "Note Desk";
    namespace "example.notes";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity User persistent {
      identity id: Int64 generated auto;
      field name: String unique;
      field passwordHash: String secret;
    }
    entity AccessToken persistent {
      identity id: Uuid generated uuid;
      field owner: Ref<User>;
      field expiresAt: DateTime;
      credential subject owner expires expiresAt;
    }
    entity Note persistent {
      identity id: Int64 generated auto;
      field author: Ref<User>;
      field text: String;
    }
    view UserView from User {
      field id: Int64;
      field name: String;
    }
    view AccessView from AccessToken {
      field id: Uuid;
      field expiresAt: DateTime;
    }
    view NoteView from Note {
      field id: Int64;
      field text: String;
    }
    input LoginInput {
      field name: String;
      field password: String;
    }
    input UserRef {
      field id: Int64;
    }
    input TokenInput {
      field token: Uuid;
    }
    input NoteInput {
      field text: String where notBlank;
    }
    error BadLogin http 401;
    error BadToken http 401;
    error UserNotFound http 404;
    capability GetUser {
      input UserRef;
      output UserView;
      fails UserNotFound;
      requires readonly;
      expose query;
      workflow {
        load User by input.id as user else UserNotFound;
        return user;
      }
    }
    capability Register {
      input LoginInput;
      output UserView;
      requires atomic;
      expose command;
      workflow {
        create User as user {
          name: input.name;
          passwordHash: input.password;
        }
        persist user;
        return user;
      }
    }
    capability Login {
      input LoginInput;
      output AccessView;
      fails BadLogin;
      requires atomic;
      expose command;
      workflow {
        load User by name: input.name as user else BadLogin;
        validate user.passwordHash matches input.password else BadLogin;
        create AccessToken as token {
          owner: user;
          expiresAt: now() + 15 minutes;
        }
        persist token;
        return token;
      }
    }
    capability Logout {
      input TokenInput;
      output AccessView;
      fails BadToken;
      requires atomic;
      expose command;
      workflow {
        load AccessToken by input.token as token else BadToken;
        update token {
          expiresAt: now();
        }
        persist token;
        return token;
      }
    }
    capability PostNote {
      actor Ref<User>;
      input NoteInput;
      output NoteView;
      requires authenticated;
      requires atomic;
      expose command;
      workflow {
        create Note as note {
          author: actor;
          text: input.text;
        }
        persist note;
        return note;
      }
    }
  }
}
