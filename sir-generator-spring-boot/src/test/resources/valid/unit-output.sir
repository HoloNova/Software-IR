sir 0.1

software UnitOutputSample {
  metadata {
    displayName "Unit Output Sample";
    namespace "example.unitoutput";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  declarations {
    capability Ping {
      output Unit;
      expose command;
      workflow {
        return unit;
      }
    }
  }
}
