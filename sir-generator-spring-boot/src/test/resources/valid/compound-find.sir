sir 0.1

software CompoundFindSample {
  metadata {
    displayName "Compound Find Sample";
    namespace "example.compoundfind";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  declarations {
    enum State { ACTIVE, INACTIVE }
    entity User persistent {
      identity id: Int64 generated auto;
      field state: State;
      field enabled: Boolean;
    }
    input FilterInput {
      field enabled: Boolean;
    }
    capability FilterUsers {
      input FilterInput;
      output List<Ref<User>>;
      requires readonly;
      expose query;
      workflow {
        find User where
          ((item.state == State.ACTIVE or item.state == State.INACTIVE) and item.enabled == input.enabled)
          and not (item.state == State.ACTIVE or item.enabled == false)
          as users;
        return users;
      }
    }
  }
}
