    entity ${prefix}AccessToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<${account}>;
      field expiresAt: Moment;
      credential subject owner expires expiresAt;
    }
    entity ${prefix}RefreshToken persistent {
      identity id: Token generated uuid;
      field owner: Ref<${account}>;
      field used: Flag;
      field expiresAt: Moment;
    }
    entity ${prefix}TokenPair persistent {
      identity id: Id generated auto;
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }
    view ${prefix}TokenPairView from ${prefix}TokenPair {
      field accessToken: Token;
      field accessExpiresAt: Moment;
      field refreshToken: Token;
      field refreshExpiresAt: Moment;
    }
    view ${prefix}LoggedOutView from ${prefix}RefreshToken {
      field id: Token;
      field used: Flag;
    }
    input ${prefix}LoginInput {
      field name: Text;
      field password: Text;
    }
    input ${prefix}RefreshInput {
      field refreshToken: Token;
    }
    error ${prefix}BadLogin http 401;
    error ${prefix}ExpiredRefreshToken http 401;
    error ${prefix}InvalidRefreshToken http 401;
    capability ${prefix}Login {
      input ${prefix}LoginInput;
      output ${prefix}TokenPairView;
      fails ${prefix}BadLogin;
      requires atomic;
      expose command;
      workflow {
        load ${account} by ${name}: input.name as holder else ${prefix}BadLogin;
        validate holder.${password} matches input.password else ${prefix}BadLogin;
        create ${prefix}AccessToken as access {
          owner: holder;
          expiresAt: now() + ${access};
        }
        create ${prefix}RefreshToken as refresh {
          owner: holder;
          used: false;
          expiresAt: now() + ${refresh};
        }
        persist access;
        persist refresh;
        create ${prefix}TokenPair as pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: refresh.id;
          refreshExpiresAt: refresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }
    capability ${prefix}Refresh {
      input ${prefix}RefreshInput;
      output ${prefix}TokenPairView;
      fails ${prefix}ExpiredRefreshToken;
      fails ${prefix}InvalidRefreshToken;
      requires atomic;
      expose command;
      workflow {
        load ${prefix}RefreshToken by input.refreshToken as old else ${prefix}InvalidRefreshToken;
        validate old.expiresAt > now() else ${prefix}ExpiredRefreshToken;
        update old when old.used == false and old.expiresAt > now() else ${prefix}InvalidRefreshToken { used: true; }
        create ${prefix}AccessToken as access {
          owner: old.owner;
          expiresAt: now() + ${access};
        }
        create ${prefix}RefreshToken as refresh {
          owner: old.owner;
          used: false;
          expiresAt: now() + ${refresh};
        }
        persist old;
        persist access;
        persist refresh;
        create ${prefix}TokenPair as pair {
          accessToken: access.id;
          accessExpiresAt: access.expiresAt;
          refreshToken: refresh.id;
          refreshExpiresAt: refresh.expiresAt;
        }
        persist pair;
        return pair;
      }
    }
    capability ${prefix}Logout {
      input ${prefix}RefreshInput;
      output ${prefix}LoggedOutView;
      fails ${prefix}InvalidRefreshToken;
      requires atomic;
      expose command;
      workflow {
        load ${prefix}RefreshToken by input.refreshToken as token else ${prefix}InvalidRefreshToken;
        update token {
          used: true;
        }
        persist token;
        return token;
      }
    }
