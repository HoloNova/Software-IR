    view ${entity}View from ${entity} {
      field ${entity.identity.name}: ${entity.identity.type};
${for f in entity.fields except secret}
      field ${f.name}: ${f.type};
${end}
    }
    input Create${entity}Input {
${for f in entity.fields except defaulted, versioned, owner}
      field ${f.name}: ${f.type}${f.rules};
${end}
    }
    input ${entity}IdInput {
      field ${entity.identity.name}: ${entity.identity.type};
    }
    input List${entity}Input {
      field page: PageNo;
      field size: PageSize;
    }
${if entity.versioned}
    input Update${entity}Input patch of ${entity} {
      field ${entity.identity.name}: ${entity.identity.type};
${for f in entity.fields except secret, versioned, owner}
      field ${f.name}: ${f.base};
${end}
    }
    error Stale${entity} http 409;
${else}
    input Update${entity}Input {
      field ${entity.identity.name}: ${entity.identity.type};
${for f in entity.fields except secret, versioned, owner}
      field ${f.name}: ${f.type}${f.rules};
${end}
    }
${end}
    error ${entity}NotFound http 404;
    error Invalid${entity}Page;
    capability Create${entity} {
${for f in entity.fields only owner}
      actor ${f.type};
${end}
      input Create${entity}Input;
      output ${entity}View;
${if owner}
      requires authenticated;
${end}
      requires atomic;
      expose command;
      workflow {
        create ${entity} as row {
${for f in entity.fields except defaulted, versioned, owner}
          ${f.name}: input.${f.name};
${end}
${if owner}
          ${owner}: actor;
${end}
        }
        persist row;
        return row;
      }
    }
    capability Get${entity} {
${for f in entity.fields only owner}
      actor ${f.type};
${end}
      input ${entity}IdInput;
      output ${entity}View;
      fails ${entity}NotFound;
${if owner}
      requires authenticated;
${end}
      requires readonly;
      expose query;
      workflow {
        load ${entity} by input.${entity.identity.name} as row else ${entity}NotFound;
${if owner}
        validate row.${owner} == actor else ${entity}NotFound;
${end}
        return row;
      }
    }
    capability List${entity} {
${for f in entity.fields only owner}
      actor ${f.type};
${end}
      input List${entity}Input;
      output Page<${entity}View>;
      fails Invalid${entity}Page;
${if owner}
      requires authenticated;
${end}
      requires readonly;
      expose query;
      workflow {
${if owner}
        find ${entity} where item.${owner} == actor order by ${entity.identity.name} ascending Page input.page, input.size else Invalid${entity}Page as rows;
${else}
        find ${entity} where true order by ${entity.identity.name} ascending Page input.page, input.size else Invalid${entity}Page as rows;
${end}
        return rows;
      }
    }
    capability Update${entity} {
${for f in entity.fields only owner}
      actor ${f.type};
${end}
      input Update${entity}Input;
      output ${entity}View;
      fails ${entity}NotFound;
${if entity.versioned}
      fails Stale${entity};
${end}
${if owner}
      requires authenticated;
${end}
      requires atomic;
      expose command;
      workflow {
        load ${entity} by input.${entity.identity.name} as row else ${entity}NotFound;
${if owner}
        validate row.${owner} == actor else ${entity}NotFound;
${end}
        update row {
${for f in entity.fields except secret, versioned, owner}
          ${f.name}: input.${f.name};
${end}
        }
${if entity.versioned}
        persist row else Stale${entity};
${else}
        persist row;
${end}
        return row;
      }
    }
    capability Delete${entity} {
${for f in entity.fields only owner}
      actor ${f.type};
${end}
      input ${entity}IdInput;
      output Unit;
      fails ${entity}NotFound;
${if owner}
      requires authenticated;
${end}
      requires atomic;
      expose command;
      workflow {
        load ${entity} by input.${entity.identity.name} as row else ${entity}NotFound;
${if owner}
        validate row.${owner} == actor else ${entity}NotFound;
${end}
        delete row;
        return unit;
      }
    }
