sir 0.3
software ZonePreferences {
  metadata { displayName "Zone preferences"; namespace "example.zone"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus; database mysql; build maven; interface rest; }
  sources {} imports {}
  declarations {
    type ZoneName = Text where timeZone, length(1, 64);
    entity Account persistent {
      identity id: Id generated auto;
      field zone: Optional<ZoneName>;
    }
    input ZoneInput { field zone: ZoneName where notBlank; }
    input OptionalZoneInput { field zone: Optional<ZoneName>; }
    error AccountNotFound http 404;
    capability Echo {
      input ZoneInput; output Text; requires readonly; expose query;
      workflow { return input.zone; }
    }
    capability EchoOptional {
      input OptionalZoneInput; output Optional<Text>; requires readonly; expose query;
      workflow { return input.zone; }
    }
    capability SetZone {
      actor Ref<Account>; input ZoneInput; output Unit;
      fails AccountNotFound; requires authenticated; requires atomic; expose command;
      workflow {
        load Account by actor as account else AccountNotFound;
        update account { zone: input.zone; }
        persist account;
        return unit;
      }
    }
  }
}
