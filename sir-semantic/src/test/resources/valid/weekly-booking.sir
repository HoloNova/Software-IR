sir 0.3
software WeeklyDesk {
  metadata {
    displayName "Weekly Desk";
    namespace "example.weekly";
  }
  target {
    language java 21;
    framework spring_boot;
    persistence mybatis_plus;
    database mysql;
    build maven;
    interface rest;
  }
  sources { }
  imports { }
  declarations {
    entity Room persistent {
      identity id: Id generated auto;
      field booked: Count default 0;
    }
    entity Booking persistent {
      identity id: Id generated auto;
      field room: Ref<Room>;
      field startsAt: Moment;
      field endsAt: Moment;
    }
    input WeeklyBooking {
      field roomId: Id;
      field startsAt: Moment;
      field endsAt: Moment;
      field weeks: Quantity;
    }
    view RoomView from Room {
      field id: Id;
      field booked: Count;
    }
    error InvalidInterval http 400;
    error RoomMissing http 404;
    error SlotTaken http 409;
    error TooManyWeeks http 409;
    capability BookWeekly {
      input WeeklyBooking;
      output RoomView;
      fails InvalidInterval;
      fails RoomMissing;
      fails SlotTaken;
      fails TooManyWeeks;
      requires atomic;
      expose command at "/bookings/weekly";
      workflow {
        validate input.startsAt < input.endsAt else InvalidInterval;
        load Room by input.roomId as room for update else RoomMissing;
        repeat input.weeks times limit 12 else TooManyWeeks as week {
          exists Booking where item.room == room and item.startsAt < addDays(input.endsAt, week * 7) and item.endsAt > addDays(input.startsAt, week * 7) as taken;
          validate not taken else SlotTaken;
          create Booking as made {
            room: room;
            startsAt: addDays(input.startsAt, week * 7);
            endsAt: addDays(input.endsAt, week * 7);
          }
          persist made;
          update room {
            booked: room.booked + 1;
          }
          persist room;
        }
        return room;
      }
    }
  }
}
