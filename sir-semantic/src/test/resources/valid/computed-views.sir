sir 0.3
software ComputedViews {
  metadata { displayName "Computed Views"; namespace "example.computed"; }
  target { language java 21; framework spring_boot; persistence mybatis_plus;
    database mysql; build maven; interface rest; }
  sources { } imports { }
  declarations {
    type UnitPrice = Money where precision(21, 4);
    enum State { ACTIVE, CANCELLED }
    entity Course persistent {
      identity id: Id generated auto;
      field capacity: Quantity;
      field enrolled: Count default 0;
      field price: UnitPrice default 1.2345;
      field note: Optional<Text>;
      field starts: Moment default now();
    }
    entity Lesson persistent {
      identity id: Id generated auto;
      field course: Ref<Course>;
      field count: Count;
    }
    view CourseView from Course {
      field id: Id;
      field enrolled: Count;
      field remaining: Count = item.capacity - item.enrolled;
      field full: Flag = item.enrolled >= item.capacity;
      field constantState: Flag = State.ACTIVE == State.ACTIVE;
      field total: Money = item.price * item.capacity;
      field note: Optional<Text> = item.note;
      field missing: Flag = item.note is none;
      field reminder: Moment = item.starts - 5 minutes;
    }
    view LessonView from Lesson {
      field id: Id;
      field doubled: Count = item.count * 2;
      field course: CourseView;
      field courseId: Id = item.course.id;
    }
    view LessonSummary from Lesson {
      field id: Id;
      field doubled: Count = item.count * 2;
    }
    view CourseTree from Course {
      field remaining: Count = item.capacity - item.enrolled;
      field lessons: List<LessonSummary>;
    }
    input Key { field id: Id; }
    input Paging { field page: PageNo; field size: PageSize; }
    input NewCourse { field capacity: Quantity; }
    error Missing http 404;
    error Refused http 409;
    capability GetCourse {
      input Key; output CourseView; fails Missing; requires readonly; expose query;
      workflow { load Course by input.id as course else Missing; return course; }
    }
    capability GetLesson {
      input Key; output LessonView; fails Missing; requires readonly; expose query;
      workflow { load Lesson by input.id as lesson else Missing; return lesson; }
    }
    capability GetTree {
      input Key; output CourseTree; fails Missing; requires readonly; expose query;
      workflow { load Course by input.id as course else Missing; return course; }
    }
    capability Browse {
      input Paging; output Page<CourseView>; fails Refused; requires readonly; expose query;
      workflow {
        find Course where item.enrolled >= 0 order by id ascending Page input.page, input.size else Refused as courses;
        return courses;
      }
    }
    capability BrowseTrees {
      input Paging; output Page<CourseTree>; fails Refused; requires readonly; expose query;
      workflow {
        find Course where item.enrolled >= 0 order by id ascending Page input.page, input.size else Refused as courses;
        return courses;
      }
    }
    capability CreateCourse {
      input NewCourse; output CourseView; requires atomic; expose command;
      workflow { create Course as course { capacity: input.capacity; } persist course; return course; }
    }
    capability ChangeCourse {
      input Key; output CourseView; fails Missing; requires atomic; expose command;
      workflow {
        load Course by input.id as course else Missing;
        update course { capacity: course.capacity + 1; }
        persist course;
        return course;
      }
    }
  }
}
